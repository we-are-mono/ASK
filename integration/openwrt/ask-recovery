#!/bin/sh /etc/rc.common
# Start this before the consumer enables ASK hardware offload.
START=18
STOP=89
USE_PROCD=1
# What this boot's recovery state is, for a UI or an operator to read:
# "armed", "exhausted", "unavailable" or "stopped".
STATE=${ASK_RECOVERY_STATE:-/var/run/ask-recovery.state}

start_service() {
	local status rc
	recovery_ready=0
	echo unavailable > "$STATE"
	status=$(ubus -t 5 call system watchdog '{}') || return 1
	if [ "$(printf '%s' "$status" | jsonfilter -e '@.status')" != running ]; then
		status=$(ubus -t 5 call system watchdog '{"stop":false,"timeout":30,"frequency":5}') || return 1
	fi
	[ "$(printf '%s' "$status" | jsonfilter -e '@.status')" = running ] || {
		logger -t ask-recovery 'procd has no hardware watchdog; ASK must stay disabled'
		return 1
	}
	rc=0
	ask-flowtable recovery-arm || rc=$?
	if [ "$rc" = 2 ]; then
		# Hardware offload stays off this boot. After a day up in software
		# the budget allows one more attempt from the next boot on, so a
		# passing cause does not keep it off for good.
		echo exhausted > "$STATE"
		logger -p daemon.warn -t ask-recovery 'hardware offload off: recovery budget exhausted; one more attempt after 24 h up, or run ask-flowtable recovery-clear'
		procd_open_instance retry
		procd_set_param command /bin/sh -c 'sleep 86400 && { ask-flowtable recovery-retry || logger -t ask-recovery "could not allow another attempt"; }'
		procd_set_param stderr 1
		procd_close_instance
		return 2
	fi
	[ "$rc" = 0 ] || return "$rc"
	procd_open_instance monitor
	procd_set_param command /usr/libexec/ask-recovery-monitor openwrt
	procd_set_param watchdog 1 15
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	recovery_ready=1
}

# A system shutdown of a datapath that is still healthy refunds the attempt
# this boot spent (recovery-clean): a hang or a watchdog reset never runs it,
# and a teardown that wedged on the way down fails the health check and keeps
# its attempt. A plain stop or restart refunds nothing and writes nothing.
stop_service() {
	echo stopped > "$STATE"
	[ "${action:-}" = shutdown ] || return 0
	ask-flowtable health || return 0
	ask-flowtable recovery-clean || logger -t ask-recovery 'could not refund the attempt this boot spent'
}

# rc.common otherwise discards start_service's failure when it closes the
# procd transaction. Consumers must be able to rely on this script's status.
service_started() {
	[ "${recovery_ready:-0}" = 1 ] && service_running monitor || return 1
	# procd registers the instance only once start_service has returned, so
	# this is the first point the monitor is known to be running.
	echo armed > "$STATE"
}
