<!-- Bridged multicast groups, keyed on the frame's own Ethernet pair as well as
     its (S,G): port id, destination MAC, source MAC, source, group, protocol
     (1 + 6 + 6 + 4 + 4 + 1 and 1 + 6 + 6 + 16 + 16 + 1). A bridge forwards a
     frame with the addresses it arrived with, and the listeners can only write
     back addresses the root matched. One table cannot hold two key layouts, so
     these are reached from the routed multicast tables' miss, and the routed
     groups keep their own. -->
<classification name="cdx_bridged_mcast4_cc" max="512" masks="yes" shared="true" statistics="byteframe">
  <key>
