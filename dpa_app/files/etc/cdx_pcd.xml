<!-- The IPsec offline port's own tables. Every frame this port classifies left
     SEC by some SA's FROM_SEC queue, and the only thing that queue gives FMan
     per SA is the FQID in its Context B: the SA's TO_CP queue, which the
     Context A override makes the frame's enqueue FQID. So each key is its
     Ethernet counterpart's with that FQID appended (3 bytes, last because the
     key generator places generic extractions after the known fields): a flow
     decrypted by one SA, or an SA's own encrypted frames, cannot match an entry
     made for another SA. The catch-all holds no entries and needs no FQID. -->
<classification name="cdx_sec_udp4_cc" max="512" masks="yes" shared="true" statistics="byteframe">
  <key>
     <hashtable external="yes" mask="0x7fff" hashshift="0" keysize="17" aging="yes"/>
  </key>
</classification>

