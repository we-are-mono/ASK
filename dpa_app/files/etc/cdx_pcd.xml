<!-- The IPsec offline port: its own distributions only. The key generator
     takes the first scheme, by number, whose protocols a frame has, and fmc
     numbers schemes in the order ports are applied, so every shared scheme is
     numbered before these and would take this port's frames (a multicast one
     has only ipv4). A shared distribution added here therefore unbinds the
     decrypted flows from their SAs, and no port's other policy may name
     these. -->
<policy name="cdx_port_of2_policy">
  <dist_order>
    <distributionref name="cdx_sec_esp4_dist"/>
    <distributionref name="cdx_sec_esp6_dist"/>
    <distributionref name="cdx_sec_udp4_dist"/>
    <distributionref name="cdx_sec_tcp4_dist"/>
    <distributionref name="cdx_sec_udp6_dist"/>
    <distributionref name="cdx_sec_tcp6_dist"/>
    <distributionref name="cdx_sec_ethernet_dist"/>
