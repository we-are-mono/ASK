<!-- The IPsec offline port's distributions: its Ethernet counterparts' fields,
     and the frame's enqueue FQID, which the SA's FROM_SEC queue sets from its
     Context B. The FQID is 24 bits, the first three bytes of the key
     generator's FQID area; source, offset and size are the only place the
     discriminator is chosen, with cdx_ipsec_key_tag() on the cdx side. The
     FQID is always present, so the not-from-data default each names is never
     taken; the key generator still requires one for that extraction. Their
     queue bases leave bits 8-11 free for the port id the combine ORs in. -->
<distribution name="cdx_sec_esp4_dist" shared="true">
  <protocols>
    <protocolref name="ipv4"/>
    <protocolref name="ipsec_esp"/>
  </protocols>
  <key>
    <fieldref name="ipv4.dst"/>
    <fieldref name="ipv4.nextp"/>
    <fieldref name="ipsec_esp.spi"/>
    <nonheader source="fqid" offset="0" size="3"/>
  </key>
  <defaults>
    <default type="not_from_data" select="gbl0"/>
  </defaults>
  <queue count="1" base="0x2000"/>
  <combine portid="true" offset="16" mask="0xF"/>
  <action type="classification" name="cdx_sec_esp4_cc"/>
</distribution>

