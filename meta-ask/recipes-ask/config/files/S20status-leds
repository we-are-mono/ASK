#!/bin/sh
### BEGIN INIT INFO
# Provides:          status-leds
# Required-Start:    ask-modules
# Default-Start:     S
# Short-Description: Static RGBW status LED — green off, white at low brightness
### END INIT INFO

# U-Boot leaves the green LED lit. After leds-lp5812 binds, this script
# turns green off and lights white at a low intensity so the board is
# visibly running but the LED isn't distractingly bright. The four colours
# are one multicolour device; multi_intensity follows the DTS child order
# (red green blue white).

STATUS=/sys/class/leds/status:rgbw

case "$1" in
    start|"")
        # S05ask-modules reads only /etc/modules-load.d/ask.conf, not the
        # whole directory, so the lp5812 driver's autoload file isn't seen
        # by it. Probe explicitly here.
        modprobe leds-lp5812 2>/dev/null || true
        if [ -d "$STATUS" ]; then
            echo none      > "$STATUS/trigger"
            echo 0 0 0 255 > "$STATUS/multi_intensity"
            echo 16        > "$STATUS/brightness"
        fi
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac

exit 0
