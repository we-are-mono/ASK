#!/bin/sh
### BEGIN INIT INFO
# Provides:          ask-modules
# Required-Start:    mountvirtfs
# Default-Start:     S
# Short-Description: Load ASK fast-path kernel modules
### END INIT INFO

# Read /etc/modules-load.d/ask.conf and modprobe each non-comment line in order.
# cdx brings the flowtable adapter up right behind it.

CONF=/etc/modules-load.d/ask.conf

case "$1" in
    start|"")
        [ -r "$CONF" ] || exit 0
        observe=0
        # ASK-DEBUG defaults on here and nowhere else. This is the development
        # image: the question "why was that flow not offloaded" is the one it
        # exists to answer, and a refusal is otherwise a single counter
        # standing for two dozen conditions. 1 = refusals only; accepts (2) and
        # device decisions (4) print per flow and are left to be asked for.
        # Product images take the driver default, which is off.
        askdebug=1
        for arg in $(cat /proc/cmdline); do
            case "$arg" in
                ask.flowtable_observe=*) observe=${arg#ask.flowtable_observe=} ;;
                ask.debug=*) askdebug=${arg#ask.debug=} ;;
            esac
        done
        case "$observe" in
            0|1) ;;
            *) echo "Invalid ask.flowtable_observe: $observe" >&2; exit 1 ;;
        esac
        # ASK-DEBUG prints per flow at KERN_INFO. On the serial console that
        # is a line for every refused direction of every offloaded flow, in
        # the middle of whatever a console-driven test is reading back, and
        # the harness's command markers do not survive it. Keep everything
        # in the kernel log (dmesg, and the agent's splat capture, read the
        # ring), but let the console carry warnings and worse only.
        [ -w /proc/sys/kernel/printk ] && echo "5 4 1 7" > /proc/sys/kernel/printk
        while read -r mod; do
            case "$mod" in ''|'#'*) continue ;; esac
            if [ "$mod" = cdx ]; then
                modprobe cdx flowtable_observe="$observe" ask_debug="$askdebug" || exit 1
                modprobe ask_flowtable || exit 1
            else
                modprobe "$mod" || exit 1
            fi
        done < "$CONF"
        ;;
    stop)
        # Deliberate no-op: unloading ASK modules at shutdown is risky on a
        # test board; power-cycle instead.
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac

exit 0
