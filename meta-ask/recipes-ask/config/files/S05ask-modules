#!/bin/sh
### BEGIN INIT INFO
# Provides:          ask-modules
# Required-Start:    mountvirtfs
# Default-Start:     S
# Short-Description: Load ASK fast-path kernel modules
### END INIT INFO

# Read /etc/modules-load.d/ask.conf and modprobe each non-comment line in order.
# Order matters: cdx before fci, auto_bridge after cdx.

CONF=/etc/modules-load.d/ask.conf

case "$1" in
    start|"")
        [ -r "$CONF" ] || exit 0
        # DEBUG (REVERT-ME after A22 lands): wrap /usr/bin/dpa_app so its
        # stdout/stderr survive — call_usermodehelper from cdx_main.c drops
        # both streams. Output goes to /tmp/dpa_app.{stdout,stderr}.
        if [ ! -e /usr/bin/dpa_app.real ]; then
            mv /usr/bin/dpa_app /usr/bin/dpa_app.real
            cat > /usr/bin/dpa_app <<'WRAP'
#!/bin/sh
exec /usr/bin/dpa_app.real >>/tmp/dpa_app.stdout 2>>/tmp/dpa_app.stderr
WRAP
            chmod +x /usr/bin/dpa_app
        fi
        grep -v '^[[:space:]]*#' "$CONF" | grep -v '^[[:space:]]*$' | while read mod; do
            modprobe "$mod"
        done
        ;;
    stop)
        # Deliberate no-op: unloading ASK modules at shutdown is risky on a
        # test board; power-cycle instead.
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac

exit 0
