#!/bin/sh
### BEGIN INIT INFO
# Provides:          ask-modules
# Required-Start:    mountvirtfs
# Default-Start:     S
# Short-Description: Load ASK fast-path kernel modules
### END INIT INFO

# Read /etc/modules-load.d/ask.conf and modprobe each non-comment line in order.
# Order matters: cdx before fci, auto_bridge after cdx.

CONF=/etc/modules-load.d/ask.conf

case "$1" in
    start|"")
        [ -r "$CONF" ] || exit 0
        owner=cmm
        observe=0
        for arg in $(cat /proc/cmdline); do
            case "$arg" in
                ask.offload=*) owner=${arg#ask.offload=} ;;
                ask.flowtable_observe=*) observe=${arg#ask.flowtable_observe=} ;;
            esac
        done
        case "$owner:$observe" in
            cmm:0|flowtable:0|flowtable:1) ;;
            *) echo "Invalid ASK offload boot selection: $owner:$observe" >&2; exit 1 ;;
        esac
        while read -r mod; do
            case "$mod" in ''|'#'*) continue ;; esac
            if [ "$mod" = cdx ]; then
                modprobe cdx offload_owner="$owner" flowtable_observe="$observe" || exit 1
                if [ "$owner" = flowtable ]; then
                    modprobe ask_flowtable || exit 1
                fi
            elif [ "$owner" = flowtable ] && { [ "$mod" = fci ] || [ "$mod" = auto_bridge ]; }; then
                continue
            else
                modprobe "$mod" || exit 1
            fi
        done < "$CONF"
        ;;
    stop)
        # Deliberate no-op: unloading ASK modules at shutdown is risky on a
        # test board; power-cycle instead.
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac

exit 0
