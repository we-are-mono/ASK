+/* The firmware event, cancel response and teardown may all release the
+ * asynchronous scan. Serialize that release as well as the cfg80211 owner. */
+void woal_scan_pending_start(moal_private *priv)
+{
+	moal_handle *handle = priv->phandle;
+	unsigned long flags;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	handle->scan_pending_on_block = MTRUE;
+	handle->scan_priv = priv;
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+}
+
+void woal_scan_pending_complete(moal_handle *handle)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	if (handle->scan_pending_on_block) {
+		handle->scan_pending_on_block = MFALSE;
+		handle->scan_priv = NULL;
+		MOAL_REL_SEMAPHORE(&handle->async_sem);
+	}
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+}
