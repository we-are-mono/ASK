+/* All accepted requests, including cached scans and ACS, have one owner and
+ * a generation. Never use the request address as a completion token: cfg80211
+ * may free it after scan_done() and reuse that address for the next scan. */
+int woal_cfg80211_scan_busy(moal_handle *handle)
+{
+	unsigned long flags;
+	int busy;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	busy = handle->scan_request || handle->scan_starting ||
+		handle->scan_canceling || handle->scan_stopping;
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+	return busy;
+}
+
+int woal_cfg80211_scan_begin(moal_private *priv,
+			    struct cfg80211_scan_request *request, t_u8 fake,
+			    t_u32 timeout, t_u64 *generation)
+{
+	moal_handle *handle = priv->phandle;
+	unsigned long flags;
+	int ret = -EBUSY;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	if (handle->scan_request || handle->scan_starting ||
+	    handle->scan_canceling || handle->scan_stopping)
+		goto unlock;
+	handle->scan_starting = MTRUE;
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+
+	/* Completion cancels without waiting. Drain a running old callback
+	 * before reusing the delayed work and its generation. No lock held. */
+	cancel_delayed_work_sync(&handle->scan_timeout_work);
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	handle->scan_starting = MFALSE;
+	if (handle->scan_stopping || handle->scan_canceling ||
+	    handle->driver_status || handle->surprise_removed ||
+	    (!fake && handle->scan_pending_on_block) || !handle->evt_workqueue)
+		goto unlock;
+	if (!++handle->scan_generation)
+		++handle->scan_generation;
+	handle->scan_request = request;
+	handle->cfg_scan_priv = priv;
+	handle->fake_scan_complete = fake;
+	handle->scan_timeout_generation = handle->scan_generation;
+	/* Arming under the lock prevents teardown from cancelling before this
+	 * timer has been queued. begin() has drained the previous instance. */
+	queue_delayed_work(handle->evt_workqueue, &handle->scan_timeout_work,
+			   msecs_to_jiffies(timeout));
+	*generation = handle->scan_generation;
+	ret = 0;
+unlock:
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+	return ret;
+}
+
+void woal_cfg80211_scan_complete(moal_handle *handle, t_u64 generation,
+				t_u8 aborted)
+{
+	struct cfg80211_scan_request *request;
+	unsigned long flags;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	if (!generation || !handle->scan_request ||
+	    handle->scan_generation != generation)
+		goto unlock;
+	request = handle->scan_request;
+	/* Preserve the driver's ACS compatibility with supplicants that do
+	 * not handle an aborted AP scan. The cfg owner exists for fake scans. */
+	if (handle->cfg_scan_priv->bss_type != MLAN_BSS_TYPE_STA)
+		aborted = MFALSE;
+	handle->scan_request = NULL;
+	handle->cfg_scan_priv = NULL;
+	handle->fake_scan_complete = MFALSE;
+	handle->scan_timeout_generation = 0;
+	cancel_delayed_work(&handle->scan_timeout_work);
+	/* cfg80211_scan_done only queues notification work; BSS reporting and
+	 * firmware commands, which may sleep, must stay outside this lock. */
+	woal_cfg80211_scan_done(request, aborted);
+unlock:
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+}
+
+void woal_cfg80211_scan_stop(moal_handle *handle)
+{
+	unsigned long flags;
+	t_u64 generation;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	handle->scan_stopping = MTRUE;
+	generation = handle->scan_generation;
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+	/* Unconditional: the request may have completed while work was running.
+	 * destroy_workqueue() alone does not drain a delayed-work timer. */
+	cancel_delayed_work_sync(&handle->scan_timeout_work);
+	woal_cfg80211_scan_complete(handle, generation, MTRUE);
+	/* A result worker may have dropped scan_req_lock to report BSS entries.
+	 * Keep its interface alive until it returns, including during FLR. */
+	if (handle->evt_workqueue)
+		flush_work(&handle->evt_work);
+}
+
+void woal_cfg80211_scan_restart(moal_handle *handle)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&handle->scan_req_lock, flags);
+	handle->scan_stopping = MFALSE;
+	spin_unlock_irqrestore(&handle->scan_req_lock, flags);
+}
