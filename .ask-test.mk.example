# Copy to .ask-test.mk and fill in your bench. Git ignores the local file.
# Shell environment and make command-line values override these ?= assignments.
# Optional DUT traffic address; control uses ASK_TARGET_DEV.
DUT_IP ?=
WAN_IP ?=
# Optional: separate HTTP control address for the WAN agent.
WAN_AGENT_IP ?=
ASK_TARGET_DEV ?=
# Optional: the DUT's USB serial port (USB-C data port to this host), e.g.
# /dev/serial/by-id/usb-Mono_ASK_test_agent_<eth4 MAC>-if00. Carries the
# agent instead of ASK_TARGET_DEV, which then keeps boot and recovery.
ASK_TARGET_AGENT_DEV ?=
# libvirt VM with qemu-guest-agent and guest-exec enabled.
ASK_LAN_VM ?=
ASK_LAN_NIC ?=
# WAN interface used by multicast and profile packet injection.
ASK_WAN_INJECT_IF ?=

# Board port roles, independent of the orchestrator setup.
ASK_TARGET_LAN_IF ?= eth3
ASK_TARGET_WAN_IF ?= eth4
