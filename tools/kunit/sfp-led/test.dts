/dts-v1/;

/ {
	sfp-led-kunit;
	#address-cells = <1>;
	#size-cells = <1>;

	gpio: gpio {
		gpio-controller;
		#gpio-cells = <2>;
	};

	/* A controller no chip ever registers for: its consumers defer. */
	gpio_absent: gpio-absent {
		gpio-controller;
		#gpio-cells = <2>;
	};

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		pcs: ethernet-phy@0 {
			reg = <0>;
		};
	};

	/* Active-low, as the board declares its cages. */
	sfp: sfp {
		mod-def0-gpios = <&gpio 0 1>;
	};

	sfp_nogpio: sfp-nogpio {
		mod-def0-gpios = <&gpio_absent 0 1>;
	};

	mac: mac {
		compatible = "fsl,fman-memac";
		sfp = <&sfp>;
		phy-connection-type = "xgmii";
		pcs-handle = <&pcs>;
		pcs-handle-names = "xfi";
	};

	mac2: mac2 {
		compatible = "fsl,fman-memac";
		sfp = <&sfp_nogpio>;
		phy-connection-type = "xgmii";
		pcs-handle = <&pcs>;
		pcs-handle-names = "xfi";
	};

	dpaa {
		fsl,fman-mac = <&mac>;
	};

	link: link-led {};
	activity: activity-led {};
	late: late-led {};

	controller {
		port0 {
			compatible = "mono,sfp-led-port";
			sfp = <&sfp>;
			leds = <&link>, <&activity>;
		};
		port1 {
			compatible = "mono,sfp-led-port";
			sfp = <&sfp>;
			leds = <&link>, <&late>;
		};
		port2 {
			compatible = "mono,sfp-led-port";
			sfp = <&sfp_nogpio>;
			leds = <&link>, <&activity>;
		};
	};
};
