+                    DEV_TO_ID(params.fm_pcd_cc_group_params[i].next_engine_per_entries_in_grp[j].params.fr_params.frm_replic_id);
+#endif /* DPAA_VERSION >= 11 */
         }
 
     p_Dev = (t_Device *)malloc(sizeof(t_Device));
