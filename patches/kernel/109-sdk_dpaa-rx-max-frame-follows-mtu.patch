diff --git a/drivers/net/ethernet/freescale/sdk_fman/src/wrapper/lnxwrp_fm.c b/drivers/net/ethernet/freescale/sdk_fman/src/wrapper/lnxwrp_fm.c
index a6bdd18c0f2e..c3f8cd6ba06a 100644
--- a/drivers/net/ethernet/freescale/sdk_fman/src/wrapper/lnxwrp_fm.c
+++ b/drivers/net/ethernet/freescale/sdk_fman/src/wrapper/lnxwrp_fm.c
@@ -1534,6 +1534,29 @@ int fm_mac_config_max_frame_length(struct fm_mac_dev *fm_mac_dev,
 }
 EXPORT_SYMBOL(fm_mac_config_max_frame_length);
 
+int fm_mac_set_max_frame_length(struct fm_mac_dev *fm_mac_dev, int len)
+{
+	t_Error err;
+	int _errno;
+
+	/* Ports are sized for fsl_fm_max_frm; a MAC may accept less, never
+	 * more.
+	 */
+	if (len <= 0 || len > fsl_fm_max_frm)
+		return -EINVAL;
+
+	err = FM_MAC_SetMaxFrameLength(fm_mac_dev, (uint16_t)len);
+	if (GET_ERROR_TYPE(err) == E_NOT_SUPPORTED)
+		return -EOPNOTSUPP;
+
