+                after init; another negative errno otherwise.
+*//***************************************************************************/
+int fm_mac_set_max_frame_length(struct fm_mac_dev *fm_mac_dev, int len);
+
 int fm_mac_config_pad_and_crc(struct fm_mac_dev *fm_mac_dev, bool enable);
 
