From 866f2489f26c59ee8d5775c86fa64084f15ac731 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Fri, 16 Oct 2026 21:02:35 +0200
Subject: [PATCH] sdk_dpaa: allow two tags on a port whose VLAN is a bridge
 port

A VLAN device on the port that is itself a bridge port -- br-lan over
eth0.10, the way OpenWrt bridges a VLAN without bridge-vlan sections --
carries a second tag whenever the bridge tags what it forwards there,
or forwards tagged frames through it. The receive limit allowed one,
so a full-size frame with both tags was dropped at the MAC before the
bridge, or an offload, ever saw it. Count a bridge above a VLAN on the
port as the VLAN above a VLAN already is. CHANGEUPPER on the VLAN
device already brings the limit up to date.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
index c25dcefd4c0d..e371e7755664 100644
--- a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
@@ -675,7 +675,9 @@ static int __cold dpa_eth_priv_stop(struct net_device *net_dev)
 /* The tags a full-size frame on the port may carry: none while nothing is
  * stacked on it, one once anything is -- a VLAN, a bridge forwarding tagged
  * frames through, a bond, a macvlan -- and two once a VLAN on the port is an
- * 802.1ad service VLAN or carries a VLAN of its own.
+ * 802.1ad service VLAN or carries a VLAN of its own: a VLAN device above it,
+ * or a bridge it is a port of, which tags the frames it forwards there or
+ * carries tagged ones through.
  */
 static int dpa_upper_tags(struct net_device *net_dev)
 {
@@ -691,7 +693,7 @@ static int dpa_upper_tags(struct net_device *net_dev)
 		if (vlan_dev_vlan_proto(upper) == htons(ETH_P_8021AD))
 			tags = 2;
 		netdev_for_each_upper_dev_rcu(upper, inner, inner_iter)
-			if (is_vlan_dev(inner))
+			if (is_vlan_dev(inner) || netif_is_bridge_master(inner))
 				tags = 2;
 	}
 	rcu_read_unlock();
-- 
