From fa2d96152595d0cad107d162c8d545259b16f4d1 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Sun, 9 Aug 2026 13:56:19 +0200
Subject: [PATCH] ask: IPv4/IPv6 forwarding-path hook points

Wires the IPsec offload's output bypasses into the kernel's IP output
path: net/ipv4/ip_output.c and net/ipv6/{ip6_output,output_core}.c. A
transport-mode frame for a packet-offloaded SA (skb->ipsec_offload, the
skb field from 010, set by the XFRM offload in 040) is still plaintext
and leaves by the SA's own device: it skips LOCAL_OUT, POST_ROUTING and
fragmentation on the way there, since SEC builds the ESP packet.

ip6t_NPT points a connection's reply tuple at the translated prefix, so
replies match it. It does so only while the conntrack is unconfirmed:
the reference wrote every IP_CT_NEW and IP_CT_RELATED packet's address
into a confirmed, hashed tuple in place, which an ICMP error from any
other LAN address turned into a connection no reply could find.

Backport upstream a7bfaba4823e3c165bb2004c74eff7c096672bc7 by Qishuai Liu:
convert a modified IPv6 prefix route's relative clock_t lifetime into an
absolute jiffies deadline, as the route creation path already does.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 net/ipv4/ip_output.c          | 24 +++++++++++++++++++++++-
 net/ipv6/addrconf.c           |  2 +-
 net/ipv6/ip6_output.c         | 18 ++++++++++++++++--
 net/ipv6/netfilter/ip6t_NPT.c | 35 +++++++++++++++++++++++++++++++++++
 net/ipv6/output_core.c        |  8 ++++++++
 5 files changed, 83 insertions(+), 4 deletions(-)

diff --git a/net/ipv4/ip_output.c b/net/ipv4/ip_output.c
index 41031c5c4303..cf455f665713 100644
--- a/net/ipv4/ip_output.c
+++ b/net/ipv4/ip_output.c
@@ -116,6 +116,14 @@ int __ip_local_out(struct net *net, struct sock *sk, struct sk_buff *skb)
 
 	skb->protocol = htons(ETH_P_IP);
 
+#if defined(CONFIG_INET_IPSEC_OFFLOAD)
+	if(skb->ipsec_offload)
+	{
+		dst_output(net, sk, skb);
+		return 0;
+	}
+	else
+#endif /* endif for CONFIG_INET_IPSEC_OFFLOAD */
 	return nf_hook(NFPROTO_IPV4, NF_INET_LOCAL_OUT,
 		       net, sk, skb, NULL, skb_dst_dev(skb),
 		       dst_output);
@@ -308,7 +316,11 @@ static int __ip_finish_output(struct net *net, struct sock *sk, struct sk_buff *
 	if (skb_is_gso(skb))
 		return ip_finish_output_gso(net, sk, skb, mtu);
 
-	if (skb->len > mtu || IPCB(skb)->frag_max_size)
+	if (
+#if defined(CONFIG_INET_IPSEC_OFFLOAD)
+		(skb->ipsec_offload == 0) &&
+#endif
+		(skb->len > mtu || IPCB(skb)->frag_max_size))
 		return ip_fragment(net, sk, skb, mtu, ip_finish_output2);
 
 	return ip_finish_output2(net, sk, skb);
@@ -434,6 +446,16 @@ int ip_output(struct net *net, struct sock *sk, struct sk_buff *skb)
 	skb->dev = dev;
 	skb->protocol = htons(ETH_P_IP);
 
+#if defined(CONFIG_INET_IPSEC_OFFLOAD)
+	/* Bypass invoking post routing hooks since the tunnel header and ESP
+	 * processing is not done in slow path for IPSec offloaded cases
+	 */
+	if (skb->ipsec_offload) {
+		ret_val = ip_finish_output(net, sk, skb);
+		rcu_read_unlock();
+		return ret_val;
+	}
+#endif
 	ret_val = NF_HOOK_COND(NFPROTO_IPV4, NF_INET_POST_ROUTING,
 				net, sk, skb, indev, dev,
 				ip_finish_output,
diff --git a/net/ipv6/addrconf.c b/net/ipv6/addrconf.c
--- a/net/ipv6/addrconf.c
+++ b/net/ipv6/addrconf.c
@@ -4866,7 +4866,7 @@ static int modify_prefix_route(struct net *net, struct inet6_ifaddr *ifp,
 			fib6_clean_expires(f6i);
 			fib6_may_remove_gc_list(net, f6i);
 		} else {
-			fib6_set_expires(f6i, expires);
+			fib6_set_expires(f6i, jiffies + clock_t_to_jiffies(expires));
 			fib6_add_gc_list(f6i);
 		}
 
diff --git a/net/ipv6/ip6_output.c b/net/ipv6/ip6_output.c
index 5d17982cb994..4ec7a6da32ee 100644
--- a/net/ipv6/ip6_output.c
+++ b/net/ipv6/ip6_output.c
@@ -208,8 +208,15 @@ static int __ip6_finish_output(struct net *net, struct sock *sk, struct sk_buff
 	if (skb_is_gso(skb))
 		return ip6_finish_output_gso(net, sk, skb, mtu);
 
-	if (skb->len > mtu ||
-	    (IP6CB(skb)->frag_max_size && skb->len > IP6CB(skb)->frag_max_size))
+	if (
+#if defined(CONFIG_INET6_IPSEC_OFFLOAD)
+		/* If ipsec offload is there, do not do fragment. So, when IPSec
+		 * offload is enabled it directly calls ip6_finish_output2
+		 */
+		(skb->ipsec_offload == 0) &&
+#endif
+		((skb->len > mtu) ||
+		(IP6CB(skb)->frag_max_size && skb->len > IP6CB(skb)->frag_max_size)))
 		return ip6_fragment(net, sk, skb, ip6_finish_output2);
 
 	return ip6_finish_output2(net, sk, skb);
@@ -244,6 +251,13 @@ int ip6_output(struct net *net, struct sock *sk, struct sk_buff *skb)
 		return 0;
 	}
 
+#if defined(CONFIG_INET6_IPSEC_OFFLOAD)
+	/* Bypass invoking post routing hooks since the tunnel header and ESP
+	 * processing is not done in slow path for IPSec offloaded cases
+	 */
+	if (skb->ipsec_offload)
+		return ip6_finish_output(net, sk, skb);
+#endif
 	return NF_HOOK_COND(NFPROTO_IPV6, NF_INET_POST_ROUTING,
 			    net, sk, skb, indev, dev,
 			    ip6_finish_output,
diff --git a/net/ipv6/netfilter/ip6t_NPT.c b/net/ipv6/netfilter/ip6t_NPT.c
index 787c74aa85e3..a63cd09c5440 100644
--- a/net/ipv6/netfilter/ip6t_NPT.c
+++ b/net/ipv6/netfilter/ip6t_NPT.c
@@ -11,6 +11,9 @@
 #include <linux/netfilter_ipv6.h>
 #include <linux/netfilter_ipv6/ip6t_NPT.h>
 #include <linux/netfilter/x_tables.h>
+#ifdef CONFIG_CPE_FAST_PATH
+#include <net/netfilter/nf_conntrack.h>
+#endif
 
 static int ip6t_npt_checkentry(const struct xt_tgchk_param *par)
 {
@@ -114,6 +117,25 @@ ip6t_snpt_tg(struct sk_buff *skb, const struct xt_action_param *par)
 			ip6t_npt_map_pfx(npt, &bounced_hdr->daddr);
 	}
 
+#ifdef CONFIG_CPE_FAST_PATH
+	/* The peer answers the translated prefix, so the connection's reply
+	 * tuple has to name it or no reply matches the connection. Written
+	 * only while the conntrack is unconfirmed -- this packet's own, before
+	 * confirmation hashes it on that tuple. A confirmed one is in the
+	 * table under the tuple it has: rewritten in place it would be hashed
+	 * under one address while holding another, found by neither, and a
+	 * lookup comparing tuples meanwhile could read it torn. Later packets
+	 * of a connection, which keep IP_CT_NEW until a reply is seen, and
+	 * ICMP errors related to one, leave it as confirmation left it. */
+	{
+		enum ip_conntrack_info ctinfo;
+		struct nf_conn *ct = nf_ct_get(skb, &ctinfo);
+
+		if (ct && !nf_ct_is_confirmed(ct))
+			ct->tuplehash[IP_CT_DIR_REPLY].tuple.dst.u3.in6 =
+				ipv6_hdr(skb)->saddr;
+	}
+#endif
 	return XT_CONTINUE;
 }
 
@@ -139,6 +161,19 @@ ip6t_dnpt_tg(struct sk_buff *skb, const struct xt_action_param *par)
 			ip6t_npt_map_pfx(npt, &bounced_hdr->saddr);
 	}
 
+#ifdef CONFIG_CPE_FAST_PATH
+	/* The mirror of the source rewrite above: a connection opened from
+	 * outside is answered from the address this rewrote its destination
+	 * to. Unconfirmed conntracks only, for the same reason. */
+	{
+		enum ip_conntrack_info ctinfo;
+		struct nf_conn *ct = nf_ct_get(skb, &ctinfo);
+
+		if (ct && !nf_ct_is_confirmed(ct))
+			ct->tuplehash[IP_CT_DIR_REPLY].tuple.src.u3.in6 =
+				ipv6_hdr(skb)->daddr;
+	}
+#endif
 	return XT_CONTINUE;
 }
 
diff --git a/net/ipv6/output_core.c b/net/ipv6/output_core.c
index 90a178dd24aa..c96261180a3d 100644
--- a/net/ipv6/output_core.c
+++ b/net/ipv6/output_core.c
@@ -140,6 +140,14 @@ int __ip6_local_out(struct net *net, struct sock *sk, struct sk_buff *skb)
 
 	skb->protocol = htons(ETH_P_IPV6);
 
+#if defined(CONFIG_INET6_IPSEC_OFFLOAD)
+	if(skb->ipsec_offload)
+	{
+		dst_output(net, sk, skb);
+		return 0;
+	}
+	else
+#endif
 	return nf_hook(NFPROTO_IPV6, NF_INET_LOCAL_OUT,
 		       net, sk, skb, NULL, skb_dst(skb)->dev,
 		       dst_output);
-- 
2.47.3
