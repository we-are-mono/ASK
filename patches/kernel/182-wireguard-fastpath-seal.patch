--- /dev/null
+++ b/drivers/net/wireguard/fastpath.c
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Seal a forwarded IPv4 packet for its peer in place, in the buffer a NIC
+ * received it into, so the NIC can transmit the result without an skb.
+ *
+ * The caller hands over an Ethernet frame whose header it does not need (the
+ * classifier has already routed the packet, decremented its TTL and fixed its
+ * checksum). Anything this does not handle is declined before the buffer is
+ * written, and the caller then gives the packet to the device as usual.
+ */
+
+#include "queueing.h"
+#include "peer.h"
+#include "device.h"
+#include "messages.h"
+#include "timers.h"
+#include "allowedips.h"
+#include "noise.h"
+
+#include <crypto/chacha20poly1305.h>
+#include <crypto/poly1305.h>
+#include <net/inet_ecn.h>
+#include <net/ip.h>
+#include <net/neighbour.h>
+#include <net/arp.h>
+#include <net/route.h>
+#include <net/wg_fastpath.h>
+
+#define WG_FP_HLEN (ETH_HLEN + sizeof(struct iphdr) + sizeof(struct udphdr))
+
+struct wg_fastpath_tmpl {
+	struct rcu_head rcu;
+	/* NULL: decline until expires (no IPv4 endpoint, route or neighbour). */
+	struct net_device *dev;
+	unsigned long expires;
+	atomic_t id;
+	u8 hdr[WG_FP_HLEN];
+};
+
+static void wg_fp_tmpl_free(struct rcu_head *rcu)
+{
+	struct wg_fastpath_tmpl *t = container_of(rcu, struct wg_fastpath_tmpl, rcu);
+
+	dev_put(t->dev);
+	kfree(t);
+}
+
+void wg_fastpath_peer_free(struct wg_peer *peer)
+{
+	struct wg_fastpath_tmpl *t = rcu_dereference_protected(peer->fp_tmpl, 1);
+
+	if (t) {
+		dev_put(t->dev);
+		kfree(t);
+	}
+}
+
+/* The outer Ethernet, IPv4 and UDP header send4() would put on a packet now,
+ * for a device @can_tx accepts only. Called under rcu_read_lock_bh().
+ * ponytail: rebuilt once a second, so a roamed endpoint or a moved neighbour
+ * is followed within a second; compare per packet if that is too slow. */
+static struct wg_fastpath_tmpl *wg_fp_build(struct wg_peer *peer,
+					    wg_fastpath_can_tx_t can_tx)
+{
+	struct wg_device *wg = peer->device;
+	struct wg_fastpath_tmpl *t;
+	struct net_device *dev;
+	struct neighbour *n;
+	struct endpoint ep;
+	struct flowi4 fl;
+	struct rtable *rt;
+	struct sock *sock;
+	struct ethhdr *eth;
+	struct udphdr *udp;
+	struct iphdr *ip;
+
+	t = kzalloc(sizeof(*t), GFP_ATOMIC);
+	if (!t)
+		return NULL;
+	t->expires = jiffies + HZ;
+
+	read_lock_bh(&peer->endpoint_lock);
+	ep = peer->endpoint;
+	read_unlock_bh(&peer->endpoint_lock);
+	sock = rcu_dereference_bh(wg->sock4);
+	if (ep.addr.sa_family != AF_INET || !sock)
+		return t;
+
+	memset(&fl, 0, sizeof(fl));
+	fl.saddr = ep.src4.s_addr;
+	fl.daddr = ep.addr4.sin_addr.s_addr;
+	fl.fl4_dport = ep.addr4.sin_port;
+	fl.fl4_sport = inet_sk(sock)->inet_sport;
+	fl.flowi4_mark = wg->fwmark;
+	fl.flowi4_proto = IPPROTO_UDP;
+	rt = ip_route_output_flow(sock_net(sock), &fl, sock);
+	if (IS_ERR(rt))
+		return t;
+	dev = rt->dst.dev;
+	if (!can_tx(dev) || rt->rt_gw_family == AF_INET6)
+		goto out;
+	n = __ipv4_neigh_lookup_noref(dev, (__force u32)rt_nexthop(rt, fl.daddr));
+	if (!n || !(READ_ONCE(n->nud_state) & NUD_VALID))
+		goto out;
+
+	eth = (struct ethhdr *)t->hdr;
+	neigh_ha_snapshot(eth->h_dest, n, dev);
+	ether_addr_copy(eth->h_source, dev->dev_addr);
+	eth->h_proto = htons(ETH_P_IP);
+	ip = (struct iphdr *)(eth + 1);
+	ip->version = 4;
+	ip->ihl = 5;
+	ip->ttl = ip4_dst_hoplimit(&rt->dst);
+	ip->protocol = IPPROTO_UDP;
+	ip->saddr = fl.saddr;
+	ip->daddr = fl.daddr;
+	udp = (struct udphdr *)(ip + 1);
+	udp->source = fl.fl4_sport;
+	udp->dest = fl.fl4_dport;
+	dev_hold(dev);
+	t->dev = dev;
+out:
+	ip_rt_put(rt);
+	return t;
+}
+
+static struct wg_fastpath_tmpl *wg_fp_tmpl(struct wg_peer *peer,
+					   wg_fastpath_can_tx_t can_tx)
+{
+	struct wg_fastpath_tmpl *t = rcu_dereference_bh(peer->fp_tmpl), *n;
+
+	if (likely(t && time_before(jiffies, t->expires)))
+		return t;
+	/* One CPU rebuilds; the others keep using the old one meanwhile. */
+	if (!spin_trylock(&peer->fp_lock))
+		return t;
+	t = rcu_dereference_protected(peer->fp_tmpl, lockdep_is_held(&peer->fp_lock));
+	if (!t || !time_before(jiffies, t->expires)) {
+		n = wg_fp_build(peer, can_tx);
+		if (n) {
+			rcu_assign_pointer(peer->fp_tmpl, n);
+			if (t)
+				call_rcu(&t->rcu, wg_fp_tmpl_free);
+			t = n;
+		}
+	}
+	spin_unlock(&peer->fp_lock);
+	return t;
+}
+
+/**
+ * wg_fastpath_seal - encrypt a forwarded packet for its peer in place
+ * @wg_dev: the WireGuard device the packet was routed to
+ * @can_tx: whether the caller can transmit on a device
+ * @buf: the buffer
+ * @off: offset of the received Ethernet frame in @buf
+ * @len: length of that frame
+ * @size: usable size of @buf
+ * @tx: where the sealed frame is and which device sends it
+ *
+ * The caller holds rcu_read_lock() across the call and its use of @tx->dev.
+ *
+ * Return: 0 when sealed; a negative errno, with @buf untouched, otherwise:
+ * -EXDEV when this CPU receives the peer's packets and the caller should seal
+ * the frame on another one.
+ */
+int wg_fastpath_seal(struct net_device *wg_dev, wg_fastpath_can_tx_t can_tx,
+		     u8 *buf, unsigned int off, unsigned int len, unsigned int size,
+		     struct wg_fastpath_tx *tx)
+{
+	const unsigned int hlen = WG_FP_HLEN + sizeof(struct message_data);
+	struct wg_device *wg = netdev_priv(wg_dev);
+	u8 *inner = buf + off + ETH_HLEN;
+	struct iphdr *iph = (struct iphdr *)inner;
+	struct wg_fastpath_tmpl *t;
+	struct message_data *msg;
+	struct noise_keypair *kp;
+	struct wg_peer *peer;
+	unsigned int ip_len, plain, mtu;
+	struct udphdr *udp;
+	struct iphdr *oip;
+	u8 *hdr;
+	u64 ctr;
+	int ret = -EAGAIN;
+
+	if (len < ETH_HLEN + sizeof(*iph) || iph->version != 4)
+		return -EPROTO;
+	ip_len = ntohs(iph->tot_len);
+	mtu = READ_ONCE(wg_dev->mtu);
+	if (ip_len < sizeof(*iph) || ETH_HLEN + ip_len > len || ip_len > mtu)
+		return -EMSGSIZE;
+	/* The same padding calculate_skb_padding() gives a packet within MTU. */
+	plain = min_t(unsigned int, ALIGN(ip_len, MESSAGE_PADDING_MULTIPLE), mtu);
+	if (off + ETH_HLEN < hlen ||
+	    off + ETH_HLEN + plain + POLY1305_DIGEST_SIZE > size)
+		return -ENOSPC;
+
+	peer = wg_allowedips_lookup_dst4(&wg->peer_allowedips, &iph->daddr);
+	if (!peer)
+		return -ENOKEY;
+	/* The CPU that receives this peer's packets also carries every ACK of
+	 * the flows sealed here; sealing beside them starves both. */
+	if (READ_ONCE(peer->fp_rx_cpu) == raw_smp_processor_id() &&
+	    num_online_cpus() > 1) {
+		wg_peer_put(peer);
+		return -EXDEV;
+	}
+	rcu_read_lock_bh();
+	if (unlikely(READ_ONCE(peer->is_dead)))
+		goto out;
+	kp = rcu_dereference_bh(peer->keypairs.current_keypair);
+	if (unlikely(!kp || !READ_ONCE(kp->sending.is_valid) ||
+		     wg_birthdate_has_expired(kp->sending.birthdate, REJECT_AFTER_TIME)))
+		goto out;
+	t = wg_fp_tmpl(peer, can_tx);
+	if (unlikely(!t || !t->dev))
+		goto out;
+	ctr = atomic64_inc_return(&kp->sending_counter) - 1;
+	if (unlikely(ctr >= REJECT_AFTER_MESSAGES))
+		goto out;
+
+	memset(inner + ip_len, 0, plain - ip_len);
+	chacha20poly1305_encrypt(inner, inner, plain, NULL, 0, ctr, kp->sending.key);
+
+	hdr = inner - hlen;
+	memcpy(hdr, t->hdr, WG_FP_HLEN);
+	oip = (struct iphdr *)(hdr + ETH_HLEN);
+	/* As send4(): only the inner ECN bits reach the outer header. */
+	oip->tos = INET_ECN_encapsulate(0, iph->tos);
+	oip->tot_len = htons(sizeof(*oip) + sizeof(*udp) + sizeof(*msg) + plain +
+			     POLY1305_DIGEST_SIZE);
+	oip->id = htons((u16)atomic_inc_return(&t->id));
+	oip->check = ip_fast_csum((u8 *)oip, oip->ihl);
+	udp = (struct udphdr *)(oip + 1);
+	udp->len = htons(sizeof(*udp) + sizeof(*msg) + plain + POLY1305_DIGEST_SIZE);
+	udp->check = 0;
+	msg = (struct message_data *)(udp + 1);
+	msg->header.type = cpu_to_le32(MESSAGE_DATA);
+	msg->key_idx = kp->remote_index;
+	msg->counter = cpu_to_le64(ctr);
+
+	/* The timers want every packet; a few a second keep them right. */
+	if (time_after(jiffies, READ_ONCE(peer->fp_timers))) {
+		WRITE_ONCE(peer->fp_timers, jiffies + HZ / 50);
+		wg_timers_any_authenticated_packet_traversal(peer);
+		wg_timers_any_authenticated_packet_sent(peer);
+		wg_timers_data_sent(peer);
+		/* keep_key_fresh(); the send is itself rate limited. */
+		if (ctr > REKEY_AFTER_MESSAGES ||
+		    (kp->i_am_the_initiator &&
+		     wg_birthdate_has_expired(kp->sending.birthdate, REKEY_AFTER_TIME)))
+			wg_packet_send_queued_handshake_initiation(peer, false);
+	}
+
+	tx->dev = t->dev;
+	tx->saddr = oip->saddr;
+	tx->daddr = oip->daddr;
+	tx->sport = udp->source;
+	tx->dport = udp->dest;
+	tx->off = hdr - buf;
+	tx->len = hlen + plain + POLY1305_DIGEST_SIZE;
+	peer->tx_bytes += tx->len;
+	ret = 0;
+out:
+	rcu_read_unlock_bh();
+	wg_peer_put(peer);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wg_fastpath_seal);
+
+void wg_fastpath_receive(struct net_device *wg_dev, struct sk_buff *skb)
+{
+	skb_mark_not_on_list(skb);
+	wg_packet_receive(netdev_priv(wg_dev), skb);
+}
+EXPORT_SYMBOL_GPL(wg_fastpath_receive);
--- a/drivers/net/wireguard/peer.c
+++ b/drivers/net/wireguard/peer.c
@@ -46,6 +46,8 @@
 	wg_timers_init(peer);
 	wg_cookie_checker_precompute_peer_keys(peer);
 	spin_lock_init(&peer->keypairs.keypair_update_lock);
+	spin_lock_init(&peer->fp_lock);
+	peer->fp_rx_cpu = -1;
 	INIT_WORK(&peer->transmit_handshake_work, wg_packet_handshake_send_worker);
 	peer->nr_tx_lanes = clamp(READ_ONCE(wg_tx_lanes), 1U, (unsigned int)WG_MAX_TX_LANES);
 	for (i = 0; i < WG_MAX_TX_LANES; ++i) {
@@ -195,6 +197,7 @@
 	int i;
 
 	dst_cache_destroy(&peer->endpoint_cache);
+	wg_fastpath_peer_free(peer);
 	for (i = 0; i < WG_MAX_TX_LANES; ++i)
 		WARN_ON(wg_prev_queue_peek(&peer->tx_lane[i].queue));
 	WARN_ON(wg_prev_queue_peek(&peer->rx_queue));
--- a/drivers/net/wireguard/peer.h
+++ b/drivers/net/wireguard/peer.h
@@ -78,6 +78,11 @@
 	struct list_head allowedips_list;
 	struct napi_struct napi;
 	u64 internal_id;
+	/* wg_fastpath_seal()'s outer header and its timer pacing. */
+	struct wg_fastpath_tmpl __rcu *fp_tmpl;
+	spinlock_t fp_lock;
+	unsigned long fp_timers;
+	int fp_rx_cpu;
 };
 
 struct wg_peer *wg_peer_create(struct wg_device *wg,
@@ -92,6 +97,7 @@
 }
 void wg_peer_put(struct wg_peer *peer);
 void wg_peer_remove(struct wg_peer *peer);
+void wg_fastpath_peer_free(struct wg_peer *peer);
 void wg_peer_remove_all(struct wg_device *wg);
 
 int wg_peer_init(void);
--- a/drivers/net/wireguard/receive.c
+++ b/drivers/net/wireguard/receive.c
@@ -522,6 +522,9 @@
 
 	if (unlikely(READ_ONCE(peer->is_dead)))
 		goto err;
+	/* Where this peer's packets arrive; wg_fastpath_seal() seals elsewhere. */
+	if (READ_ONCE(peer->fp_rx_cpu) != raw_smp_processor_id())
+		WRITE_ONCE(peer->fp_rx_cpu, raw_smp_processor_id());
 
 	ret = wg_queue_enqueue_per_device_and_peer(&wg->decrypt_queue, &peer->rx_queue, skb,
 						   wg->packet_crypt_wq);
--- /dev/null
+++ b/include/net/wg_fastpath.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NET_WG_FASTPATH_H
+#define _NET_WG_FASTPATH_H
+
+#include <linux/netdevice.h>
+
+/* Where wg_fastpath_seal() left a sealed frame: the device to transmit it on
+ * and its new offset and length in the same buffer. */
+struct wg_fastpath_tx {
+	struct net_device *dev;
+	unsigned int off, len;
+	/* The outer IPv4/UDP pair the frame was sealed with: the peer's
+	 * packets come back on its reverse. */
+	__be32 saddr, daddr;
+	__be16 sport, dport;
+};
+
+/* Whether the caller can transmit a sealed frame on @dev; called in softirq. */
+typedef bool (*wg_fastpath_can_tx_t)(const struct net_device *dev);
+
+int wg_fastpath_seal(struct net_device *wg_dev, wg_fastpath_can_tx_t can_tx,
+		     u8 *buf, unsigned int off, unsigned int len, unsigned int size,
+		     struct wg_fastpath_tx *tx);
+
+/* Hand @wg_dev an outer IPv4/UDP datagram addressed to its listen port, as
+ * its socket would: protocol, network and transport headers and skb_iif set,
+ * IP header and UDP checksum already validated. Consumes @skb. The caller
+ * holds rcu_read_lock() and keeps @wg_dev registered across the call. */
+void wg_fastpath_receive(struct net_device *wg_dev, struct sk_buff *skb);
+
+#endif /* _NET_WG_FASTPATH_H */
-- 
