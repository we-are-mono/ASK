From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Mon, 9 Nov 2026 18:30:00 +0100
Subject: [PATCH] wireguard: place receive work around the receiving CPU

One tunnel's packets all arrive on one CPU, which then receives them,
queues each to a decryption worker, and -- because it is also one of
the CPUs those workers are woken on -- often runs the worker and the
peer's NAPI poll after it as well. That CPU saturates while the others
idle, and caps the tunnel's download.

- A data message of up to 256 bytes (an ACK, a keepalive) is decrypted
  on the receiving CPU: queueing, a cross-CPU wakeup and two context
  switches cost far more than its cipher.
- A larger one wakes a worker on any CPU but the receiving one, so the
  decryption and the NAPI poll that follows it run elsewhere.

Each message still enters the peer's receive queue first and the NAPI
poll delivers in that order.
---
--- a/drivers/net/wireguard/queueing.h
+++ b/drivers/net/wireguard/queueing.h
@@ -170,7 +170,7 @@
 
 static inline int wg_queue_enqueue_per_device_and_peer(
 	struct crypt_queue *device_queue, struct prev_queue *peer_queue,
-	struct sk_buff *skb, struct workqueue_struct *wq)
+	struct sk_buff *skb, struct workqueue_struct *wq, int avoid_cpu)
 {
 	int cpu;
 
@@ -185,6 +185,10 @@
 	 * packet as soon as it can.
 	 */
 	cpu = wg_cpumask_next_online(&device_queue->last_cpu);
+	/* The worker woken here also runs the peer's NAPI poll after it; keep
+	 * both off a CPU the caller is already saturating. */
+	if (cpu == avoid_cpu && num_online_cpus() > 1)
+		cpu = wg_cpumask_next_online(&device_queue->last_cpu);
 	if (unlikely(ptr_ring_produce_bh(&device_queue->ring, skb)))
 		return -EPIPE;
 	queue_work_on(cpu, wq, &per_cpu_ptr(device_queue->worker, cpu)->work);
--- a/drivers/net/wireguard/receive.c
+++ b/drivers/net/wireguard/receive.c
@@ -25,6 +25,9 @@
 
 #define SKB_TYPE_LE32(skb) (((struct message_header *)(skb)->data)->type)
 
+/* Data messages up to this size are decrypted where they arrive. */
+#define WG_RX_INLINE_MAX 256
+
 static size_t validate_header_len(struct sk_buff *skb)
 {
 	if (unlikely(skb->len < sizeof(struct message_header)))
@@ -526,8 +529,22 @@
 	if (READ_ONCE(peer->fp_rx_cpu) != raw_smp_processor_id())
 		WRITE_ONCE(peer->fp_rx_cpu, raw_smp_processor_id());
 
+	/* A packet this small -- an ACK, a keepalive -- costs less to decrypt
+	 * here than to hand to a worker on another CPU and back. It still takes
+	 * its place in the peer's queue first, so delivery stays in order. */
+	if (skb->len <= WG_RX_INLINE_MAX) {
+		atomic_set_release(&PACKET_CB(skb)->state, PACKET_STATE_UNCRYPTED);
+		if (unlikely(!wg_prev_queue_enqueue(&peer->rx_queue, skb)))
+			goto err;
+		wg_queue_enqueue_per_peer_rx(skb, likely(decrypt_packet(skb,
+				PACKET_CB(skb)->keypair)) ? PACKET_STATE_CRYPTED :
+				PACKET_STATE_DEAD);
+		rcu_read_unlock_bh();
+		return;
+	}
+
 	ret = wg_queue_enqueue_per_device_and_peer(&wg->decrypt_queue, &peer->rx_queue, skb,
-						   wg->packet_crypt_wq);
+						   wg->packet_crypt_wq, raw_smp_processor_id());
 	if (unlikely(ret == -EPIPE))
 		wg_queue_enqueue_per_peer_rx(skb, PACKET_STATE_DEAD);
 	if (likely(!ret || ret == -EPIPE)) {
--- a/drivers/net/wireguard/send.c
+++ b/drivers/net/wireguard/send.c
@@ -319,7 +319,7 @@
 		goto err;
 
 	ret = wg_queue_enqueue_per_device_and_peer(&wg->encrypt_queue, &peer->tx_lane[PACKET_CB(first)->lane].queue, first,
-						   wg->packet_crypt_wq);
+						   wg->packet_crypt_wq, -1);
 	if (unlikely(ret == -EPIPE))
 		wg_queue_enqueue_per_peer_tx(first, PACKET_STATE_DEAD);
 err:
-- 
