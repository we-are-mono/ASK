+++ b/net/netfilter/nf_flow_table_core.c
@@ -172,6 +172,7 @@ static int flow_offload_fill_route(struct flow_offload *flow,
 	 * path, not to how the path is transmitted, and a DIRECT tuple has no
 	 * room for it once the union holds its cached addresses. */
 	flow_tuple->session = route->tuple[dir].session;
+	flow_tuple->tunnel = route->tuple[dir].tunnel;
 
 	switch (route->tuple[dir].xmit_type) {
 	case FLOW_OFFLOAD_XMIT_DIRECT:
diff --git a/net/netfilter/nf_flow_table_offload.c b/net/netfilter/nf_flow_table_offload.c
index ee87af80a9c1..f1f53559588a 100644
