+++ b/net/netfilter/nf_flow_table_offload.c
@@ -979,6 +979,8 @@ static int nf_flow_offload_tuple(struct nf_flowtable *flowtable,
 		 * record naming no session is already self-describing. */
 		.nf_session = &flow->tuplehash[dir].tuple.session,
 		.nf_session_reverse = &flow->tuplehash[!dir].tuple.session,
