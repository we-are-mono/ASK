diff --git a/include/net/netfilter/nf_flow_table.h b/include/net/netfilter/nf_flow_table.h
index 3764c26d19ba..64701d13405a 100644
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -130,6 +130,32 @@ struct nf_flow_session {
 	u8				h_dest[ETH_ALEN];
 };
 
+/* One IP-in-IP tunnel on the path a direction transmits over, as the tunnel
+ * device's own forwarding-path hook resolved it: the outer header it would
+ * prepend, the next hop the outer packet leaves for and its address, and the
+ * device it leaves by. A hardware adapter cannot re-derive any of it: the
+ * outer route is looked up by the tunnel's transmit path rather than by the
+ * flow's, and a tunnel device registers no lower neighbour. Netfilter
+ * describes neither half -- there is no push for the header a direction
+ * inserts and no pop or key for the one it strips -- so this record is the
+ * only account of the hop a rule carries. lower_ifindex is zero when the path
+ * crosses no tunnel, which makes the whole record meaningless, exactly as for
+ * a session. The flags are DEV_PATH_TUNNEL_F_*.
+ */
+struct nf_flow_tunnel {
+	int				lower_ifindex;
+	u8				family;
+	u8				proto;
+	u8				ttl;
+	u8				tos;
+	u8				flags;
+	u8				h_dest[ETH_ALEN];
+	__be32				flowlabel;
+	union nf_inet_addr		saddr;
+	union nf_inet_addr		daddr;
+	union nf_inet_addr		nexthop;
+};
+
 struct flow_offload_tuple {
 	union {
 		struct in_addr		src_v4;
@@ -164,6 +190,7 @@ struct flow_offload_tuple {
 	/* Below __hash, so it never widens a lookup key, and outside the
 	 * union below, which a NEIGH tuple spends on its destination. */
 	struct nf_flow_session		session;
+	struct nf_flow_tunnel		tunnel;
 	union {
 		struct {
 			struct dst_entry *dst_cache;
@@ -245,6 +272,8 @@ struct nf_flow_route {
 		 * out.h_dest would otherwise be the only record of -- and that
 		 * member is not carried over to a NEIGH tuple. */
 		struct nf_flow_session		session;
+		/* And the tunnel it crosses, which nothing else records. */
+		struct nf_flow_tunnel		tunnel;
 		enum flow_offload_xmit_type	xmit_type;
 	} tuple[FLOW_OFFLOAD_DIR_MAX];
 };
diff --git a/net/ipv6/ip6_tunnel.c b/net/ipv6/ip6_tunnel.c
index 09964b40f0d2..5ef7ce780708 100644
--- a/net/ipv6/ip6_tunnel.c
+++ b/net/ipv6/ip6_tunnel.c
@@ -1428,6 +1428,87 @@ ipxip6_tnl_xmit(struct sk_buff *skb, struct net_device *dev,
 	return 0;
 }
 
+/* The forwarding path through this tunnel: the outer IPv6 header the transmit
+ * path would build for an IPv4 packet, and the device and next hop the outer
+ * packet leaves by, looked up as ip6_tnl_xmit() looks them up. Only a tunnel
+ * with a fixed remote is a hop: an NBMA tunnel picks the outer destination
+ * per packet, a collect_md one takes it from metadata, and a per-packet mark
+ * or an extra encapsulation (FOU, GUE) reach the outer packet by ways this
+ * walk cannot see. An IPv6 payload would be IPv6-in-IPv6, which is not
+ * described either; the walk reports the IPIP header and leaves the family
+ * of the flow inside to whoever consumes the hop.
+ */
+static int ip6_tnl_fill_forward_path(struct net_device_path_ctx *ctx,
+				     struct net_device_path *path)
+{
+	struct net_device *dev = (struct net_device *)ctx->dev;
+	struct ip6_tnl *t = netdev_priv(dev);
+	const struct __ip6_tnl_parm *p = &t->parms;
+	const struct rt6_info *rt;
+	struct dst_entry *dst;
+	struct neighbour *n;
+	struct flowi6 fl6;
+	u8 nud_state;
+	int ret = -ENOENT;
+
+	if ((p->proto != IPPROTO_IPIP && p->proto != 0) || p->collect_md ||
+	    ipv6_addr_any(&p->raddr) || (p->flags & IP6_TNL_F_USE_ORIG_FWMARK) ||
+	    !(p->flags & IP6_TNL_F_CAP_XMIT) || t->encap.type != TUNNEL_ENCAP_NONE)
+		return -EOPNOTSUPP;
+	/* The template the transmit path starts from: the endpoints, the
+	 * bound link and the fixed traffic class and flow label. */
+	memcpy(&fl6, &t->fl.u.ip6, sizeof(fl6));
+	fl6.flowi6_proto = IPPROTO_IPIP;
+	fl6.flowi6_mark = p->fwmark;
+	fl6.flowi6_uid = sock_net_uid(dev_net(dev), NULL);
+	dst = ip6_route_output(dev_net(dev), NULL, &fl6);
+	if (dst->error) {
+		dst_release(dst);
+		return -ENOENT;
+	}
+	dst = xfrm_lookup(dev_net(dev), dst, flowi6_to_flowi(&fl6), NULL, 0);
+	if (IS_ERR(dst))
+		return -ENOENT;
+	rt = dst_rt6_info(dst);
+	if (dst_xfrm(dst) || dst->dev == dev || dst->lwtstate ||
+	    (rt->rt6i_flags & (RTF_REJECT | RTF_LOCAL | RTF_ANYCAST))) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	n = dst_neigh_lookup(dst, &fl6.daddr);
+	if (!n)
+		goto out;
+	read_lock_bh(&n->lock);
+	nud_state = n->nud_state;
+	ether_addr_copy(path->tunnel.h_dest, n->ha);
+	read_unlock_bh(&n->lock);
+	neigh_release(n);
+	if (!(nud_state & NUD_VALID))
+		goto out;
+	path->type = DEV_PATH_TUNNEL;
+	path->dev = dev;
+	path->tunnel.family = AF_INET6;
+	path->tunnel.proto = IPPROTO_IPIP;
+	path->tunnel.ttl = p->hop_limit;
+	path->tunnel.tos = p->flags & IP6_TNL_F_USE_ORIG_TCLASS ? 0 :
+			   ip6_tclass(p->flowinfo);
+	path->tunnel.flags =
+		(p->flags & IP6_TNL_F_USE_ORIG_TCLASS ? DEV_PATH_TUNNEL_F_INHERIT_TOS : 0) |
+		(p->flags & IP6_TNL_F_IGN_ENCAP_LIMIT ? 0 : DEV_PATH_TUNNEL_F_ENCAP_LIMIT) |
+		(p->flags & IP6_TNL_F_RCV_DSCP_COPY ? DEV_PATH_TUNNEL_F_DSCP_COPY : 0);
+	path->tunnel.flowlabel = p->flowinfo & IPV6_FLOWLABEL_MASK;
+	memcpy(path->tunnel.saddr, &fl6.saddr, sizeof(fl6.saddr));
+	memcpy(path->tunnel.daddr, &fl6.daddr, sizeof(fl6.daddr));
+	memcpy(path->tunnel.nexthop, rt6_nexthop(rt, &fl6.daddr),
+	       sizeof(struct in6_addr));
+	memcpy(ctx->daddr, path->tunnel.h_dest, ETH_ALEN);
+	ctx->dev = dst->dev;
+	ret = 0;
+out:
+	dst_release(dst);
+	return ret;
+}
+
 static netdev_tx_t
 ip6_tnl_start_xmit(struct sk_buff *skb, struct net_device *dev)
 {
@@ -1834,6 +1915,7 @@ static const struct net_device_ops ip6_tnl_netdev_ops = {
 	.ndo_change_mtu = ip6_tnl_change_mtu,
 	.ndo_get_stats64 = dev_get_tstats64,
 	.ndo_get_iflink = ip6_tnl_get_iflink,
+	.ndo_fill_forward_path = ip6_tnl_fill_forward_path,
 };
 
 #define IPXIPX_FEATURES (NETIF_F_SG |		\
diff --git a/net/ipv6/sit.c b/net/ipv6/sit.c
index 710d66374c57..aeb81c942d33 100644
--- a/net/ipv6/sit.c
+++ b/net/ipv6/sit.c
@@ -1069,6 +1069,74 @@ static netdev_tx_t sit_tunnel_xmit__(struct sk_buff *skb,
 	return NETDEV_TX_OK;
 }
 
+/* The forwarding path through this tunnel: the outer IPv4 header the transmit
+ * path would build for an IPv6 packet, and the device and next hop the outer
+ * packet leaves by. The route is looked up exactly as ipip6_tunnel_xmit()
+ * looks it up, so a hardware adapter describing the hop describes what
+ * software does. Only a point-to-point tunnel with a fixed remote is a hop at
+ * all: 6rd and ISATAP derive the outer destination from the inner one, which
+ * this walk does not see. A TOS of 1 means the inner packet's, and is
+ * reported as such rather than as a value.
+ */
+static int ipip6_fill_forward_path(struct net_device_path_ctx *ctx,
+				   struct net_device_path *path)
+{
+	struct net_device *dev = (struct net_device *)ctx->dev;
+	struct ip_tunnel *tunnel = netdev_priv(dev);
+	const struct iphdr *tiph = &tunnel->parms.iph;
+	u8 tos = tiph->tos == 1 ? 0 : tiph->tos;
+	struct neighbour *n;
+	struct flowi4 fl4;
+	struct rtable *rt;
+	u8 nud_state;
+	int ret = -ENOENT;
+
+	if (!tiph->daddr || (dev->priv_flags & IFF_ISATAP))
+		return -EOPNOTSUPP;
+	flowi4_init_output(&fl4, tunnel->parms.link, tunnel->fwmark,
+			   tos & INET_DSCP_MASK, RT_SCOPE_UNIVERSE,
+			   IPPROTO_IPV6, 0, tiph->daddr, tiph->saddr, 0, 0,
+			   sock_net_uid(tunnel->net, NULL));
+	rt = ip_route_output_flow(tunnel->net, &fl4, NULL);
+	if (IS_ERR(rt))
+		return -ENOENT;
+	/* A transformed outer packet, a routing loop, a route with its own
+	 * encapsulation or an IPv6 next hop are all shapes the walk does not
+	 * describe. */
+	if (rt->rt_type != RTN_UNICAST || rt->rt_gw_family == AF_INET6 ||
+	    rt->dst.dev == dev || rt->dst.lwtstate || dst_xfrm(&rt->dst)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	n = dst_neigh_lookup(&rt->dst, &fl4.daddr);
+	if (!n)
+		goto out;
+	read_lock_bh(&n->lock);
+	nud_state = n->nud_state;
+	ether_addr_copy(path->tunnel.h_dest, n->ha);
+	read_unlock_bh(&n->lock);
+	neigh_release(n);
+	if (!(nud_state & NUD_VALID))
+		goto out;
+	path->type = DEV_PATH_TUNNEL;
+	path->dev = dev;
+	path->tunnel.family = AF_INET;
+	path->tunnel.proto = IPPROTO_IPV6;
+	path->tunnel.ttl = tiph->ttl;
+	path->tunnel.tos = tos;
+	path->tunnel.flags = (tiph->tos == 1 ? DEV_PATH_TUNNEL_F_INHERIT_TOS : 0) |
+			     (tiph->frag_off & htons(IP_DF) ? DEV_PATH_TUNNEL_F_DF : 0);
+	path->tunnel.saddr[0] = fl4.saddr;
+	path->tunnel.daddr[0] = fl4.daddr;
+	path->tunnel.nexthop[0] = rt_nexthop(rt, fl4.daddr);
+	memcpy(ctx->daddr, path->tunnel.h_dest, ETH_ALEN);
+	ctx->dev = rt->dst.dev;
+	ret = 0;
+out:
+	ip_rt_put(rt);
+	return ret;
+}
+
 static netdev_tx_t sit_tunnel_xmit(struct sk_buff *skb,
 				   struct net_device *dev)
 {
@@ -1409,6 +1477,7 @@ static const struct net_device_ops ipip6_netdev_ops = {
 	.ndo_siocdevprivate = ipip6_tunnel_siocdevprivate,
 	.ndo_get_iflink = ip_tunnel_get_iflink,
 	.ndo_tunnel_ctl = ipip6_tunnel_ctl,
+	.ndo_fill_forward_path = ipip6_fill_forward_path,
 };
 
 static void ipip6_dev_free(struct net_device *dev)
