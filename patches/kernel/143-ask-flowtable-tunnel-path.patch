diff --git a/net/netfilter/nft_flow_offload.c b/net/netfilter/nft_flow_offload.c
index d71edfa36e95..3f0e8aa76abe 100644
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -93,6 +93,8 @@ struct nft_forward_info {
 	 * implicit in h_dest and the encap slot: a hardware adapter cannot
 	 * re-derive any of it, and h_dest is not carried to a NEIGH tuple. */
 	struct nf_flow_session session;
+	/* And the one tunnel, for the same reason. */
+	struct nf_flow_tunnel tunnel;
 	enum flow_offload_xmit_type xmit_type;
 };
 
@@ -188,6 +190,41 @@ static void nft_dev_path_info(const struct net_device_path_stack *stack,
 			if (!READ_ONCE(flowtable->use_neigh))
 				info->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
 			break;
+		case DEV_PATH_TUNNEL:
+			/* Only for a table that asked for neighbour output,
+			 * which is a hardware adapter's. Anything else keeps
+			 * the tunnel device as the reverse direction's ingress,
+			 * where the software path matches the inner packet
+			 * after the tunnel has decapsulated it; moving that
+			 * ingress to the port below would lose it, because the
+			 * software path decapsulates nothing.
+			 *
+			 * Recorded whole, like a session, because nothing about
+			 * it reaches a rule: the outer header goes on after the
+			 * flowtable has transmitted, so no push describes it,
+			 * and comes off before the inner packet exists, so no
+			 * pop or key describes that. Not an encapsulation slot
+			 * either -- those are the L2 headers a rule can pop and
+			 * push. One per path, and the device the outer packet
+			 * leaves by is the next entry's. */
+			if (!READ_ONCE(flowtable->use_neigh) ||
+			    info->tunnel.lower_ifindex || i + 1 >= stack->num_paths)
+				goto refuse;
+			info->tunnel.lower_ifindex = stack->path[i + 1].dev->ifindex;
+			info->tunnel.family = path->tunnel.family;
+			info->tunnel.proto = path->tunnel.proto;
+			info->tunnel.ttl = path->tunnel.ttl;
+			info->tunnel.tos = path->tunnel.tos;
+			info->tunnel.flags = path->tunnel.flags;
+			info->tunnel.flowlabel = path->tunnel.flowlabel;
+			memcpy(info->tunnel.h_dest, path->tunnel.h_dest, ETH_ALEN);
+			memcpy(&info->tunnel.saddr, path->tunnel.saddr,
+			       sizeof(info->tunnel.saddr));
+			memcpy(&info->tunnel.daddr, path->tunnel.daddr,
+			       sizeof(info->tunnel.daddr));
+			memcpy(&info->tunnel.nexthop, path->tunnel.nexthop,
+			       sizeof(info->tunnel.nexthop));
+			break;
 		default:
 			goto refuse;
 		}
@@ -256,6 +293,7 @@ static void nft_dev_forward_path(struct nf_flow_route *route,
 	/* Belongs to this direction's egress path, as out.h_dest does, and
 	 * unlike out.h_dest it survives NEIGH output. */
 	route->tuple[dir].session = info.session;
+	route->tuple[dir].tunnel = info.tunnel;
 
 	route->tuple[!dir].in.ifindex = info.indev->ifindex;
 	for (i = 0; i < info.num_encaps; i++) {
