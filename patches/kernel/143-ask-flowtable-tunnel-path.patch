 /* Context is borrowed for the callback and NULL for other producers. Drivers
  * must not retain nf_ct, either dst or either session. nf_dst is this
@@ -707,14 +708,19 @@ struct nf_flow_session;
  * if any: nf_session belongs to nf_dst and nf_session_reverse to
