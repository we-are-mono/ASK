 net/ipv6/ip6_tunnel.c                 | 82 +++++++++++++++++++++++++++
 net/ipv6/sit.c                        | 69 ++++++++++++++++++++++
 net/netfilter/nf_flow_table_core.c    |  1 +
 net/netfilter/nf_flow_table_offload.c |  2 +
 net/netfilter/nft_flow_offload.c      | 38 +++++++++++++
 8 files changed, 261 insertions(+), 2 deletions(-)

diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
index c658c038556d..5658e8d15f41 100644
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -839,8 +839,21 @@ enum net_device_path_type {
 	DEV_PATH_PPPOE,
 	DEV_PATH_DSA,
 	DEV_PATH_MTK_WDMA,
+	DEV_PATH_TUNNEL,
 };
 
+/* Properties of a DEV_PATH_TUNNEL hop that its transmit path decides per
+ * tunnel rather than per packet. INHERIT_TOS: the outer TOS or traffic class
+ * is copied from the inner packet, and the recorded one is zero. DF: the
+ * outer IPv4 header carries the don't-fragment bit. ENCAP_LIMIT: the outer
+ * IPv6 header is followed by a destination options header carrying a tunnel
+ * encapsulation limit. DSCP_COPY: on receive, the outer DSCP replaces the
+ * inner packet's. */
+#define DEV_PATH_TUNNEL_F_INHERIT_TOS	BIT(0)
+#define DEV_PATH_TUNNEL_F_DF		BIT(1)
+#define DEV_PATH_TUNNEL_F_ENCAP_LIMIT	BIT(2)
+#define DEV_PATH_TUNNEL_F_DSCP_COPY	BIT(3)
+
 struct net_device_path {
 	enum net_device_path_type	type;
 	const struct net_device		*dev;
@@ -871,6 +884,25 @@ struct net_device_path {
 			u8 bss;
 			u8 amsdu;
 		} mtk_wdma;
+		/* An IP-in-IP tunnel device: the outer header its transmit
+		 * path would prepend, resolved as that path resolves it, and
+		 * the next hop the outer packet leaves for. The walk continues
+		 * on the device the outer route names, with ctx->daddr set to
+		 * that next hop's address, so a tunnel over a VLAN device, a
+		 * bridge or a PPPoE session is walked past the tunnel as any
+		 * other upper device is. */
+		struct {
+			u8	family;		/* AF_INET or AF_INET6: the outer header */
+			u8	proto;		/* its protocol or next header */
+			u8	ttl;		/* zero copies the inner packet's */
+			u8	tos;		/* TOS or traffic class */
+			u8	flags;		/* DEV_PATH_TUNNEL_F_* */
+			u8	h_dest[ETH_ALEN];
+			__be32	flowlabel;	/* an IPv6 outer header's, or zero */
+			__be32	saddr[4];	/* the outer endpoints, IPv4 in [0] */
+			__be32	daddr[4];
+			__be32	nexthop[4];	/* the outer route's next hop */
+		} tunnel;
 	};
 };
 
