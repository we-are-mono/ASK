+/**
+ * nf_xt_port_dependent - whether x_tables could tell two UDP streams apart
+ * @net: the network namespace
+ * @probe: the stream, known but for its ports
+ *
+ * Walks the ip_tables or ip6_tables tables, as @probe->family says, that a
+ * forwarded copy of the stream crosses at prerouting, forward and
+ * postrouting, with the NAT tables the NAT core runs for a connection's first
+ * packet among them; see struct nft_port_probe for what the caller vouches
+ * for. A family whose module is not loaded has no table.
+ *
+ * Return: 0 when every packet of the stream is accepted by every table
+ * unchanged, whatever its ports; 1 when two streams differing in ports may
+ * fare differently, when some path drops, or when a rule the walk does not
+ * model is reached; -E2BIG when the tables are larger than the walk's bounds,
+ * and -EINVAL for a probe missing its input or an output. Callers treat
+ * negative as 1. Never -EAGAIN: a walk reads each table as the packet path
+ * does, and a replacement during it is seen by the caller's next read of
+ * nf_xt_seq().
+ *
+ * Context: under rcu_read_lock(); it does not sleep.
+ */
+int nf_xt_port_dependent(struct net *net, const struct nft_port_probe *probe)
+{
+	const struct nf_xt_probe_hook *hook;
+
+	RCU_LOCKDEP_WARN(!rcu_read_lock_held(),
+			 "x_tables probed outside rcu_read_lock()");
+
+	switch (probe->family) {
+	case NFPROTO_IPV4:
+		hook = rcu_dereference(nf_ipt_probe_hook);
+		break;
+	case NFPROTO_IPV6:
+		hook = rcu_dereference(nf_ip6t_probe_hook);
+		break;
+	default:
+		return 1;
+	}
+	return hook ? hook->port_dependent(net, probe) : 0;
+}
+EXPORT_SYMBOL_GPL(nf_xt_port_dependent);
+
