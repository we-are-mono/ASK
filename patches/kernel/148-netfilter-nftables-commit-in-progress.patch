+/* ---- whether the tables could tell two UDP streams apart -------------------
+ *
+ * nf_xt_port_dependent() for IPv6, as ip_tables walks its own: every table a
+ * forwarded copy of a stream crosses, for all the packets the stream could
+ * carry, with everything about them known but their ports. A rule's header
+ * is decided as ip6_packet_match() decides it. Its protocol test finds UDP in
+ * every packet of the stream but a later fragment whose fragment header is
+ * followed by another extension header, which it finds nothing in: a rule
+ * that names a protocol and would take UDP may therefore not take all of
+ * them. A rule with a match may or may not apply, as any match may read the
+ * ports, and one whose match does more than decide makes the stream
+ * dependent. A rule that may apply is followed both ways.
+ *
+ * The stream is independent of its ports only when every path is accepted --
+ * by ACCEPT, or by the end of a chain whose policy accepts -- with nothing on
+ * the way but LOG, NFLOG and TRACE. Any other verdict or target on a path
+ * makes it dependent, even one every packet meets: an offload that keys the
+ * stream on its addresses applies none of them.
+ */
+
+/* Rules looked at for one table, hook and output; for one probe; and chains
+ * nested by jumps. Past any of them the answer is -E2BIG.
+ */
+#define IP6T_PROBE_VISITS	4096
+#define IP6T_PROBE_PROBE_VISITS	32768
+#define IP6T_PROBE_DEPTH	32
+
+/* ACCEPT, as a standard target stores its verdict. */
+#define IP6T_PROBE_ACCEPT	(-NF_ACCEPT - 1)
+
+/* What a rule makes of the stream's packets. */
+enum ip6t_probe_match {
+	IP6T_PROBE_NONE,	/* applies to none of them */
+	IP6T_PROBE_SOME,	/* may apply to some and not to others */
+	IP6T_PROBE_ALL,		/* applies to every one that reaches it */
+	IP6T_PROBE_OPAQUE,	/* a match does more than decide */
+};
+
+/* One walk: a table at a hook, for one output. */
+struct ip6t_probe {
+	const void *base;
+	unsigned int hook;
+	struct in6_addr saddr;
+	struct in6_addr daddr;
+	const char *indev;
+	const char *outdev;
+	unsigned int visits;
+	unsigned int *left;
+};
+
+/* A chain a jump or goto entered: the rule that entered it, whether that
+ * rule may not have applied, and whether some packets have returned from it.
+ * The base chain's frame has no rule.
+ */
+struct ip6t_probe_frame {
+	const struct ip6t_entry *call;
+	bool some;
+	bool returns;
+};
+
+/* ip6_packet_match() for the packets of the stream, which have no skb: the
+ * addresses and devices as the walk knows them, and for the protocol UDP --
+ * or, in a later fragment with an extension header after its fragment
+ * header, nothing, which no rule naming a protocol takes.
+ */
+static enum ip6t_probe_match ip6_probe_match(const struct ip6t_probe *p,
+					     const struct ip6t_ip6 *ip6info)
+{
+	unsigned long ret;
+
+	if (NF_INVF(ip6info, IP6T_INV_SRCIP,
+		    ipv6_masked_addr_cmp(&p->saddr, &ip6info->smsk,
+					 &ip6info->src)) ||
+	    NF_INVF(ip6info, IP6T_INV_DSTIP,
+		    ipv6_masked_addr_cmp(&p->daddr, &ip6info->dmsk,
+					 &ip6info->dst)))
+		return IP6T_PROBE_NONE;
+
+	ret = ifname_compare_aligned(p->indev, ip6info->iniface,
+				     ip6info->iniface_mask);
+	if (NF_INVF(ip6info, IP6T_INV_VIA_IN, ret != 0))
+		return IP6T_PROBE_NONE;
+
+	ret = ifname_compare_aligned(p->outdev, ip6info->outiface,
+				     ip6info->outiface_mask);
+	if (NF_INVF(ip6info, IP6T_INV_VIA_OUT, ret != 0))
+		return IP6T_PROBE_NONE;
