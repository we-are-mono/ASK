 		u8		dreg;
 		u8		sreg;
 	};
+	/* "ct ... set": sreg is written into the conntrack. Otherwise the
+	 * expression loads the key into dreg.
+	 */
+	bool			store;
 };
 
 struct nft_payload {
@@ -78,6 +82,58 @@ struct nft_payload {
 	u8			dreg;
 };
 
+/* The private data of the expressions below is read outside the file that
+ * evaluates them by nft_port_dependent(), which judges a ruleset without a
