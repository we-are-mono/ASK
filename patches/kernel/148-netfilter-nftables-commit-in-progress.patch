 	unsigned int verdict = NF_DROP;
@@ -361,6 +365,281 @@ ipt_do_table(void *priv,
 	else return verdict;
 }
 
+/* ---- whether the tables could tell two UDP streams apart -------------------
+ *
+ * nf_xt_port_dependent() for IPv4: every table a forwarded copy of a stream
+ * crosses, walked for all the packets the stream could carry, with everything
+ * about them known but their ports. A rule's header -- addresses, devices,
+ * protocol, the fragment flag -- is decided as ipt_do_table() decides it,
+ * once for whole packets and first fragments and once for later ones. A rule
+ * with a match may or may not apply, as any match may read the ports, and one
+ * whose match does more than decide makes the stream dependent. A rule that
+ * may apply is followed both ways: its verdict for the packets it takes, the
+ * rest of the chain for the others.
+ *
+ * The stream is independent of its ports only when every path is accepted --
+ * by ACCEPT, or by the end of a chain whose policy accepts -- with nothing on
+ * the way but LOG, NFLOG and TRACE. Any other verdict or target on a path, a
+ * drop, a queue, a mark, a translation, a conntrack template, makes it
+ * dependent, even one every packet meets: an offload that keys the stream on
+ * its addresses applies none of them.
+ */
+
+/* Rules looked at for one table, hook and output; for one probe; and chains
+ * nested by jumps. Past any of them the answer is -E2BIG.
+ */
+#define IPT_PROBE_VISITS	4096
+#define IPT_PROBE_PROBE_VISITS	32768
+#define IPT_PROBE_DEPTH		32
+
+/* ACCEPT, as a standard target stores its verdict. */
+#define IPT_PROBE_ACCEPT	(-NF_ACCEPT - 1)
+
+/* What a rule makes of the stream's packets. */
+enum ipt_probe_match {
+	IPT_PROBE_NONE,		/* applies to none of them */
+	IPT_PROBE_SOME,		/* may apply to some and not to others */
+	IPT_PROBE_ALL,		/* applies to every one that reaches it */
+	IPT_PROBE_OPAQUE,	/* a match does more than decide */
+};
+
+/* One walk: a table at a hook, for one output. */
+struct ipt_probe {
+	const void *base;
+	unsigned int hook;
+	struct iphdr iph;
+	const char *indev;
+	const char *outdev;
+	unsigned int visits;
+	unsigned int *left;
+};
+
+/* A chain a jump or goto entered: the rule that entered it, whether that
+ * rule may not have applied, and whether some packets have returned from it.
+ * The base chain's frame has no rule.
+ */
+struct ipt_probe_frame {
+	const struct ipt_entry *call;
+	bool some;
+	bool returns;
+};
+
+static enum ipt_probe_match ipt_probe_rule(const struct ipt_probe *p,
+					   const struct ipt_entry *e)
+{
+	const struct xt_entry_match *ematch;
+	enum ipt_probe_match m;
+	bool whole, later;
+
+	whole = ip_packet_match(&p->iph, p->indev, p->outdev, &e->ip, 0);
+	later = ip_packet_match(&p->iph, p->indev, p->outdev, &e->ip, 1);
+	if (!whole && !later)
+		return IPT_PROBE_NONE;
+	m = whole && later ? IPT_PROBE_ALL : IPT_PROBE_SOME;
+	xt_ematch_foreach(ematch, e) {
+		if (!xt_probe_pure_match(ematch->u.kernel.match))
+			return IPT_PROBE_OPAQUE;
+		m = IPT_PROBE_SOME;
+	}
+	return m;
+}
+
+/* The policy that a base chain's returning packets meet. */
+static int ipt_probe_policy(const struct ipt_probe *p,
+			    const struct xt_table_info *private)
+{
+	const struct xt_standard_target *t = (const void *)
+		ipt_get_target_c(get_entry(p->base, private->underflow[p->hook]));
+
+	return t->verdict == IPT_PROBE_ACCEPT ? 0 : 1;
+}
+
+/* Walk the table's base chain at the hook, and every chain it may jump or go
+ * to, as ipt_do_table() would for each packet of the stream. 0, 1 or -E2BIG.
+ * The table is the one in force, read inside the caller's xt_recseq section.
+ */
+static int ipt_probe_chain(struct ipt_probe *p,
+			   const struct xt_table_info *private)
+{
+	struct ipt_probe_frame frame[IPT_PROBE_DEPTH];
+	const struct ipt_probe_frame *done;
+	const struct xt_entry_target *t;
+	const struct ipt_entry *e;
+	enum ipt_probe_match m;
+	unsigned int depth = 0;
+	int v;
+
+	frame[0] = (struct ipt_probe_frame){};
+	e = get_entry(p->base, private->hook_entry[p->hook]);
+	for (;;) {
+		if (!p->visits || !*p->left)
+			return -E2BIG;
+		p->visits--;
+		(*p->left)--;
+
+		m = ipt_probe_rule(p, e);
+		if (m == IPT_PROBE_OPAQUE)
+			return 1;
+		if (m == IPT_PROBE_NONE) {
+			e = ipt_next_entry(e);
+			continue;
+		}
+		t = ipt_get_target_c(e);
+		if (t->u.kernel.target->target) {
+			if (!xt_probe_passing_target(t->u.kernel.target))
+				return 1;
+			e = ipt_next_entry(e);
+			continue;
+		}
+		v = ((const struct xt_standard_target *)t)->verdict;
+		if (v >= 0) {
+			/* A rule with no target goes on to the next. */
+			if (p->base + v == ipt_next_entry(e)) {
+				e = ipt_next_entry(e);
+				continue;
+			}
+			if (++depth == IPT_PROBE_DEPTH)
+				return -E2BIG;
+			frame[depth] = (struct ipt_probe_frame){
+				.call = e,
+				.some = m == IPT_PROBE_SOME,
+			};
+			e = get_entry(p->base, v);
+			continue;
+		}
+		if (v == XT_RETURN)
+			frame[depth].returns = true;
+		else if (v != IPT_PROBE_ACCEPT)
+			return 1;
+		if (m == IPT_PROBE_SOME) {
+			e = ipt_next_entry(e);
+			continue;
+		}
+
+		/* Every packet that reached the rule leaves the chain here,
+		 * accepted or returned. The chain that entered this one goes
+		 * on after the rule that did, for the packets that returned or
+		 * that the rule may not have taken; with neither, it is done
+		 * as well, and so on up.
+		 */
+		for (;;) {
+			if (!depth)
+				return frame[0].returns ?
+				       ipt_probe_policy(p, private) : 0;
+			done = &frame[depth--];
+			/* A goto pushed nothing: what returns from the chain
+			 * it went to returns from the chain that went.
+			 */
+			if (done->call->ip.flags & IPT_F_GOTO) {
+				if (done->returns)
+					frame[depth].returns = true;
+				if (done->some)
+					break;
+			} else if (done->returns || done->some) {
+				break;
+			}
+		}
+		e = ipt_next_entry(done->call);
+	}
+}
+
+/* Walk a table at the hook, once at prerouting and once for each output at
+ * forward and postrouting, with the devices each hook names. Each walk reads
+ * the table as the packet path does: xt_replace_table() waits for the
+ * section before it frees the table it replaced.
+ */
+static int ipt_probe_table(struct ipt_probe *p,
+			   const struct nft_port_probe *probe,
+			   const struct xt_table *table)
+{
+	unsigned int i, outputs = p->hook == NF_INET_PRE_ROUTING ? 1 : probe->nout;
+	const struct xt_table_info *private;
+	unsigned int addend;
+	int ret = 0;
+
+	p->indev = p->hook == NF_INET_POST_ROUTING ? nulldevname : probe->in->name;
+	for (i = 0; i < outputs && !ret; i++) {
+		p->outdev = p->hook == NF_INET_PRE_ROUTING ?
+			    nulldevname : probe->out[i]->name;
+		p->visits = IPT_PROBE_VISITS;
+		local_bh_disable();
+		addend = xt_write_recseq_begin();
+		private = READ_ONCE(table->private);
+		p->base = private->entries;
+		ret = ipt_probe_chain(p, private);
+		xt_write_recseq_end(addend);
+		local_bh_enable();
+	}
+	return ret;
+}
+
+/* The NAT tables the NAT core runs at the hook for a connection's first
+ * packet, which are on no hook of their own: iptable_nat registers them with
+ * the core rather than with netfilter.
+ */
+static int ipt_probe_nat(struct ipt_probe *p,
+			 const struct nft_port_probe *probe,
+			 const struct nf_nat_lookup_hook_priv *nat)
+{
+	const struct nf_hook_entries *e = rcu_dereference(nat->entries);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; e && i < e->num_hook_entries; i++) {
+		if (e->hooks[i].hook != ipt_do_table)
+			continue;
+		ret = ipt_probe_table(p, probe, e->hooks[i].priv);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int ipt_port_dependent(struct net *net,
+			      const struct nft_port_probe *probe)
+{
+	static const u8 hooks[] = {
+		NF_INET_PRE_ROUTING, NF_INET_FORWARD, NF_INET_POST_ROUTING,
+	};
+	unsigned int left = IPT_PROBE_PROBE_VISITS, i, j;
+	struct ipt_probe p = { .left = &left };
+	const struct nf_hook_entries *e;
+	struct nf_hook_ops **ops;
+	int ret;
+
+	if (!probe->in || !probe->nout || !probe->out)
+		return -EINVAL;
+	for (i = 0; i < probe->nout; i++)
+		if (!probe->out[i])
+			return -EINVAL;
+
+	p.iph.saddr = probe->saddr.ip;
+	p.iph.daddr = probe->daddr.ip;
+	p.iph.protocol = IPPROTO_UDP;
+	for (i = 0; i < ARRAY_SIZE(hooks); i++) {
+		e = rcu_dereference(net->nf.hooks_ipv4[hooks[i]]);
+		if (!e)
+			continue;
+		ops = nf_hook_entries_get_hook_ops(e);
+		p.hook = hooks[i];
+		for (j = 0; j < e->num_hook_entries; j++) {
+			if (ops[j]->hook_ops_type == NF_HOOK_OP_XTABLES)
+				ret = ipt_probe_table(&p, probe, e->hooks[j].priv);
+			else if (ops[j]->hook_ops_type == NF_HOOK_OP_NAT)
+				ret = ipt_probe_nat(&p, probe, e->hooks[j].priv);
+			else
+				continue;
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+static const struct nf_xt_probe_hook ipt_probe_hook = {
+	.port_dependent = ipt_port_dependent,
+};
