+/* Walk a table at the hook, once at prerouting and once for each output at
+ * forward and postrouting, with the devices each hook names. ip6mr hands a
+ * copy to forward with the device it arrived on as its input, and has made
+ * the output its device by then, which ip6_output() hands postrouting as the
+ * input. Each walk reads the table as the packet path does:
+ * xt_replace_table() waits for the section before it frees the table it
+ * replaced.
+ */
+static int ip6t_probe_table(struct ip6t_probe *p,
+			    const struct nft_port_probe *probe,
+			    const struct xt_table *table)
+{
