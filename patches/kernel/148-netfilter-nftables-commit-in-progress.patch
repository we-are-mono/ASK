+ * packet, which are on no hook of their own: ip6table_nat registers them
+ * with the core rather than with netfilter.
+ */
+static int ip6t_probe_nat(struct ip6t_probe *p,
+			  const struct nft_port_probe *probe,
+			  const struct nf_nat_lookup_hook_priv *nat)
+{
+	const struct nf_hook_entries *e = rcu_dereference(nat->entries);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; e && i < e->num_hook_entries; i++) {
+		if (e->hooks[i].hook != ip6t_do_table)
+			continue;
