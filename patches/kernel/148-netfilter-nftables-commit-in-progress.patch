diff --git a/include/net/netfilter/nf_port_probe.h b/include/net/netfilter/nf_port_probe.h
new file mode 100644
index 000000000000..5832d124b58a
--- /dev/null
+++ b/include/net/netfilter/nf_port_probe.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NF_PORT_PROBE_H
+#define _NF_PORT_PROBE_H
+
+#include <linux/atomic.h>
+#include <linux/netfilter.h>
+#include <net/net_namespace.h>
+
+struct net_device;
+
+/**
+ * struct nft_port_probe - a forwarded UDP stream, as far as it is known
+ * @family: NFPROTO_IPV4 or NFPROTO_IPV6
+ * @saddr: the stream's source address
+ * @daddr: the stream's destination address
+ * @in: the device the stream arrives on
+ * @out: the devices copies of it leave through
+ * @nout: how many entries @out has
+ *
+ * Everything about the stream but its transport ports: an offload that keys
+ * on the addresses alone asks whether the ruleset could tell two of its
+ * streams apart by port. nft_port_dependent() answers for nf_tables and
+ * nf_xt_port_dependent() for x_tables.
+ *
+ * What the caller vouches for, and both take as given: the stream is UDP; its
+ * destination is a group address, so on an Ethernet input its packets are
+ * PACKET_MULTICAST; they reach netfilter with no mark, as nothing outside it
+ * marks, filters or mangles them -- tc is the caller's to rule out; and every
+ * device in @in and @out is one the packet is received or sent on, not a
+ * register (pimreg) VIF that hands it to userspace.
+ *
+ * nft_port_dependent() follows frames through Ethernet devices and the
+ * devices linked below them: VLANs, bridges and their ports, bonds. A stream
+ * whose input or outputs, or a device below them, is anything else -- PPP, an
+ * IP tunnel, WireGuard, or an Ethernet device with neither a parent device nor
+ * a lower one, as VXLAN, geneve, gretap and veth are -- is judged dependent:
+ * the underlay those carry it over has no link to them, so its hooks, and the
+ * outer packet's output and postrouting chains, are not walked. x_tables has
+ * no device hooks, and its tables see @in and @out by name alone.
+ */
+struct nft_port_probe {
+	u8				family;
+	union nf_inet_addr		saddr;
+	union nf_inet_addr		daddr;
+	const struct net_device		*in;
+	const struct net_device * const	*out;
+	unsigned int			nout;
+};
+
+/**
+ * struct nf_xt_probe_hook - the port probe of one x_tables family
+ * @port_dependent: nf_xt_port_dependent() for that family's tables
+ *
+ * ip_tables and ip6_tables publish theirs while they are loaded, so that the
+ * caller depends on neither module: one not loaded has no table to judge.
+ */
+struct nf_xt_probe_hook {
+	int (*port_dependent)(struct net *net, const struct nft_port_probe *probe);
+};
+
+extern const struct nf_xt_probe_hook __rcu *nf_ipt_probe_hook;
+extern const struct nf_xt_probe_hook __rcu *nf_ip6t_probe_hook;
+
+#if IS_ENABLED(CONFIG_NETFILTER)
+int nf_xt_port_dependent(struct net *net, const struct nft_port_probe *probe);
+#else
+static inline int nf_xt_port_dependent(struct net *net,
+				       const struct nft_port_probe *probe)
+{
+	return 0;
+}
+#endif
+
+/**
+ * nf_xt_changed - say that the x_tables tables in @net changed
+ * @net: the network namespace
+ *
+ * Called once a table is registered with its hooks, once a replacement is in
+ * place and no packet reads the table it replaced, and once a table is gone.
+ * An x_tables table carries no generation of its own a reader could compare,
+ * so a reader that caches nf_xt_port_dependent()'s answer asks again whenever
+ * nf_xt_seq() moves. Lossless: the families do not share a lock.
+ */
+static inline void nf_xt_changed(struct net *net)
+{
+	atomic_inc_return_release(&net->nf.xt_seq);
+}
+
+/**
+ * nf_xt_seq - how many times the x_tables tables in @net have changed
+ * @net: the network namespace
+ *
+ * Read with an acquire the bump's release pairs with: a walk after a read
+ * sees every table as it was when that value was published, or later.
+ */
+static inline unsigned int nf_xt_seq(const struct net *net)
+{
+	return atomic_read_acquire(&net->nf.xt_seq);
+}
+
+#endif /* _NF_PORT_PROBE_H */
