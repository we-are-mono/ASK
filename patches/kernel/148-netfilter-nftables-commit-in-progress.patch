+static int ip6t_port_dependent(struct net *net,
+			       const struct nft_port_probe *probe)
+{
+	static const u8 hooks[] = {
+		NF_INET_PRE_ROUTING, NF_INET_FORWARD, NF_INET_POST_ROUTING,
+	};
