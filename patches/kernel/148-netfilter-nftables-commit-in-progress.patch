 #include <net/netns/generic.h>
@@ -563,6 +564,8 @@ struct nft_set_elem_expr {
  * 	@klen: key length
  * 	@dlen: data length
  *	@num_exprs: numbers of exprs
+ *	@packet_updated: a dynset expression was bound to it, so the packet
+ *		path may add and delete elements whatever @flags say; never cleared
  *	@exprs: stateful expression
  *	@catchall_list: list of catch-all set element
  * 	@data: private set data
@@ -598,6 +601,7 @@ struct nft_set {
 	u8				klen;
 	u8				dlen;
 	u8				num_exprs;
+	bool				packet_updated;
 	struct nft_expr			*exprs[NFT_SET_EXPR_MAX];
 	struct list_head		catchall_list;
 	unsigned char			data[]
@@ -1937,4 +1941,40 @@ static inline u64 nft_net_tstamp(const struct net *net)
 	return nft_pernet(net)->tstamp;
 }
 
+/**
+ * nft_commit_in_progress - whether a commit in @net is still applying itself
+ * @net: the network namespace
+ *
+ * A commit bumps net->nft.base_seq and flips the generation cursor, then goes
+ * on applying the rest of the transaction: base chain policies, element
+ * timeouts, set backend updates. This is true from just before the bump until
+ * all of that is in place. A reader that loaded base_seq with
+ * smp_load_acquire(), as the packet path's set lookups do, and then finds this
+ * false sees the commit that produced that base_seq fully applied.
+ *
+ * It lives beside base_seq in struct net, so a reader outside nf_tables needs
+ * neither its pernet id nor a symbol from it.
+ */
+static inline bool nft_commit_in_progress(const struct net *net)
+{
+	return smp_load_acquire(&net->nft.commit_applying);
+}
+
+/* The stream is described by struct nft_port_probe. A mark x_tables could
+ * leave on it, or a verdict it could give, is the caller's to rule out with
+ * nf_xt_port_dependent(), and tc the caller's own.
+ */
+#if IS_ENABLED(CONFIG_NF_TABLES)
+int nft_port_dependent(struct net *net, const struct nft_port_probe *probe);
+#else
+/* Without nf_tables whatever filters the stream cannot be read: the answer is
+ * the one that keeps a stream the kernel judges per packet.
+ */
+static inline int nft_port_dependent(struct net *net,
+				     const struct nft_port_probe *probe)
+{
+	return 1;
+}
+#endif
+
 #endif /* _NET_NF_TABLES_H */
