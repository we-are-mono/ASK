+	if (!(ip6info->flags & IP6T_F_PROTO))
+		return IP6T_PROBE_ALL;
+	if (ip6info->proto == IPPROTO_UDP) {
+		if (ip6info->invflags & IP6T_INV_PROTO)
+			return IP6T_PROBE_NONE;
+	} else if (ip6info->proto != 0 &&
+		   !(ip6info->invflags & IP6T_INV_PROTO)) {
+		/* '-p all' matches whatever protocol is found. */
+		return IP6T_PROBE_NONE;
+	}
