+/* Matches that do nothing but decide. Whatever a packet's ports make of one,
+ * the rule it sits in applies or does not, and the walk follows both. What
+ * one keeps -- a counter, a token bucket, a set's counters, shared between
+ * rules or not -- only ever decides x_tables matches, which the walk takes
+ * the same way, and none of them drops a well-formed packet itself. Not among
+ * them: hashlimit, which drops a packet it has no room to give a bucket --
+ * per port, with --hashlimit-mode dstport -- connlimit, which drops one it
+ * cannot count, and recent, which drops one it cannot record; connlabel,
+ * whose --set writes the conntrack's labels, and socket, whose
+ * --restore-skmark writes the packet's mark, either of which nf_tables may
+ * read; and any match this list does not know.
+ */
+static const char *const xt_probe_pure[] = {
+	"udp", "tcp", "icmp", "icmp6", "multiport", "comment", "state",
+	"conntrack", "mark", "connmark", "set", "iprange", "pkttype",
+	"addrtype", "physdev", "mac", "length", "dscp", "tos", "ttl", "hl",
+	"policy", "helper", "u32", "string", "time", "limit",
+	"quota", "connbytes", "statistic", "rpfilter", "esp",
+	"ah", "devgroup", "owner", "cgroup", "nfacct", "realm",
+	"ecn", "ipv6header", "frag", "hbh", "dst", "rt", "mh", "eui64", "srh",
+	"sctp", "dccp", "cpu", "cluster", "rateest", "ipvs", "osf", "l2tp",
+	"ipcomp", "bpf",
+};
+
+/**
+ * xt_probe_pure_match - whether a match does nothing but decide
+ * @match: the match
+ *
+ * For the port probes of ip_tables and ip6_tables, which judge a stream known
+ * but for its ports and evaluate no match: a rule with a pure one may or may
+ * not apply, and any other makes the stream dependent.
+ */
+bool xt_probe_pure_match(const struct xt_match *match)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(xt_probe_pure); i++)
+		if (!strcmp(match->name, xt_probe_pure[i]))
+			return true;
+	return false;
+}
+EXPORT_SYMBOL_GPL(xt_probe_pure_match);
+
+/**
+ * xt_probe_passing_target - whether a target leaves the packet to the next rule
+ * @target: an extension target
+ *
+ * LOG, NFLOG and TRACE report the packet and return XT_CONTINUE, changing
+ * nothing a later rule or the packet's fate reads. Any other target decides
+ * the packet or changes something about it.
+ */
+bool xt_probe_passing_target(const struct xt_target *target)
+{
+	return !strcmp(target->name, "LOG") || !strcmp(target->name, "NFLOG") ||
+	       !strcmp(target->name, "TRACE");
+}
+EXPORT_SYMBOL_GPL(xt_probe_passing_target);
