+		/* Every packet that reached the rule leaves the chain here,
+		 * accepted or returned. The chain that entered this one goes
+		 * on after the rule that did, for the packets that returned or
+		 * that the rule may not have taken; with neither, it is done
+		 * as well, and so on up.
+		 */
+		for (;;) {
+			if (!depth)
