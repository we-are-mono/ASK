+	xt_ematch_foreach(ematch, e) {
+		if (!xt_probe_pure_match(ematch->u.kernel.match))
+			return IP6T_PROBE_OPAQUE;
+		m = IP6T_PROBE_SOME;
+	}
+	return m;
