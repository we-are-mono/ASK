From a09c084b699852ded1d04e4d04f68a9cc6622a10 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Sat, 17 Oct 2026 02:30:03 +0200
Subject: [PATCH] netfilter: flowtable: carry transit ESP and IP-in-IP

A router forwards ESP between two IPsec peers, and IPv4 or IPv6 in IP
between two tunnel endpoints, and conntrack tracks each as it tracks any
protocol it has no handler for: by the address pair and the protocol.
The flowtable carries TCP, UDP and GREv0 only, so `flow add` leaves the
rest to the slow path, and an offload behind the flowtable is never
offered them.

Carry ESP, IPIP and IPv6-in-IP the way GRE is carried: the tuple is the
address pair and the protocol, with no ports, and the match handed to a
driver says as much. Like GRE they are not offered NATed. NPTv6 leaves
IPS_NAT clear and still translates a flow's addresses, and the port
rewrites would then write the tuple's zero ports into an SPI, a GRE
header or an inner IP header: they now rewrite TCP and UDP alone, in
software and in the rule handed to a driver. The offload timeout holds
these flows for a day as it holds GRE, and a flow torn down hands its
connection back with the timeout conntrack would have given it, GRE's
included, which had kept the day.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 net/netfilter/nf_flow_table_core.c    | 28 +++++++++++++++++++++++++++
 net/netfilter/nf_flow_table_ip.c      | 16 +++++++++++++++
 net/netfilter/nf_flow_table_offload.c | 14 ++++++++++++--
 net/netfilter/nft_flow_offload.c      | 11 +++++++++++
 4 files changed, 67 insertions(+), 2 deletions(-)

diff --git a/net/netfilter/nf_flow_table_core.c b/net/netfilter/nf_flow_table_core.c
index ec5d7eae5406..69c01ead90e0 100644
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -276,6 +276,19 @@ static void flow_offload_fixup_ct(struct nf_conn *ct)
 
 		timeout = tn->timeouts[state];
 		timeout -= tn->offload_timeout;
+	} else if (l4num == IPPROTO_ESP || l4num == IPPROTO_IPIP ||
+		   l4num == IPPROTO_IPV6) {
+		/* Handed back as conntrack would have kept it: its timeout
+		 * for any protocol it has no handler for, rather than the day
+		 * the flowtable held it at.
+		 */
+		timeout = nf_generic_pernet(net)->timeout;
+#ifdef CONFIG_NF_CT_PROTO_GRE
+	} else if (l4num == IPPROTO_GRE) {
+		/* And GRE with what its tracker refreshes it to. */
+		timeout = test_bit(IPS_SEEN_REPLY_BIT, &ct->status) ?
+			  ct->proto.gre.stream_timeout : ct->proto.gre.timeout;
+#endif
 	} else {
 		return;
 	}
@@ -609,6 +622,9 @@ static void nf_flow_table_extend_ct_timeout(struct nf_conn *ct)
 		switch (l4proto) {
 		case IPPROTO_UDP:
 		case IPPROTO_GRE:
+		case IPPROTO_ESP:
+		case IPPROTO_IPIP:
+		case IPPROTO_IPV6:
 			new_timeout = NF_CT_DAY;
 			break;
 		case IPPROTO_TCP:
@@ -737,6 +753,14 @@ void nf_flow_snat_port(const struct flow_offload *flow,
 	struct flow_ports *hdr;
 	__be16 port, new_port;
 
+	/* Only TCP and UDP have ports there. A flow of another protocol is
+	 * translated by its addresses alone, as NPTv6 translates one without
+	 * setting IPS_NAT; what follows its IP header is an SPI, a GRE header
+	 * or an inner IP header.
+	 */
+	if (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP)
+		return;
+
 	hdr = (void *)(skb_network_header(skb) + thoff);
 
 	switch (dir) {
@@ -763,6 +787,10 @@ void nf_flow_dnat_port(const struct flow_offload *flow, struct sk_buff *skb,
 	struct flow_ports *hdr;
 	__be16 port, new_port;
 
+	/* See nf_flow_snat_port(). */
+	if (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP)
+		return;
+
 	hdr = (void *)(skb_network_header(skb) + thoff);
 
 	switch (dir) {
diff --git a/net/netfilter/nf_flow_table_ip.c b/net/netfilter/nf_flow_table_ip.c
index cde4a3f73d7e..e2edd607afe7 100644
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -206,6 +206,15 @@ static int nf_flow_tuple_ip(struct nf_flowtable_ctx *ctx, struct sk_buff *skb,
 		ctx->hdrsize = sizeof(struct gre_base_hdr);
 		break;
 #endif
+	case IPPROTO_ESP:
+		ctx->hdrsize = sizeof(struct ip_esp_hdr);
+		break;
+	case IPPROTO_IPIP:
+	case IPPROTO_IPV6:
+		/* Tracked as conntrack tracks any protocol it has no
+		 * handler for: the address pair and the protocol. */
+		ctx->hdrsize = 0;
+		break;
 	default:
 		return -1;
 	}
@@ -675,6 +684,13 @@ static int nf_flow_tuple_ipv6(struct nf_flowtable_ctx *ctx, struct sk_buff *skb,
 		ctx->hdrsize = sizeof(struct gre_base_hdr);
 		break;
 #endif
+	case IPPROTO_ESP:
+		ctx->hdrsize = sizeof(struct ip_esp_hdr);
+		break;
+	case IPPROTO_IPIP:
+	case IPPROTO_IPV6:
+		ctx->hdrsize = 0;
+		break;
 	default:
 		return -1;
 	}
diff --git a/net/netfilter/nf_flow_table_offload.c b/net/netfilter/nf_flow_table_offload.c
index 73323775f4ce..8b95789201c5 100644
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -182,6 +182,9 @@ static int nf_flow_rule_match(struct nf_flow_match *match,
 		break;
 	case IPPROTO_UDP:
 	case IPPROTO_GRE:
+	case IPPROTO_ESP:
+	case IPPROTO_IPIP:
+	case IPPROTO_IPV6:
 		break;
 	default:
 		return -EOPNOTSUPP;
@@ -550,10 +553,14 @@ static int flow_offload_port_snat(struct net *net,
 				  enum flow_offload_tuple_dir dir,
 				  struct nf_flow_rule *flow_rule)
 {
-	struct flow_action_entry *entry = flow_action_entry_next(flow_rule);
+	struct flow_action_entry *entry;
 	u32 mask, port;
 	u32 offset;
 
+	/* No ports to rewrite: see nf_flow_snat_port(). */
+	if (!flow_offload_l4proto(flow))
+		return 0;
+	entry = flow_action_entry_next(flow_rule);
 	if (!entry)
 		return -E2BIG;
 
@@ -584,10 +591,13 @@ static int flow_offload_port_dnat(struct net *net,
 				  enum flow_offload_tuple_dir dir,
 				  struct nf_flow_rule *flow_rule)
 {
-	struct flow_action_entry *entry = flow_action_entry_next(flow_rule);
+	struct flow_action_entry *entry;
 	u32 mask, port;
 	u32 offset;
 
+	if (!flow_offload_l4proto(flow))
+		return 0;
+	entry = flow_action_entry_next(flow_rule);
 	if (!entry)
 		return -E2BIG;
 
diff --git a/net/netfilter/nft_flow_offload.c b/net/netfilter/nft_flow_offload.c
index 8af60003fb3a..1fe72434c35a 100644
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -486,6 +486,17 @@ static void nft_flow_offload_eval(const struct nft_expr *expr,
 		break;
 	}
 #endif
+	/* Transit ESP, IPv4 and IPv6 in IP: tracked by their address pair
+	 * alone, so a flow of them is that pair. Not NATed, as GRE is not;
+	 * NPTv6, which leaves IPS_NAT clear, translates their addresses
+	 * alone (nf_flow_snat_port()).
+	 */
+	case IPPROTO_ESP:
+	case IPPROTO_IPIP:
+	case IPPROTO_IPV6:
+		if (ct->status & IPS_NAT_MASK)
+			goto out;
+		break;
 	default:
 		goto out;
 	}
-- 
