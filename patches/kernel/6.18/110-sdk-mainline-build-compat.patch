diff --git a/drivers/net/phy/phylink.c b/drivers/net/phy/phylink.c
index 0b618842d41d7..facd1e56acf12 100644
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -230,7 +230,7 @@ static unsigned int phylink_interface_signal_rate(phy_interface_t interface)
  *
  * Return: The maximum speed of @interface
  */
-static int phylink_interface_max_speed(phy_interface_t interface)
+int phylink_interface_max_speed(phy_interface_t interface)
 {
 	switch (interface) {
 	case PHY_INTERFACE_MODE_100BASEX:
@@ -298,6 +298,7 @@ static int phylink_interface_max_speed(phy_interface_t interface)
 	WARN_ON_ONCE(1);
 	return SPEED_UNKNOWN;
 }
+EXPORT_SYMBOL_GPL(phylink_interface_max_speed);
 
 static struct {
 	unsigned long mask;
