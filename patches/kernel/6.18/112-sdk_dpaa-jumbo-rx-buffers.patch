From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Fri, 13 Nov 2026 23:59:39 +0100
Subject: [PATCH] sdk_dpaa: keep a jumbo frame in one Rx buffer

NXP's 6.18 SDK dropped CONFIG_FSL_DPAA_ETH_JUMBO_FRAME: since Linux 6.18
(8218f62c9c9b, "mm: page_frag: use initial zero offset for
page_frag_alloc_align()") the page fragment cache fails any request larger
than a page, so netdev_alloc_frag() can no longer serve a 9.6K buffer.
Without the layout a jumbo frame arrives scattered over standard buffers,
which the offload paths that re-inject or transform a frame -- the SEC
output pool and the fragmenter are sized from the port buffers -- and 1.1.0's
jumbo support (MTU 9000 through hardware) do not take.

Restore the layout: the option, the 9.6K buffer size (a standard one under
erratum A050385), the frame-length truesize and the probe warning. Carve the
buffers from order-3 compound pages, three to a page, each holding one page
reference that the skb built on it drops when it is freed; a page the order
cannot be had at is replaced by one a single buffer fits in. Memory use is
what the fragment cache gave on 6.12.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 .../net/ethernet/freescale/sdk_dpaa/Kconfig   | 14 ++++
 .../ethernet/freescale/sdk_dpaa/dpaa_eth.c    |  9 ++
 .../ethernet/freescale/sdk_dpaa/dpaa_eth.h    | 17 +++-
 .../ethernet/freescale/sdk_dpaa/dpaa_eth_sg.c | 82 +++++++++++++++++++
 4 files changed, 121 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/freescale/sdk_dpaa/Kconfig b/drivers/net/ethernet/freescale/sdk_dpaa/Kconfig
index c133153b92a5c..9587b13e2b3dc 100644
--- a/drivers/net/ethernet/freescale/sdk_dpaa/Kconfig
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/Kconfig
@@ -68,6 +68,20 @@ config FSL_DPAA_ADVANCED_DRIVERS
 	  is needed to support advanced scenarios. Select this to also build the advanced
 	  drivers.
 
+config FSL_DPAA_ETH_JUMBO_FRAME
+	bool "Receive a jumbo frame into one buffer"
+	default n
+	help
+	  Size the Rx buffers for a whole 9.6K frame, so a jumbo frame is
+	  received into one buffer rather than scattered across several.
+	  The offload paths that re-inject or transform a frame (the SEC,
+	  the fragmenter, Wi-Fi) take it in one buffer.
+	  NOTE: This option can only be used if FSL_FM_MAX_FRAME_SIZE
+	  is set to 9600 bytes.
+	  The buffers are larger than a page and are carved from compound
+	  pages, three to an order-3 page; the skb truesize follows the
+	  frame length rather than the buffer size.
+
 config FSL_DPAA_TS
 	bool "Linux compliant timestamping"
 	depends on FSL_SDK_DPAA_ETH
diff --git a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
index 9f61e1ed56816..b1c9fb846841d 100644
--- a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
@@ -1111,6 +1111,15 @@ dpaa_eth_priv_probe(struct platform_device *_of_dev)
 	 */
 	dpa_bp->size = dpa_bp_size(&buf_layout[RX]);
 
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+	/* The jumbo buffer layout is only of use when the L2 maximum frame
+	 * size admits jumbo frames as well.
+	 */
+	if (fm_get_max_frm() < 9600)
+		dev_warn(dev,
+			"Invalid configuration: if jumbo frames support is on, FSL_FM_MAX_FRAME_SIZE should be set to 9600\n");
+#endif
+
 	INIT_LIST_HEAD(&priv->dpa_fq_list);
 
 	memset(&port_fqs, 0, sizeof(port_fqs));
diff --git a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.h b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.h
index 37585e72dc48b..6ef96e0b3200d 100644
--- a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.h
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.h
@@ -95,7 +95,22 @@ static inline void DPA_BUG_ON(bool cond)
  * the buffer size is increased from 2048 to 2176, to accommodate them in a
  * contiguous fd.
  */
-#define DPA_BP_RAW_SIZE		2176
+#define DPA_BP_RAW_SIZE_STD	2176
+#ifndef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+#define DPA_BP_RAW_SIZE		DPA_BP_RAW_SIZE_STD
+#else
+/* For jumbo frames, buffers large enough to hold a 9.6K frame, the FD's
+ * maximum offset, the skb shared info and some room for further alignment.
+ * With erratum A050385 a buffer must not cross a 4K boundary, so it stays
+ * a standard one, in a page of its own (_dpa_bp_add_8_bufs()).
+ */
+#define DPA_MAX_FRM_SIZE	9600
+#define DPA_BP_RAW_SIZE_JUMBO \
+	((DPA_MAX_FRM_SIZE + DPA_MAX_FD_OFFSET + \
+	  sizeof(struct skb_shared_info) + 128) & ~(SMP_CACHE_BYTES - 1))
+#define DPA_BP_RAW_SIZE ((unlikely(fm_has_errata_a050385())) ? \
+			 DPA_BP_RAW_SIZE_STD : DPA_BP_RAW_SIZE_JUMBO)
+#endif
 
 /* This is what FMan is ever allowed to use.
  * FMan-DMA requires 16-byte alignment for Rx buffers, but SKB_DATA_ALIGN is
diff --git a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_sg.c b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_sg.c
index 1ddf1c891ec46..60faf7ed7886a 100644
--- a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_sg.c
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_sg.c
@@ -267,6 +267,56 @@ int dpaa_bp_alloc_n_add_buffs(const struct dpa_bp *dpa_bp, uint32_t nbuffs, bool
 EXPORT_SYMBOL(dpaa_bp_alloc_n_add_buffs);
 
 
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+/* A jumbo Rx buffer is larger than a page, and the page fragment cache serves
+ * nothing larger than one: it fails such a request outright. The buffers are
+ * carved from compound pages here instead, as many to a page as fit, each
+ * holding one reference on its page, which the skb built on it drops when it
+ * is freed (skb_free_frag()). A page the order cannot be had at is replaced by
+ * one a single buffer fits in. One carve serves one _dpa_bp_add_8_bufs() call;
+ * the references of buffers it never handed out go with dpa_jumbo_end().
+ */
+#define DPA_JUMBO_PAGE_ORDER	3
+
+struct dpa_jumbo_carve {
+	struct page *page;
+	void *next;
+	unsigned int left;
+};
+
+static void *dpa_jumbo_buf(struct dpa_jumbo_carve *c, unsigned int size)
+{
+	unsigned int order = DPA_JUMBO_PAGE_ORDER;
+	void *buf;
+
+	if (!c->left) {
+		c->page = alloc_pages(GFP_ATOMIC | __GFP_COMP | __GFP_NOWARN, order);
+		if (!c->page) {
+			order = get_order(size);
+			c->page = alloc_pages(GFP_ATOMIC | __GFP_COMP | __GFP_NOWARN,
+					      order);
+			if (!c->page)
+				return NULL;
+		}
+		c->left = (PAGE_SIZE << order) / size;
+		page_ref_add(c->page, c->left - 1);
+		c->next = page_address(c->page);
+	}
+	buf = c->next;
+	c->next += size;
+	c->left--;
+	return buf;
+}
+
+static void dpa_jumbo_end(struct dpa_jumbo_carve *c)
+{
+	while (c->left) {
+		c->left--;
+		put_page(c->page);
+	}
+}
+#endif
+
 static int _dpa_bp_add_8_bufs(const struct dpa_bp *dpa_bp)
 {
 	void *new_buf, *fman_buf;
@@ -275,6 +325,9 @@ static int _dpa_bp_add_8_bufs(const struct dpa_bp *dpa_bp)
 	uint8_t i;
 	struct device *dev = dpa_bp->dev;
 	struct sk_buff *skb, **skbh;
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+	struct dpa_jumbo_carve carve = {};
+#endif
 
 	memset(bmb, 0, sizeof(struct bm_buffer) * 8);
 
@@ -296,6 +349,16 @@ static int _dpa_bp_add_8_bufs(const struct dpa_bp *dpa_bp)
 			}
 			new_buf = page_address(new_page);
 		} else {
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+			new_buf = dpa_jumbo_buf(&carve, SMP_CACHE_BYTES +
+						DPA_BP_RAW_SIZE_JUMBO);
+			if (unlikely(!new_buf)) {
+				dev_err_ratelimited(dev, "%s: jumbo buffer of %zu bytes failed\n",
+						    __func__, SMP_CACHE_BYTES +
+						    DPA_BP_RAW_SIZE_JUMBO);
+				goto err_release_previous_bufs;
+			}
+#else
 			new_buf = netdev_alloc_frag(SMP_CACHE_BYTES +
 						    DPA_BP_RAW_SIZE);
 			if (unlikely(!new_buf)) {
@@ -303,6 +366,7 @@ static int _dpa_bp_add_8_bufs(const struct dpa_bp *dpa_bp)
 						    __func__, SMP_CACHE_BYTES + DPA_BP_RAW_SIZE);
 				goto err_release_previous_bufs;
 			}
+#endif
 		}
 
 		new_buf = PTR_ALIGN(new_buf, SMP_CACHE_BYTES);
@@ -351,6 +415,9 @@ static int _dpa_bp_add_8_bufs(const struct dpa_bp *dpa_bp)
 	}
 
 release_bufs:
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+	dpa_jumbo_end(&carve);
+#endif
 	/* Release the buffers. In case bman is busy, keep trying
 	 * until successful. bman_release() is guaranteed to succeed
 	 * in a reasonable amount of time
@@ -369,6 +436,9 @@ static int _dpa_bp_add_8_bufs(const struct dpa_bp *dpa_bp)
 	if (likely(i))
 		goto release_bufs;
 
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+	dpa_jumbo_end(&carve);
+#endif
 	return 0;
 }
 
@@ -577,6 +647,18 @@ struct sk_buff *__hot contig_fd_to_skb(const struct dpa_priv_s *priv,
 	 * are added.
 	 */
 	DPA_READ_SKB_PTR(skb, skbh, vaddr, -1);
+
+#ifdef CONFIG_FSL_DPAA_ETH_JUMBO_FRAME
+	/* With jumbo Rx buffers, frames risk being dropped as the socket
+	 * backlog reaches its maximum allowed size. Use the frame length for
+	 * the skb truesize instead of the buffer size, as this is the size of
+	 * the data that actually gets copied to userspace. The stack may grow
+	 * the payload; it then warns that the frame is larger than its
+	 * truesize, which this accepts.
+	 */
+	skb->truesize = SKB_TRUESIZE(dpa_fd_length(fd));
+#endif
+
 	DPA_BUG_ON(fd_off != priv->rx_headroom);
 	skb_reserve(skb, fd_off);
 	skb_put(skb, dpa_fd_length(fd));
-- 
2.47.3

