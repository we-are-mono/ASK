From: Tomaz Zaman <tomaz@mono.si>
Subject: [PATCH] netfilter: trace why an offloaded conntrack loses its refresh

Diagnostic only, for the test image. A hardware-offloaded flow is retired
when its conntrack dies, and userspace sampling cannot show why: it observes
the state between transitions, and an offloaded conntrack prints fewer
columns than an ordinary one, so positional parsing silently reads the
wrong field.

Print at the three transitions instead. `flow_offload_teardown` reports the
timeout it installs once IPS_OFFLOAD is cleared and the gc_worker refresh
stops. The `nft_flow_offload` unwind reports the error that made it clear
IPS_OFFLOAD again, which distinguishes a readmission losing a race with an
unfinished retirement from every other failure. The conntrack collector
reports any conntrack reaped while it still carries IPS_HW_OFFLOAD, with
the raw status word.

Not for merge; drop once the retirement cause is settled.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
--- a/include/net/netfilter/nf_conntrack.h
+++ b/include/net/netfilter/nf_conntrack.h
@@ -374,6 +374,15 @@
  * us a check for the IPS_OFFLOAD_BIT from the packet path via
  * nf_ct_is_expired().
  */
+/* Diagnostic scope for the ASKDBG traces. Rate limiting decimated an earlier
+ * unscoped attempt badly enough that an absent line proved nothing, so narrow
+ * the trace to the churn proof's permanently-live UDP connections instead and
+ * print every one of their transitions. Those flows are never retired by the
+ * workload, so any line at all about them is the event under investigation.
+ */
+#define ASKDBG_FUSE_LIT(before, after)	((before) >= 1000 && (after) < 1000)
+#define ASKDBG_FUSE_CLEARED(before, after) ((before) < 1000 && (after) >= 1000)
+
 static inline void nf_ct_offload_timeout(struct nf_conn *ct)
 {
 	if (nf_ct_expires(ct) < NF_CT_DAY / 2)
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -350,7 +350,22 @@
 		return err;
 	}
 
-	nf_ct_offload_timeout(flow->ct);
+	{
+		/* Pair with the teardown trace: together they give a tuple's
+		 * whole timeout history, so a fuse that is never defused is
+		 * visible as a teardown with no admission after it.
+		 */
+		unsigned int was = nf_ct_expires(flow->ct);
+
+		nf_ct_offload_timeout(flow->ct);
+		if (ASKDBG_FUSE_CLEARED(jiffies_to_msecs(was) / 1000,
+					jiffies_to_msecs(nf_ct_expires(flow->ct)) / 1000))
+			pr_warn("ASKDBG admit proto=%u sport=%u status=%#lx expires %u -> %u\n",
+				    nf_ct_protonum(flow->ct),
+				    ntohs(flow->ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u.all),
+				    flow->ct->status, jiffies_to_msecs(was) / 1000,
+				    jiffies_to_msecs(nf_ct_expires(flow->ct)) / 1000);
+	}
 
 	if (nf_flowtable_hw_offload(flow_table)) {
 		__set_bit(NF_FLOW_HW, &flow->flags);
@@ -398,9 +413,29 @@
 
 void flow_offload_teardown(struct flow_offload *flow)
 {
+	struct nf_conn *ct = flow->ct;
+	unsigned int before = nf_ct_expires(ct);
+
 	clear_bit(IPS_OFFLOAD_BIT, &flow->ct->status);
 	set_bit(NF_FLOW_TEARDOWN, &flow->flags);
 	flow_offload_fixup_ct(flow->ct);
+	/* Clearing IPS_OFFLOAD also ends the gc_worker refresh, so the timeout
+	 * installed here is the whole remaining life of the conntrack. Print it
+	 * rather than reconstructing it from successive samples.
+	 */
+	/* Name the caller. The gc_step counters only attribute retirements the
+	 * collector itself decides on; the datapath hooks and the out-of-tree
+	 * flowtable context patch call this directly and would otherwise be
+	 * invisible, which is exactly the gap when a healthy flow is retired.
+	 */
+	if (ASKDBG_FUSE_LIT(jiffies_to_msecs(before) / 1000,
+			     jiffies_to_msecs(nf_ct_expires(ct)) / 1000))
+		pr_warn("ASKDBG teardown proto=%u sport=%u status=%#lx expires %u -> %u caller=%pS\n",
+			    nf_ct_protonum(ct),
+			    ntohs(ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u.all),
+			    ct->status, jiffies_to_msecs(before) / 1000,
+			    jiffies_to_msecs(nf_ct_expires(ct)) / 1000,
+			    __builtin_return_address(0));
 }
 EXPORT_SYMBOL_GPL(flow_offload_teardown);
 
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -1134,8 +1134,20 @@
 	struct flow_offload_work *offload;
 
 	offload = nf_flow_offload_work_alloc(flowtable, flow, FLOW_CLS_DESTROY);
-	if (!offload)
+	if (!offload) {
+		/* Retirement could not even be queued: NF_FLOW_HW_PENDING says
+		 * other offload work for this flow is still outstanding. The
+		 * hardware entry therefore stays installed and keeps
+		 * forwarding, so no packet reaches Linux to refresh the
+		 * conntrack that teardown just put on a short timeout.
+		 */
+		pr_warn("ASKDBG del_blocked proto=%u sport=%u flags=%#lx expires=%u\n",
+				    nf_ct_protonum(flow->ct),
+				    ntohs(flow->ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u.all),
+				    flow->flags,
+				    jiffies_to_msecs(nf_ct_expires(flow->ct)) / 1000);
 		return;
+	}
 
 	set_bit(NF_FLOW_HW_DYING, &flow->flags);
 	flow_offload_queue_work(offload);
--- a/net/netfilter/nf_conntrack_core.c
+++ b/net/netfilter/nf_conntrack_core.c
@@ -1535,6 +1535,17 @@
 			}
 
 			if (nf_ct_is_expired(tmp)) {
+				/* A conntrack that hardware ever forwarded must
+				 * not reach here while its flow is live. Print
+				 * the raw status word: which bits were set at
+				 * the moment of death is the whole question,
+				 * and decoded flags have misled this before.
+				 */
+				if (test_bit(IPS_HW_OFFLOAD_BIT, &tmp->status))
+					pr_warn("ASKDBG reap proto=%u sport=%u status=%#lx\n",
+							    nf_ct_protonum(tmp),
+							    ntohs(tmp->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u.all),
+							    tmp->status);
 				nf_ct_gc_expired(tmp);
 				expired_count++;
 				continue;
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -389,6 +389,14 @@
 	return;
 
 err_flow_add:
+	/* Readmission that loses a race with an unfinished retirement lands
+	 * here. The conntrack then carries neither IPS_OFFLOAD nor a refresh,
+	 * so record the reason rather than inferring it from a decay rate.
+	 */
+	pr_warn("ASKDBG add_fail ret=%d proto=%u sport=%u status=%#lx expires=%u\n",
+			    ret, nf_ct_protonum(ct),
+			    ntohs(ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u.all),
+			    ct->status, jiffies_to_msecs(nf_ct_expires(ct)) / 1000);
 	flow_offload_free(flow);
 err_flow_alloc:
 	dst_release(route.tuple[dir].dst);
