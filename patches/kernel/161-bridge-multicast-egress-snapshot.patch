From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Wed, 23 Sep 2026 18:49:36 +0200
Subject: [PATCH] bridge: snapshot multicast data egress ports for L3 offload

A routed hardware multicast entry bypasses br_dev_xmit() completely. Its
listener set must include the bridge's router ports as well as MDB members,
or downstream routers silently stop receiving. A PORT_MROUTER boolean is
insufficient to reconstruct this set: it combines IPv4 and IPv6, carries no
VLAN, and is not replayed to a newly registered observer.

Export a bounded, allocation-free snapshot under RTNL and multicast_lock.
Select the live VLAN multicast context and querier, source-specific MDB
entry, and protocol-specific router list. Merge by port, honour forwarding
state and VLAN egress membership, and refuse multicast-to-unicast and MST
shapes this port-only API cannot describe. Without snooping, flood as
br_flood() does: every port but proxy-ARP ones for data the host sends,
mcast_flood ports for data a port received. Return an error on overflow;
never expose a truncated set as a success. Borrowed devices remain valid
under the caller's RTNL; no cache or new lifetime is introduced.

A bridged hardware multicast entry needs the same answer for data received
on a bridge port. With an ingress port given, model br_handle_frame_finish()
and br_multicast_flood(): nothing is forwarded from an ingress that is not
forwarding in the VID, the bridge's own VLAN membership is not required,
the ingress is never selected, an isolated ingress reaches no isolated
port, a hairpin or locked ingress is refused, and the caller learns whether
the bridge also hands the data up -- the host joined the group, the bridge
is a multicast router for this family in the live context, nothing snoops
and the data floods, or the bridge device is promiscuous. Without one the
locally originated model is unchanged. Export the same context's group
membership interval, so state learned from the traffic can age on the
bridge's clock.

PORT_MROUTER is left as it is: one boolean for both families, sent only
when that union changes, which is what drivers count references by. A
caller that needs one family's router change while the other remains a
router re-reads the snapshot on its own schedule.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 include/linux/if_bridge.h |  26 ++++
 net/bridge/br_multicast.c | 260 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 286 insertions(+)

diff --git a/include/linux/if_bridge.h b/include/linux/if_bridge.h
index 13f4363917da..e4b0b8c51034 100644
--- a/include/linux/if_bridge.h
+++ b/include/linux/if_bridge.h
@@ -86,6 +86,13 @@ int unregister_brevent_notifier(struct notifier_block *nb);
 int call_brevent_notifiers(unsigned long val, void *v);
 #endif
 
+/* Why br_multicast_list_ports() says a bridge hands received data up to the
+ * host as well as forwarding it. */
+#define BR_MCAST_TO_HOST_JOINED	(1U << 0)	/* the host joined the group */
+#define BR_MCAST_TO_HOST_ROUTER	(1U << 1)	/* the bridge is a multicast router */
+#define BR_MCAST_TO_HOST_FLOOD	(1U << 2)	/* no snooping or querier: flooded */
+#define BR_MCAST_TO_HOST_PROMISC (1U << 3)	/* the bridge device is promiscuous */
+
 #if IS_ENABLED(CONFIG_BRIDGE) && IS_ENABLED(CONFIG_BRIDGE_IGMP_SNOOPING)
 int br_multicast_list_adjacent(struct net_device *dev,
 			       struct list_head *br_ip_list);
@@ -94,6 +101,11 @@ bool br_multicast_has_querier_adjacent(struct net_device *dev, int proto);
 bool br_multicast_has_router_adjacent(struct net_device *dev, int proto);
 bool br_multicast_enabled(const struct net_device *dev);
 bool br_multicast_router(const struct net_device *dev);
+int br_multicast_list_ports(struct net_device *dev, const struct br_ip *group,
+			    struct net_device *in_dev, unsigned int *local,
+			    struct net_device **ports, unsigned int max);
+unsigned long br_multicast_membership_interval(const struct net_device *dev,
+					       u16 vid);
 #else
 static inline int br_multicast_list_adjacent(struct net_device *dev,
 					     struct list_head *br_ip_list)
@@ -121,6 +133,20 @@ static inline bool br_multicast_enabled(const struct net_device *dev)
 {
 	return false;
 }
+static inline int br_multicast_list_ports(struct net_device *dev,
+					  const struct br_ip *group,
+					  struct net_device *in_dev,
+					  unsigned int *local,
+					  struct net_device **ports,
+					  unsigned int max)
+{
+	return -EOPNOTSUPP;
+}
+static inline unsigned long
+br_multicast_membership_interval(const struct net_device *dev, u16 vid)
+{
+	return 0;
+}
 static inline bool br_multicast_router(const struct net_device *dev)
 {
 	return false;
diff --git a/net/bridge/br_multicast.c b/net/bridge/br_multicast.c
index d43b39ed61c7..fa0b639f97d5 100644
--- a/net/bridge/br_multicast.c
+++ b/net/bridge/br_multicast.c
@@ -5071,6 +5071,266 @@ bool br_multicast_has_router_adjacent(struct net_device *dev, int proto)
 }
 EXPORT_SYMBOL_GPL(br_multicast_has_router_adjacent);
 
+/**
+ * br_multicast_list_ports - snapshot multicast data egress
+ * @dev: bridge device
+ * @group: exact source, non-link-local IPv4/IPv6 group and resolved ingress VID
+ * @in_dev: the bridge port the data arrives on, or NULL for data the host
+ *	    sends through the bridge device
+ * @local: when non-NULL, set to BR_MCAST_TO_HOST_* flags saying whether and
+ *	   why the bridge also hands data received on @in_dev to the host
+ * @ports: output array, borrowed until the caller releases RTNL
+ * @max: number of entries available in @ports
+ *
+ * With no @in_dev, models br_dev_xmit() for multicast data, not IGMP/MLD
+ * control messages. With one, models br_handle_frame_finish() and
+ * br_multicast_flood() for such data received on @in_dev: an ingress not
+ * forwarding in the VID forwards nothing, the ingress port is never an egress
+ * one, an isolated ingress reaches no isolated port, and a hairpin ingress --
+ * which would receive its own data back -- or a locked one is refused.
+ * Returns the complete port count, or a negative error (discard the array
+ * and @local). The caller supplies the VID after bridge ingress/PVID
+ * resolution and must reproduce each port's egress tags separately. No device
+ * references are taken.
+ */
+int br_multicast_list_ports(struct net_device *dev, const struct br_ip *group,
+			    struct net_device *in_dev, unsigned int *local,
+			    struct net_device **ports, unsigned int max)
+{
+	struct net_bridge_mdb_entry *mdb = NULL;
+	struct net_bridge_port *p, *in = NULL;
+	struct net_bridge_port_group *pg;
+	struct net_bridge_mcast_port *pmctx;
+	struct net_bridge_mcast *brmctx;
+	struct net_bridge_vlan *v;
+	struct net_bridge *br;
+	struct hlist_head *routers;
+	struct hlist_node *node;
+	struct ethhdr eth = { .h_proto = group->proto };
+	struct br_ip key = *group;
+	bool snoop, include, router_ctx;
+	int n = 0;
+
+	ASSERT_RTNL();
+	if (local)
+		*local = 0;
+	if (!netif_is_bridge_master(dev) ||
+	    (group->proto != htons(ETH_P_IP) &&
+	     group->proto != htons(ETH_P_IPV6)))
+		return -EOPNOTSUPP;
+	br = netdev_priv(dev);
+	if (in_dev) {
+		in = br_port_get_rtnl(in_dev);
+		if (!in || in->br != br)
+			return -EINVAL;
+		/* Hairpin returns data to its sender, and a locked port admits
+		 * only sources its FDB already knows: neither is a port set. */
+		if (in->flags & (BR_HAIRPIN_MODE | BR_PORT_LOCKED))
+			return -EOPNOTSUPP;
+	}
+	if (!netif_running(dev))
+		return 0;
+	rcu_read_lock();
+	spin_lock_bh(&br->multicast_lock);
+	brmctx = &br->multicast_ctx;
+	if (br_opt_get(br, BROPT_VLAN_ENABLED)) {
+		v = br_vlan_find(br_vlan_group_rcu(br), group->vid);
+		/* br_dev_xmit() sends only in a VLAN the bridge itself is a
+		 * member of; a port's data needs no bridge membership, and the
+		 * bridge's context entry exists while any port has the VLAN. */
+		if (!v || (!in && (!br_vlan_should_use(v) ||
+				   !br_vlan_state_allowed(br_vlan_get_state(v),
+							  false))))
+			goto out;
+		if (br_opt_get(br, BROPT_MCAST_VLAN_SNOOPING_ENABLED))
+			brmctx = &v->br_mcast_ctx;
+	}
+	if (in) {
+		u8 state = in->state;
+
+		if (br_mst_is_enabled(in)) {
+			n = -EOPNOTSUPP;
+			goto out;
+		}
+		/* br_handle_frame_finish(): the ingress port and its VLAN must
+		 * both be forwarding, or the frame is dropped -- a learning
+		 * port learns its source and forwards nothing. */
+		if (br_opt_get(br, BROPT_VLAN_ENABLED)) {
+			struct net_bridge_vlan *iv;
+
+			iv = br_vlan_find(nbp_vlan_group_rcu(in), group->vid);
+			if (!iv || !br_vlan_should_use(iv))
+				goto out;
+			if (state == BR_STATE_FORWARDING)
+				state = br_vlan_get_state(iv);
+		}
+		if (state != BR_STATE_FORWARDING)
+			goto out;
+	}
+	snoop = br_opt_get(br, BROPT_MULTICAST_ENABLED) &&
+		!br_multicast_ctx_vlan_global_disabled(brmctx) &&
+		br_multicast_querier_exists(brmctx, &eth, NULL);
+	include = br_multicast_should_handle_mode(brmctx, group->proto);
+	if (snoop) {
+		if (include)
+			mdb = br_mdb_ip_get(br, &key);
+		if (!mdb) {
+			memset(&key.src, 0, sizeof(key.src));
+			mdb = br_mdb_ip_get(br, &key);
+		}
+	}
+	/* What br_handle_frame_finish() hands up besides forwarding: with no
+	 * snooping or no querier the frame floods and goes up too; otherwise
+	 * it goes up when the host joined it or the bridge is a multicast
+	 * router for this family, as br_multicast_is_router() asks per frame. */
+	switch (brmctx->multicast_router) {
+	case MDB_RTR_TYPE_PERM:
+		router_ctx = true;
+		break;
+	case MDB_RTR_TYPE_TEMP_QUERY:
+		router_ctx = group->proto == htons(ETH_P_IPV6) ?
+			     br_ip6_multicast_is_router(brmctx) :
+			     br_ip4_multicast_is_router(brmctx);
+		break;
+	default:
+		router_ctx = false;
+		break;
+	}
+	if (local) {
+		if (!snoop)
+			*local |= BR_MCAST_TO_HOST_FLOOD;
+		if (snoop && mdb && mdb->host_joined)
+			*local |= BR_MCAST_TO_HOST_JOINED;
+		if (snoop && router_ctx)
+			*local |= BR_MCAST_TO_HOST_ROUTER;
+		/* A promiscuous bridge -- an upper device with an address of
+		 * its own makes it one, as it has no unicast filter -- hands
+		 * everything up. */
+		if (br->dev->flags & IFF_PROMISC)
+			*local |= BR_MCAST_TO_HOST_PROMISC;
+	}
+	routers = &brmctx->ip4_mc_router_list;
+#if IS_ENABLED(CONFIG_IPV6)
+	if (group->proto == htons(ETH_P_IPV6))
+		routers = &brmctx->ip6_mc_router_list;
+#else
+	if (group->proto == htons(ETH_P_IPV6)) {
+		n = -EOPNOTSUPP;
+		goto out;
+	}
+#endif
+	list_for_each_entry(p, &br->port_list, list) {
+		bool router = false, member = false;
+
+		/* MST needs a per-VLAN forwarding-state contract. */
+		if (br_mst_is_enabled(p)) {
+			n = -EOPNOTSUPP;
+			goto out;
+		}
+		if (p->state != BR_STATE_FORWARDING)
+			continue;
+		/* should_deliver(): never back out of the ingress, and no
+		 * isolated port from an isolated one. */
+		if (p == in ||
+		    (in && (in->flags & BR_ISOLATED) && (p->flags & BR_ISOLATED)))
+			continue;
+		if (br_opt_get(br, BROPT_VLAN_ENABLED)) {
+			v = br_vlan_find(nbp_vlan_group_rcu(p), group->vid);
+			if (!v || !br_vlan_should_use(v) ||
+			    !br_vlan_state_allowed(br_vlan_get_state(v), false))
+				continue;
+		}
+		if (!snoop) {
+			/* br_flood(): a port's mcast_flood filters what other
+			 * ports send it, not what the host does, and a proxy-ARP
+			 * port is flooded nothing. */
+			member = !(p->flags & BR_PROXYARP) &&
+				 (!in || (p->flags & BR_MCAST_FLOOD));
+		} else {
+			hlist_for_each(node, routers) {
+#if IS_ENABLED(CONFIG_IPV6)
+				if (group->proto == htons(ETH_P_IPV6))
+					pmctx = hlist_entry(node,
+						struct net_bridge_mcast_port, ip6_rlist);
+				else
+#endif
+					pmctx = hlist_entry(node,
+						struct net_bridge_mcast_port, ip4_rlist);
+				if (pmctx->port == p) {
+					router = true;
+					break;
+				}
+			}
+			for (pg = mdb ? mlock_dereference(mdb->ports, br) : NULL;
+			     pg; pg = mlock_dereference(pg->next, br)) {
+				if (pg->key.port != p)
+					continue;
+				/* A router receives once even if its MDB membership
+				 * blocks this source or requests unicast conversion. */
+				if (router)
+					break;
+				if (p->flags & BR_MULTICAST_TO_UNICAST) {
+					n = -EOPNOTSUPP;
+					goto out;
+				}
+				if (!(pg->flags & MDB_PG_FLAGS_BLOCKED) &&
+				    !(include && br_multicast_is_star_g(&mdb->addr) &&
+				      pg->filter_mode == MCAST_INCLUDE))
+					member = true;
+			}
+		}
+		if (!router && !member)
+			continue;
+		if (n == max) {
+			n = -E2BIG;
+			goto out;
+		}
+		ports[n++] = p->dev;
+	}
+out:
+	spin_unlock_bh(&br->multicast_lock);
+	rcu_read_unlock();
+	return n;
+}
+EXPORT_SYMBOL_GPL(br_multicast_list_ports);
+
+/**
+ * br_multicast_membership_interval - how long a membership outlives its reports
+ * @dev: bridge device
+ * @vid: the VID whose multicast context to read, selected as
+ *	 br_multicast_list_ports() selects it
+ *
+ * The group membership interval the bridge ages port groups and sources by,
+ * in jiffies, so a caller holding state learned from the same traffic can age
+ * it on the bridge's clock. Returns 0 if @dev is not a bridge. Caller holds
+ * RTNL.
+ */
+unsigned long br_multicast_membership_interval(const struct net_device *dev,
+					       u16 vid)
+{
+	const struct net_bridge_mcast *brmctx;
+	struct net_bridge_vlan *v;
+	struct net_bridge *br;
+	unsigned long interval;
+
+	ASSERT_RTNL();
+	if (!netif_is_bridge_master(dev))
+		return 0;
+	br = netdev_priv(dev);
+	rcu_read_lock();
+	brmctx = &br->multicast_ctx;
+	if (br_opt_get(br, BROPT_VLAN_ENABLED) &&
+	    br_opt_get(br, BROPT_MCAST_VLAN_SNOOPING_ENABLED)) {
+		v = br_vlan_find(br_vlan_group_rcu(br), vid);
+		if (v)
+			brmctx = &v->br_mcast_ctx;
+	}
+	interval = br_multicast_gmi(brmctx);
+	rcu_read_unlock();
+	return interval;
+}
+EXPORT_SYMBOL_GPL(br_multicast_membership_interval);
+
 static void br_mcast_stats_add(struct bridge_mcast_stats __percpu *stats,
 			       const struct sk_buff *skb, u8 type, u8 dir)
 {
-- 
