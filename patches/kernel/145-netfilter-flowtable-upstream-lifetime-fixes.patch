From b3d8980199f4aaa27ade95e754b6484092b45a3e Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Wed, 23 Sep 2026 16:01:43 +0200
Subject: [PATCH] netfilter: flowtable: backport two upstream flow lifetime
 fixes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Backport of upstream commits:

2014ac62df9d ("netfilter: flowtable: publish GC-visible tuple last")
  Jérémy Jean: nf_flow_table_iterate() treats only original-direction
  tuple nodes as owning entries. flow_offload_add() published the
  original node first, so GC could observe and free a flow while the
  reply node was still being inserted (KASAN use-after-free in the
  rhashtable path). Publish the reply node first, the original last.

e75a9fa1d44b ("netfilter: flowtable: hold reference on ct until flow is released")
  Pablo Neira Ayuso: nf_ct_put() releases ct->ext at once, while the
  datapath may still reach the conntrack through the flow until the
  RCU grace period ends. Put the conntrack from the RCU callback that
  frees the flow, and wait for pending callbacks on module exit.

Both sit in nf_flow_table_core.c beside patches 141-144; the hardware
handle is still invalidated synchronously in flow_offload_free().
---
 net/netfilter/nf_flow_table_core.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/net/netfilter/nf_flow_table_core.c b/net/netfilter/nf_flow_table_core.c
index e43ee1b1bd95..d8463649721b 100644
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -264,6 +264,14 @@ static void flow_offload_route_release(struct flow_offload *flow)
 	nft_flow_dst_release(flow, FLOW_OFFLOAD_DIR_REPLY);
 }
 
+static void flow_offload_free_rcu(struct rcu_head *rcu_head)
+{
+	struct flow_offload *flow = container_of(rcu_head, struct flow_offload, rcu_head);
+
+	nf_ct_put(flow->ct);
+	kfree(flow);
+}
+
 void flow_offload_free(struct flow_offload *flow)
 {
 	nf_flow_offload_handle_invalidate(flow->hw_handle);
@@ -275,8 +283,7 @@ void flow_offload_free(struct flow_offload *flow)
 	default:
 		break;
 	}
-	nf_ct_put(flow->ct);
-	kfree_rcu(flow, rcu_head);
+	call_rcu(&flow->rcu_head, flow_offload_free_rcu);
 }
 EXPORT_SYMBOL_GPL(flow_offload_free);
 
@@ -345,17 +352,18 @@ int flow_offload_add(struct nf_flowtable *flow_table, struct flow_offload *flow)
 	flow->timeout = nf_flowtable_time_stamp + flow_offload_get_timeout(flow);
 
 	err = rhashtable_insert_fast(&flow_table->rhashtable,
-				     &flow->tuplehash[0].node,
+				     &flow->tuplehash[FLOW_OFFLOAD_DIR_REPLY].node,
 				     nf_flow_offload_rhash_params);
 	if (err < 0)
 		return err;
 
+	/* GC only iterates original-direction entries; publish original last. */
 	err = rhashtable_insert_fast(&flow_table->rhashtable,
-				     &flow->tuplehash[1].node,
+				     &flow->tuplehash[FLOW_OFFLOAD_DIR_ORIGINAL].node,
 				     nf_flow_offload_rhash_params);
 	if (err < 0) {
 		rhashtable_remove_fast(&flow_table->rhashtable,
-				       &flow->tuplehash[0].node,
+				       &flow->tuplehash[FLOW_OFFLOAD_DIR_REPLY].node,
 				       nf_flow_offload_rhash_params);
 		return err;
 	}
@@ -890,6 +898,7 @@ static int __init nf_flow_table_module_init(void)
 
 static void __exit nf_flow_table_module_exit(void)
 {
+	rcu_barrier();
 	nf_flow_table_offload_exit();
 	unregister_pernet_subsys(&nf_flow_table_net_ops);
 }
