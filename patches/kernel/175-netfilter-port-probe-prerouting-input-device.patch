From d440d1630e81c8eaf3eaee5a5e71a7f4e9bfe6e7 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Sat, 17 Oct 2026 03:12:38 +0200
Subject: [PATCH] netfilter: port probe: let prerouting see its own input
 device

br_netfilter runs prerouting for a frame its bridge hands up to the
host, with the bridge as the input device (or, with
bridge-nf-pass-vlan-input-dev, the bridge's VLAN device for a tagged
frame), and ip_sabotage_in() then skips prerouting on the device above
the bridge that receives the frame. A routed multicast group whose
parent VIF is a VLAN device on such a bridge therefore meets prerouting
with the bridge as its input and forward with the VIF: an offload asking
nft_port_dependent() or nf_xt_port_dependent() about it with one input
device for both walks a path Linux never takes, and a prerouting mark
keyed on the bridge that a forward rule then splits the group's ports
on goes unseen.

Give the probe an optional prerouting input device, used by the
nftables walk and both x_tables walks at prerouting alone.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 include/net/netfilter/nf_port_probe.h | 5 +++++
 net/ipv4/netfilter/ip_tables.c        | 4 +++-
 net/ipv6/netfilter/ip6_tables.c       | 5 +++--
 net/netfilter/nf_tables_port_probe.c  | 2 +-
 4 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/include/net/netfilter/nf_port_probe.h b/include/net/netfilter/nf_port_probe.h
index f92634115dab..7ce4625efe12 100644
--- a/include/net/netfilter/nf_port_probe.h
+++ b/include/net/netfilter/nf_port_probe.h
@@ -14,6 +14,10 @@ struct net_device;
  * @saddr: the stream's source address
  * @daddr: the stream's destination address
  * @in: the device the stream arrives on
+ * @pre_in: the device prerouting sees it arrive on, when not @in: br_netfilter
+ *	runs prerouting for a frame its bridge hands up with the bridge as the
+ *	input, and the receive path then skips it on the device above that @in
+ *	is, a VLAN device on the bridge; NULL for @in
  * @out: the devices copies of it leave through
  * @nout: how many entries @out has
  * @bridged: a bridge forwards it, not the IP stack
@@ -52,6 +56,7 @@ struct nft_port_probe {
 	union nf_inet_addr		saddr;
 	union nf_inet_addr		daddr;
 	const struct net_device		*in;
+	const struct net_device		*pre_in;
 	const struct net_device * const	*out;
 	unsigned int			nout;
 	bool				bridged;
diff --git a/net/ipv4/netfilter/ip_tables.c b/net/ipv4/netfilter/ip_tables.c
index 32ee2bdf7c94..3a1bac1db1b3 100644
--- a/net/ipv4/netfilter/ip_tables.c
+++ b/net/ipv4/netfilter/ip_tables.c
@@ -557,7 +557,9 @@ static int ipt_probe_table(struct ipt_probe *p,
 	unsigned int addend;
 	int ret = 0;
 
-	p->indev = p->hook == NF_INET_POST_ROUTING ? nulldevname : probe->in->name;
+	p->indev = p->hook == NF_INET_POST_ROUTING ? nulldevname :
+		   p->hook == NF_INET_PRE_ROUTING && probe->pre_in ? probe->pre_in->name :
+		   probe->in->name;
 	for (i = 0; i < outputs && !ret; i++) {
 		p->outdev = p->hook == NF_INET_PRE_ROUTING ?
 			    nulldevname : probe->out[i]->name;
diff --git a/net/ipv6/netfilter/ip6_tables.c b/net/ipv6/netfilter/ip6_tables.c
index b2489b95b17b..652422307699 100644
--- a/net/ipv6/netfilter/ip6_tables.c
+++ b/net/ipv6/netfilter/ip6_tables.c
@@ -620,8 +620,9 @@ static int ip6t_probe_table(struct ip6t_probe *p,
 	for (i = 0; i < outputs && !ret; i++) {
 		p->outdev = p->hook == NF_INET_PRE_ROUTING ?
 			    nulldevname : probe->out[i]->name;
-		p->indev = p->hook == NF_INET_POST_ROUTING ?
-			   p->outdev : probe->in->name;
+		p->indev = p->hook == NF_INET_POST_ROUTING ? p->outdev :
+			   p->hook == NF_INET_PRE_ROUTING && probe->pre_in ?
+			   probe->pre_in->name : probe->in->name;
 		p->visits = IP6T_PROBE_VISITS;
 		local_bh_disable();
 		addend = xt_write_recseq_begin();
diff --git a/net/netfilter/nf_tables_port_probe.c b/net/netfilter/nf_tables_port_probe.c
index a28859d6f108..fe25edc56491 100644
--- a/net/netfilter/nf_tables_port_probe.c
+++ b/net/netfilter/nf_tables_port_probe.c
@@ -2179,7 +2179,7 @@ static u32 nft_probe_packet(struct nft_probe_ctx *ctx, u32 ctmark)
 	if (ctx->stop)
 		return ctmark;
 	if (!p->bridged) {
-		nft_probe_hook(ctx, NFT_PROBE_PRE, p->in, NULL, 0);
+		nft_probe_hook(ctx, NFT_PROBE_PRE, p->pre_in ?: p->in, NULL, 0);
 		if (ctx->stop)
 			return ctmark;
 	}
-- 
