diff --git a/net/xfrm/xfrm_device.c b/net/xfrm/xfrm_device.c
index 7744ed8e4c83..f2a7fa2704a4 100644
--- a/net/xfrm/xfrm_device.c
+++ b/net/xfrm/xfrm_device.c
@@ -122,6 +122,30 @@ struct sk_buff *validate_xmit_xfrm(struct sk_buff *skb, netdev_features_t featur
 	struct net_device *dev = skb->dev;
 	struct sec_path *sp;
 
+#if defined(CONFIG_INET_IPSEC_OFFLOAD) || defined(CONFIG_INET6_IPSEC_OFFLOAD)
+	/* A frame for a packet-offloaded SA carries its state without olen
+	 * (see xfrm_output()), so xo is NULL for it and the wrong-device
+	 * check below never sees it. It is still plaintext, and only the
+	 * SA's own device hands it to SEC: sent anywhere else it would leave
+	 * in the clear. xfrm_output() refuses a bundle routed elsewhere; this
+	 * catches a frame moved after that, by a hook, a qdisc action or a
+	 * device it was handed on to.
+	 */
+	if (skb->ipsec_offload && !xo) {
+		sp = skb_sec_path(skb);
+		x = sp && sp->len ? sp->xvec[sp->len - 1] : NULL;
+		if (x && x->xso.type == XFRM_DEV_OFFLOAD_PACKET &&
+		    x->xso.dir == XFRM_DEV_OFFLOAD_OUT &&
+		    READ_ONCE(x->xso.dev) != dev) {
+			XFRM_INC_STATS(dev_net(dev),
+				       LINUX_MIB_XFRMOUTBUNDLECHECKERROR);
+			dev_core_stats_tx_dropped_inc(dev);
+			kfree_skb_list(skb);
+			return NULL;
+		}
+	}
+#endif
+
 	if (!xo || (xo->flags & XFRM_XMIT))
 		return skb;
 
diff --git a/net/xfrm/xfrm_input.c b/net/xfrm/xfrm_input.c
index 5d3633ce6ba3..d0e39279123c 100644
--- a/net/xfrm/xfrm_input.c
+++ b/net/xfrm/xfrm_input.c
@@ -44,6 +44,27 @@ struct xfrm_trans_cb {
 
 #define XFRM_TRANS_SKB_CB(__skb) ((struct xfrm_trans_cb *)&((__skb)->cb[0]))
 
+#if defined(CONFIG_INET_IPSEC_OFFLOAD) || defined(CONFIG_INET6_IPSEC_OFFLOAD)
+extern int dpaa_submit_inb_pkt_to_SEC(struct sk_buff *skb,
+				      const struct xfrm_state *x);
+
+/*
+ * Whether @x is received through SEC and nothing else: a packet-offloaded
+ * state the DPAA offload module took, the one driver that gives a state a
+ * handle (from xdo_dev_state_add(), before the state is inserted). SEC keeps
+ * such a state's anti-replay window. xfrm's own is a copy the driver
+ * refreshes now and then, and nothing tells SEC what software accepted, so
+ * decrypting a frame here would check it against a second window, each
+ * accepting what the other had already seen. What SEC is not given is
+ * dropped instead. A state another driver offloads has no handle and is
+ * received as upstream receives it.
+ */
+static bool xfrm_state_sec_only(const struct xfrm_state *x)
+{
+	return x->xso.type == XFRM_DEV_OFFLOAD_PACKET && x->handle;
+}
+#endif /* IPSEC */
+
