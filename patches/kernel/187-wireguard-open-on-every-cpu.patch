From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Mon, 9 Nov 2026 12:00:00 +0100
Subject: [PATCH] wireguard: open one tunnel's packets on every CPU at once

A receive path that spreads one tunnel's packets over every CPU (QMan
dequeuing in parallel and restoring the order on the way out) breaks
two assumptions of the fast path: that one CPU receives a peer, and
that one CPU opens its packets at a time.

- wg_fastpath_rx_everywhere(): every CPU receives, as
  wg_fastpath_rx_inline() was told; the seal no longer refuses the CPU
  a peer was last received on, which would bounce its flows for nothing.
- wg_fastpath_open()'s timer pacing takes its turn by cmpxchg, so one
  CPU runs the timers and rekey test per turn.
---
--- a/drivers/net/wireguard/fastpath.c
+++ b/drivers/net/wireguard/fastpath.c
@@ -203,9 +203,10 @@
 	if (!peer)
 		return -ENOKEY;
 	/* The CPU that receives this peer's packets also carries every ACK of
-	 * the flows sealed here; sealing beside them starves both. */
+	 * the flows sealed here; sealing beside them starves both. Unless every
+	 * CPU receives, when there is no elsewhere to seal. */
 	if (READ_ONCE(peer->fp_rx_cpu) == raw_smp_processor_id() &&
-	    num_online_cpus() > 1) {
+	    num_online_cpus() > 1 && !wg_fastpath_rx_everywhere()) {
 		wg_peer_put(peer);
 		return -EXDEV;
 	}
@@ -290,6 +291,7 @@
 	struct noise_keypair *kp;
 	struct endpoint ep;
 	const void *saddr;
+	unsigned long t;
 	int ret = WG_FP_PASS;
 	u8 *ip, version;
 	u64 nonce;
@@ -346,9 +348,11 @@
 	}
 
 	/* wg_packet_consume_data_done()'s timers and rekey test, a few times a
-	 * second rather than per packet, as the seal path paces its own. */
-	if (time_after(jiffies, READ_ONCE(peer->fp_rx_timers))) {
-		WRITE_ONCE(peer->fp_rx_timers, jiffies + HZ / 50);
+	 * second rather than per packet, as the seal path paces its own; one
+	 * CPU takes each turn, as a peer's packets are opened on several. */
+	t = READ_ONCE(peer->fp_rx_timers);
+	if (time_after(jiffies, t) &&
+	    cmpxchg(&peer->fp_rx_timers, t, jiffies + HZ / 50) == t) {
 		wg_fastpath_keep_key_fresh(peer);
 		wg_timers_any_authenticated_packet_received(peer);
 		wg_timers_any_authenticated_packet_traversal(peer);
--- a/drivers/net/wireguard/queueing.h
+++ b/drivers/net/wireguard/queueing.h
@@ -34,6 +34,7 @@
 int wg_packet_rx_poll(struct napi_struct *napi, int budget);
 bool wg_fastpath_counter_ok(struct noise_keypair *keypair, u64 nonce);
 void wg_fastpath_keep_key_fresh(struct wg_peer *peer);
+bool wg_fastpath_rx_everywhere(void);
 /* Workqueue worker: */
 void wg_packet_decrypt_worker(struct work_struct *work);
 
--- a/drivers/net/wireguard/receive.c
+++ b/drivers/net/wireguard/receive.c
@@ -40,6 +40,12 @@
 }
 EXPORT_SYMBOL_GPL(wg_fastpath_rx_inline);
 
+/* Whether every CPU receives tunnels, as wg_fastpath_rx_inline() was told. */
+bool wg_fastpath_rx_everywhere(void)
+{
+	return READ_ONCE(wg_rx_inline_max) == U16_MAX;
+}
+
 static size_t validate_header_len(struct sk_buff *skb)
 {
 	if (unlikely(skb->len < sizeof(struct message_header)))
