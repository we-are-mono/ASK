From 66e0a7e5260a1e334cf73c8bacc6ac56c8c573e5 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Sun, 9 Aug 2026 03:42:47 +0200
Subject: [PATCH] ask: PPP/PPPoE fast-path hooks

Extends drivers/net/ppp/ppp_generic.c and pppoe.c with hook points for
PPPoE session offload (session create/destroy notifications, per-session
data carrying offload state).

The connect-channel NEWLINK notification is sent after all_ppp_mutex is
released (device held across the gap): taking rtnl_lock under
all_ppp_mutex inverts against ppp_nl_newlink's rtnl->all_ppp order and
lockdep flags it on the first PPPIOCNEWUNIT. The notification is also
now skipped when the connect fails, instead of announcing a link that
did not change.

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
 drivers/net/ppp/ppp_generic.c | 22 ++++++++++++++++++++++
 drivers/net/ppp/pppoe.c       | 15 +++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/drivers/net/ppp/ppp_generic.c b/drivers/net/ppp/ppp_generic.c
index 5d6d69632c84..cf1ebc51781e 100644
--- a/drivers/net/ppp/ppp_generic.c
+++ b/drivers/net/ppp/ppp_generic.c
@@ -3498,6 +3498,9 @@ ppp_connect_channel(struct channel *pch, int unit)
 	struct ppp_net *pn;
 	int ret = -ENXIO;
 	int hdrlen;
+#if defined(CONFIG_CPE_FAST_PATH)
+	struct net_device *dev = NULL;
+#endif
 
 	pn = ppp_pernet(pch->chan_net);
 
@@ -3539,8 +3542,27 @@ ppp_connect_channel(struct channel *pch, int unit)
 
  outl:
 	write_unlock_bh(&pch->upl);
+#if defined(CONFIG_CPE_FAST_PATH)
+	/* Only take a device reference here; the NEWLINK notification is
+	 * sent after all_ppp_mutex is dropped. Taking rtnl_lock while
+	 * holding all_ppp_mutex would invert against ppp_nl_newlink,
+	 * which takes them in the opposite order. */
+	if (!ret && ppp->dev && !ppp->closing) {
+		dev = ppp->dev;
+		dev_hold(dev);
+	}
+#endif
+
  out:
 	mutex_unlock(&pn->all_ppp_mutex);
+#if defined(CONFIG_CPE_FAST_PATH)
+	if (dev) {
+		rtnl_lock();
+		rtmsg_ifinfo(RTM_NEWLINK, dev, 0, GFP_KERNEL, 0, NULL);
+		rtnl_unlock();
+		dev_put(dev);
+	}
+#endif
 	return ret;
 }
 
diff --git a/drivers/net/ppp/pppoe.c b/drivers/net/ppp/pppoe.c
index 8ff2024dde60..05b0883b2c4a 100644
--- a/drivers/net/ppp/pppoe.c
+++ b/drivers/net/ppp/pppoe.c
@@ -1038,17 +1038,32 @@ static int pppoe_seq_show(struct seq_file *seq, void *v)
 {
 	struct pppox_sock *po;
 	char *dev_name;
+#if defined(CONFIG_CPE_FAST_PATH)
+	char *ppp_name;
+#endif
 
 	if (v == SEQ_START_TOKEN) {
+#if defined(CONFIG_CPE_FAST_PATH)
+		seq_puts(seq, "Id   Address           Device     PPPDevice  Unit\n");
+#else
 		seq_puts(seq, "Id       Address              Device\n");
+#endif
 		goto out;
 	}
 
 	po = v;
 	dev_name = po->pppoe_pa.dev;
+#if defined(CONFIG_CPE_FAST_PATH)
+	ppp_name = ppp_dev_name(&po->chan);
+	if (!ppp_name)
+		goto out;
 
+	seq_printf(seq, "%04X %pM %-10s %-10s %d\n",
+	ntohs(po->pppoe_pa.sid), po->pppoe_pa.remote, dev_name, ppp_name, ppp_unit_number(&po->chan));
+#else
 	seq_printf(seq, "%08X %pM %8s\n",
 		po->pppoe_pa.sid, po->pppoe_pa.remote, dev_name);
+#endif
 out:
 	return 0;
 }
