index 000000000000..5730c3cad4aa
--- /dev/null
+++ b/include/net/wg_fastpath.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NET_WG_FASTPATH_H
+#define _NET_WG_FASTPATH_H
+
+#include <linux/netdevice.h>
+
+/* Where wg_fastpath_seal() left a sealed frame: the device to transmit it on
+ * and its new offset and length in the same buffer. */
+struct wg_fastpath_tx {
+	struct net_device *dev;
+	unsigned int off, len;
+	/* The outer IPv4/UDP pair the frame was sealed with: the peer's
+	 * packets come back on its reverse. */
+	__be32 saddr, daddr;
+	__be16 sport, dport;
+};
+
+/* Whether the caller can transmit a sealed frame on @dev; called in softirq. */
+typedef bool (*wg_fastpath_can_tx_t)(const struct net_device *dev);
+
+int wg_fastpath_seal(struct net_device *wg_dev, wg_fastpath_can_tx_t can_tx,
+		     u8 *buf, unsigned int off, unsigned int len, unsigned int size,
+		     struct wg_fastpath_tx *tx);
+
+/* Hand @wg_dev an outer IPv4/UDP datagram addressed to its listen port, as
+ * its socket would: protocol, network and transport headers and skb_iif set,
+ * IP header and UDP checksum already validated. Consumes @skb. The caller
+ * holds rcu_read_lock() and keeps @wg_dev registered across the call. */
+void wg_fastpath_receive(struct net_device *wg_dev, struct sk_buff *skb);
+
+/* Decrypt every data message on the receiving CPU (true) or only small ones. */
+void wg_fastpath_rx_inline(bool all);
+
+enum wg_fastpath_open_result {
+	/* Untouched: hand the datagram to wg_fastpath_receive(). */
+	WG_FP_PASS,
+	/* Decrypted in place: *inner is an authenticated packet whose source
+	 * its peer is allowed to send from. */
+	WG_FP_OPENED,
+	/* Written or refused after authentication: drop the buffer. */
+	WG_FP_CONSUMED,
+};
+
+/* Open a WireGuard data message in the buffer it was received into, doing
+ * what the device's receive path would: keypair, authentication, replay
+ * window, endpoint, timers, AllowedIPs, statistics. @oip and @oudp are the
+ * validated outer IPv4 and UDP headers it arrived with on @iif, @msg and
+ * @len its UDP payload. On WG_FP_OPENED, *@inner and *@inner_len give the
+ * inner IPv4 or IPv6 packet (padding trimmed). The caller holds
+ * rcu_read_lock() and keeps @wg_dev registered across the call. */
+int wg_fastpath_open(struct net_device *wg_dev, const struct iphdr *oip,
+		     const struct udphdr *oudp, int iif, u8 *msg,
+		     unsigned int len, u8 **inner, unsigned int *inner_len);
+
+#endif /* _NET_WG_FASTPATH_H */
