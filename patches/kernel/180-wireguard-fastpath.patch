diff --git a/drivers/net/wireguard/fastpath.c b/drivers/net/wireguard/fastpath.c
new file mode 100644
index 000000000000..870a5f29d2c3
--- /dev/null
+++ b/drivers/net/wireguard/fastpath.c
@@ -0,0 +1,587 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Seal a forwarded IPv4 packet for its peer in place, in the buffer a NIC
+ * received it into, so the NIC can transmit the result without an skb.
+ *
+ * The caller hands over an Ethernet frame whose header it does not need (the
+ * classifier has already routed the packet, decremented its TTL and fixed its
+ * checksum). Anything this does not handle is declined before the buffer is
+ * written, and the caller then gives the packet to the device as usual.
+ */
+
+#include "queueing.h"
+#include "peer.h"
+#include "device.h"
+#include "messages.h"
+#include "timers.h"
+#include "allowedips.h"
+#include "noise.h"
+#include "peerlookup.h"
+#include "socket.h"
+
+#include <linux/ipv6.h>
+#include <linux/random.h>
+
+#include <crypto/algapi.h>
+#include <crypto/chacha.h>
+#include <crypto/chacha20poly1305.h>
+#include <crypto/poly1305.h>
+#include <net/inet_ecn.h>
+#include <net/ip.h>
+#include <net/neighbour.h>
+#include <net/arp.h>
+#include <net/route.h>
+#include <net/wg_fastpath.h>
+
+#define WG_FP_HLEN (ETH_HLEN + sizeof(struct iphdr) + sizeof(struct udphdr))
+
+#if IS_ENABLED(CONFIG_ARM64) && IS_ENABLED(CONFIG_KERNEL_MODE_NEON)
+#include <asm/cpufeature.h>
+#include <asm/neon.h>
+#include <asm/simd.h>
+#include <crypto/internal/simd.h>
+
+/* arch/arm64/crypto exports it, and poly1305_blocks_arm64(), for this file. */
+asmlinkage void chacha_4block_xor_neon(u32 *state, u8 *dst, const u8 *src,
+				       int nrounds, int bytes);
+
+/* Messages longer than this pay for a NEON section; ACKs and other short
+ * ones run ChaCha and Poly1305 on general registers and open none. */
+#define WG_FP_NEON_MIN 128
+
+/* Set once wg_fastpath_init()'s self-test has matched the library. */
+static bool wg_fp_aead_ready __read_mostly;
+
+/* XOR @len bytes at @data with the keystream from block 1 on: @ks holds
+ * blocks 1 to 4 after a NEON start, @state the rest. */
+static void wg_fp_xor(u32 *state, u8 *data, unsigned int len, const u8 *ks, bool neon)
+{
+	unsigned int n;
+
+	if (!neon) {
+		chacha_crypt_generic(state, data, data, len, 20);
+		return;
+	}
+	n = min(len, 4 * CHACHA_BLOCK_SIZE);
+	crypto_xor(data, ks + CHACHA_BLOCK_SIZE, n);
+	data += n;
+	len -= n;
+	/* The five-block routine wants more than one block, as chacha_doneon(). */
+	while (len > CHACHA_BLOCK_SIZE) {
+		n = min(len, 5 * CHACHA_BLOCK_SIZE);
+		chacha_4block_xor_neon(state, data, data, 20, n);
+		state[12] += DIV_ROUND_UP(n, CHACHA_BLOCK_SIZE);
+		data += n;
+		len -= n;
+	}
+	if (len)
+		chacha_crypt_generic(state, data, data, len, 20);
+}
+
+/*
+ * ChaCha20-Poly1305 in place, exactly as chacha20poly1305_encrypt() and
+ * chacha20poly1305_decrypt() with no associated data, for a per-packet
+ * budget: one NEON section a message rather than three, the Poly1305 key
+ * block taken from the first five-block ChaCha call rather than a scalar
+ * one of its own, and no NEON section for short messages. @len is the
+ * plaintext's; the tag follows it. Opening checks the tag before a byte is
+ * written. Returns false only for a bad tag.
+ */
+static bool wg_fp_aead(u8 *data, unsigned int len, u64 nonce,
+		       const u8 key[CHACHA20POLY1305_KEY_SIZE], bool seal)
+{
+	const u8 *zero = page_address(ZERO_PAGE(0));
+	const unsigned int full = round_down(len, POLY1305_BLOCK_SIZE);
+	const bool neon = len > WG_FP_NEON_MIN && crypto_simd_usable();
+	__le64 lens[2] = { 0, cpu_to_le64(len) }, iv[2] = { 0, cpu_to_le64(nonce) };
+	u8 ks[5 * CHACHA_BLOCK_SIZE], tail[POLY1305_BLOCK_SIZE], mac[POLY1305_DIGEST_SIZE];
+	u32 state[CHACHA_STATE_WORDS], k[CHACHA_KEY_SIZE / sizeof(u32)];
+	struct poly1305_desc_ctx poly;
+	bool ok = true;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(k); i++)
+		k[i] = get_unaligned_le32(key + i * sizeof(u32));
+	chacha_init_generic(state, k, (u8 *)iv);
+	if (neon) {
+		kernel_neon_begin();
+		/* Block 0 keys Poly1305; blocks 1 to 4 cover the first 256 bytes. */
+		chacha_4block_xor_neon(state, ks, zero, 20, sizeof(ks));
+		state[12] += 5;
+	} else {
+		chacha_crypt_generic(state, ks, zero, CHACHA_BLOCK_SIZE, 20);
+	}
+	poly1305_init_arch(&poly, ks);
+	if (seal)
+		wg_fp_xor(state, data, len, ks, neon);
+	if (full)
+		poly1305_blocks_arm64(&poly, data, full, neon);
+	if (len != full) {
+		memset(tail, 0, sizeof(tail));
+		memcpy(tail, data + full, len - full);
+		poly1305_blocks_arm64(&poly, tail, sizeof(tail), neon);
+	}
+	poly1305_blocks_arm64(&poly, (u8 *)lens, sizeof(lens), neon);
+	poly1305_final_arch(&poly, seal ? data + len : mac);
+	if (!seal) {
+		ok = !crypto_memneq(mac, data + len, sizeof(mac));
+		if (ok)
+			wg_fp_xor(state, data, len, ks, neon);
+	}
+	if (neon)
+		kernel_neon_end();
+	memzero_explicit(ks, sizeof(ks));
+	memzero_explicit(state, sizeof(state));
+	memzero_explicit(k, sizeof(k));
+	return ok;
+}
+
+/* Every branch of wg_fp_aead() against the library, both ways, and a forged
+ * tag; the fast path keeps the library's calls unless it all matches. */
+void __init wg_fastpath_init(void)
+{
+	static const u16 lens[] __initconst = {
+		1, 15, 16, 17, 63, 64, 65, 127, 128, 129, 143, 191, 192, 255, 256,
+		257, 300, 319, 320, 321, 383, 384, 385, 447, 448, 449, 576, 577,
+		1280, 1419, 1420, 1424, 1500, 8960, 9000,
+	};
+	u8 key[CHACHA20POLY1305_KEY_SIZE], *a, *b, *c;
+	const unsigned int max = 9000 + POLY1305_DIGEST_SIZE;
+	unsigned int i, len;
+	bool ok = true;
+	u64 nonce;
+
+	if (!cpu_have_named_feature(ASIMD))
+		return;
+	a = kmalloc(max, GFP_KERNEL);
+	b = kmalloc(max, GFP_KERNEL);
+	c = kmalloc(max, GFP_KERNEL);
+	for (i = 0; ok && a && b && c && i < ARRAY_SIZE(lens); i++) {
+		len = lens[i];
+		get_random_bytes(key, sizeof(key));
+		nonce = get_random_u64();
+		get_random_bytes(a, len);
+		memcpy(b, a, len);
+		memcpy(c, a, len);
+		chacha20poly1305_encrypt(a, a, len, NULL, 0, nonce, key);
+		ok = wg_fp_aead(b, len, nonce, key, true) &&
+		     !memcmp(a, b, len + POLY1305_DIGEST_SIZE) &&
+		     wg_fp_aead(b, len, nonce, key, false) && !memcmp(b, c, len);
+		/* A forged tag is refused and leaves the ciphertext as it was. */
+		a[len + i % POLY1305_DIGEST_SIZE] ^= 1;
+		memcpy(b, a, len + POLY1305_DIGEST_SIZE);
+		ok = ok && !wg_fp_aead(b, len, nonce, key, false) &&
+		     !memcmp(a, b, len + POLY1305_DIGEST_SIZE);
+	}
+	/* A mismatch warns, as a failed crypto self-test does (alg_test()). */
+	if (ok && a && b && c)
+		wg_fp_aead_ready = true;
+	else if (!ok)
+		WARN(1, "wireguard: fast path AEAD self-test failed; using the library's\n");
+	else
+		pr_err("wireguard: fast path AEAD self-test could not allocate; using the library's\n");
+	kfree(a);
+	kfree(b);
+	kfree(c);
+	memzero_explicit(key, sizeof(key));
+}
+#else
+#define wg_fp_aead_ready false
+static bool wg_fp_aead(u8 *data, unsigned int len, u64 nonce,
+		       const u8 key[CHACHA20POLY1305_KEY_SIZE], bool seal)
+{
+	return false;
+}
+
+void __init wg_fastpath_init(void)
+{
+}
+#endif
+
+/* Seal or open @len plaintext bytes in place, the tag after them. */
+static bool wg_fp_crypt(u8 *data, unsigned int len, u64 nonce,
+			const u8 key[CHACHA20POLY1305_KEY_SIZE], bool seal)
+{
+	if (likely(wg_fp_aead_ready))
+		return wg_fp_aead(data, len, nonce, key, seal);
+	if (!seal)
+		return chacha20poly1305_decrypt(data, data, len + POLY1305_DIGEST_SIZE,
+						NULL, 0, nonce, key);
+	chacha20poly1305_encrypt(data, data, len, NULL, 0, nonce, key);
+	return true;
+}
+
+struct wg_fastpath_tmpl {
+	struct rcu_head rcu;
+	/* NULL: decline until expires (no IPv4 endpoint, route or neighbour). */
+	struct net_device *dev;
+	unsigned long expires;
+	atomic_t id;
+	u8 hdr[WG_FP_HLEN];
+};
+
+static void wg_fp_tmpl_free(struct rcu_head *rcu)
+{
+	struct wg_fastpath_tmpl *t = container_of(rcu, struct wg_fastpath_tmpl, rcu);
+
+	dev_put(t->dev);
+	kfree(t);
+}
+
+void wg_fastpath_peer_free(struct wg_peer *peer)
+{
+	struct wg_fastpath_tmpl *t = rcu_dereference_protected(peer->fp_tmpl, 1);
+
+	if (t) {
+		dev_put(t->dev);
+		kfree(t);
+	}
+}
+
+/* The outer Ethernet, IPv4 and UDP header send4() would put on a packet now,
+ * for a device @can_tx accepts only. Called under rcu_read_lock_bh().
+ * ponytail: rebuilt once a second, so a roamed endpoint or a moved neighbour
+ * is followed within a second; compare per packet if that is too slow. */
+static struct wg_fastpath_tmpl *wg_fp_build(struct wg_peer *peer,
+					    wg_fastpath_can_tx_t can_tx)
+{
+	struct wg_device *wg = peer->device;
+	struct wg_fastpath_tmpl *t;
+	struct net_device *dev;
+	struct neighbour *n;
+	struct endpoint ep;
+	struct flowi4 fl;
+	struct rtable *rt;
+	struct sock *sock;
+	struct ethhdr *eth;
+	struct udphdr *udp;
+	struct iphdr *ip;
+
+	t = kzalloc(sizeof(*t), GFP_ATOMIC);
+	if (!t)
+		return NULL;
+	t->expires = jiffies + HZ;
+
+	read_lock_bh(&peer->endpoint_lock);
+	ep = peer->endpoint;
+	read_unlock_bh(&peer->endpoint_lock);
+	sock = rcu_dereference_bh(wg->sock4);
+	if (ep.addr.sa_family != AF_INET || !sock)
+		return t;
+
+	memset(&fl, 0, sizeof(fl));
+	fl.saddr = ep.src4.s_addr;
+	fl.daddr = ep.addr4.sin_addr.s_addr;
+	fl.fl4_dport = ep.addr4.sin_port;
+	fl.fl4_sport = inet_sk(sock)->inet_sport;
+	fl.flowi4_mark = wg->fwmark;
+	fl.flowi4_proto = IPPROTO_UDP;
+	rt = ip_route_output_flow(sock_net(sock), &fl, sock);
+	if (IS_ERR(rt))
+		return t;
+	dev = rt->dst.dev;
+	if (!can_tx(dev) || rt->rt_gw_family == AF_INET6)
+		goto out;
+	n = __ipv4_neigh_lookup_noref(dev, (__force u32)rt_nexthop(rt, fl.daddr));
+	if (!n || !(READ_ONCE(n->nud_state) & NUD_VALID))
+		goto out;
+
+	eth = (struct ethhdr *)t->hdr;
+	neigh_ha_snapshot(eth->h_dest, n, dev);
+	ether_addr_copy(eth->h_source, dev->dev_addr);
+	eth->h_proto = htons(ETH_P_IP);
+	ip = (struct iphdr *)(eth + 1);
+	ip->version = 4;
+	ip->ihl = 5;
+	ip->ttl = ip4_dst_hoplimit(&rt->dst);
+	ip->protocol = IPPROTO_UDP;
+	ip->saddr = fl.saddr;
+	ip->daddr = fl.daddr;
+	udp = (struct udphdr *)(ip + 1);
+	udp->source = fl.fl4_sport;
+	udp->dest = fl.fl4_dport;
+	dev_hold(dev);
+	t->dev = dev;
+out:
+	ip_rt_put(rt);
+	return t;
+}
+
+static struct wg_fastpath_tmpl *wg_fp_tmpl(struct wg_peer *peer,
+					   wg_fastpath_can_tx_t can_tx)
+{
+	struct wg_fastpath_tmpl *t = rcu_dereference_bh(peer->fp_tmpl), *n;
+
+	if (likely(t && time_before(jiffies, t->expires)))
+		return t;
+	/* One CPU rebuilds; the others keep using the old one meanwhile. */
+	if (!spin_trylock(&peer->fp_lock))
+		return t;
+	t = rcu_dereference_protected(peer->fp_tmpl, lockdep_is_held(&peer->fp_lock));
+	if (!t || !time_before(jiffies, t->expires)) {
+		n = wg_fp_build(peer, can_tx);
+		if (n) {
+			rcu_assign_pointer(peer->fp_tmpl, n);
+			if (t)
+				call_rcu(&t->rcu, wg_fp_tmpl_free);
+			t = n;
+		}
+	}
+	spin_unlock(&peer->fp_lock);
+	return t;
+}
+
+/**
+ * wg_fastpath_seal - encrypt a forwarded packet for its peer in place
+ * @wg_dev: the WireGuard device the packet was routed to
+ * @can_tx: whether the caller can transmit on a device
+ * @buf: the buffer
+ * @off: offset of the received Ethernet frame in @buf
+ * @len: length of that frame
+ * @size: usable size of @buf
+ * @tx: where the sealed frame is and which device sends it
+ *
+ * The caller holds rcu_read_lock() across the call and its use of @tx->dev.
+ *
+ * Return: 0 when sealed; a negative errno, with @buf untouched, otherwise:
+ * -EXDEV when this CPU receives the peer's packets and the caller should seal
+ * the frame on another one.
+ */
+int wg_fastpath_seal(struct net_device *wg_dev, wg_fastpath_can_tx_t can_tx,
+		     u8 *buf, unsigned int off, unsigned int len, unsigned int size,
+		     struct wg_fastpath_tx *tx)
+{
+	const unsigned int hlen = WG_FP_HLEN + sizeof(struct message_data);
+	struct wg_device *wg = netdev_priv(wg_dev);
+	u8 *inner = buf + off + ETH_HLEN;
+	struct iphdr *iph = (struct iphdr *)inner;
+	struct wg_fastpath_tmpl *t;
+	struct message_data *msg;
+	struct noise_keypair *kp;
+	struct wg_peer *peer;
+	unsigned int ip_len, plain, mtu;
+	struct udphdr *udp;
+	struct iphdr *oip;
+	u8 *hdr;
+	u64 ctr;
+	int ret = -EAGAIN;
+
+	if (len < ETH_HLEN + sizeof(*iph) || iph->version != 4)
+		return -EPROTO;
+	ip_len = ntohs(iph->tot_len);
+	mtu = READ_ONCE(wg_dev->mtu);
+	if (ip_len < sizeof(*iph) || ETH_HLEN + ip_len > len || ip_len > mtu)
+		return -EMSGSIZE;
+	/* The same padding calculate_skb_padding() gives a packet within MTU. */
+	plain = min_t(unsigned int, ALIGN(ip_len, MESSAGE_PADDING_MULTIPLE), mtu);
+	if (off + ETH_HLEN < hlen ||
+	    off + ETH_HLEN + plain + POLY1305_DIGEST_SIZE > size)
+		return -ENOSPC;
+
+	/* No reference on the peer: it is used only inside this read section,
+	 * and a removal waits for that (synchronize_net()) once it has set
+	 * is_dead, before the peer's last reference can go. */
+	rcu_read_lock_bh();
+	peer = wg_allowedips_lookup_dst4(&wg->peer_allowedips, &iph->daddr);
+	if (!peer) {
+		ret = -ENOKEY;
+		goto out;
+	}
+	/* The CPU that receives this peer's packets also carries every ACK of
+	 * the flows sealed here; sealing beside them starves both. Unless every
+	 * CPU receives, when there is no elsewhere to seal. */
+	if (READ_ONCE(peer->fp_rx_cpu) == raw_smp_processor_id() &&
+	    num_online_cpus() > 1 && !wg_fastpath_rx_everywhere()) {
+		ret = -EXDEV;
+		goto out;
+	}
+	if (unlikely(READ_ONCE(peer->is_dead)))
+		goto out;
+	kp = rcu_dereference_bh(peer->keypairs.current_keypair);
+	if (unlikely(!kp || !READ_ONCE(kp->sending.is_valid) ||
+		     wg_birthdate_has_expired(kp->sending.birthdate, REJECT_AFTER_TIME)))
+		goto out;
+	t = wg_fp_tmpl(peer, can_tx);
+	if (unlikely(!t || !t->dev))
+		goto out;
+	ctr = atomic64_inc_return(&kp->sending_counter) - 1;
+	if (unlikely(ctr >= REJECT_AFTER_MESSAGES))
+		goto out;
+
+	memset(inner + ip_len, 0, plain - ip_len);
+	wg_fp_crypt(inner, plain, ctr, kp->sending.key, true);
+
+	hdr = inner - hlen;
+	memcpy(hdr, t->hdr, WG_FP_HLEN);
+	oip = (struct iphdr *)(hdr + ETH_HLEN);
+	/* As send4(): only the inner ECN bits reach the outer header. */
+	oip->tos = INET_ECN_encapsulate(0, iph->tos);
+	oip->tot_len = htons(sizeof(*oip) + sizeof(*udp) + sizeof(*msg) + plain +
+			     POLY1305_DIGEST_SIZE);
+	oip->id = htons((u16)atomic_inc_return(&t->id));
+	oip->check = ip_fast_csum((u8 *)oip, oip->ihl);
+	udp = (struct udphdr *)(oip + 1);
+	udp->len = htons(sizeof(*udp) + sizeof(*msg) + plain + POLY1305_DIGEST_SIZE);
+	udp->check = 0;
+	msg = (struct message_data *)(udp + 1);
+	msg->header.type = cpu_to_le32(MESSAGE_DATA);
+	msg->key_idx = kp->remote_index;
+	msg->counter = cpu_to_le64(ctr);
+
+	/* The timers want every packet; a few a second keep them right. */
+	if (time_after(jiffies, READ_ONCE(peer->fp_timers))) {
+		WRITE_ONCE(peer->fp_timers, jiffies + HZ / 50);
+		wg_timers_any_authenticated_packet_traversal(peer);
+		wg_timers_any_authenticated_packet_sent(peer);
+		wg_timers_data_sent(peer);
+		/* keep_key_fresh(); the send is itself rate limited. */
+		if (ctr > REKEY_AFTER_MESSAGES ||
+		    (kp->i_am_the_initiator &&
+		     wg_birthdate_has_expired(kp->sending.birthdate, REKEY_AFTER_TIME)))
+			wg_packet_send_queued_handshake_initiation(peer, false);
+	}
+
+	tx->dev = t->dev;
+	tx->saddr = oip->saddr;
+	tx->daddr = oip->daddr;
+	tx->sport = udp->source;
+	tx->dport = udp->dest;
+	tx->off = hdr - buf;
+	tx->len = hlen + plain + POLY1305_DIGEST_SIZE;
+	/* Counted as the ordinary send counts a packet: the message, for the
+	 * peer (wg_socket_send_skb_to_peer()) and as one packet for the device
+	 * (iptunnel_xmit(), whose inner headers wg_reset_packet() put at the
+	 * message). A frame the caller then fails to transmit is counted here
+	 * all the same. */
+	atomic64_add(message_data_len(plain), &peer->fp_tx_bytes);
+	dev_sw_netstats_tx_add(wg_dev, 1, message_data_len(plain));
+	ret = 0;
+out:
+	rcu_read_unlock_bh();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wg_fastpath_seal);
+
+void wg_fastpath_receive(struct net_device *wg_dev, struct sk_buff *skb)
+{
+	skb_mark_not_on_list(skb);
+	wg_packet_receive(netdev_priv(wg_dev), skb);
+}
+EXPORT_SYMBOL_GPL(wg_fastpath_receive);
+
+int wg_fastpath_open(struct net_device *wg_dev, const struct iphdr *oip,
+		     const struct udphdr *oudp, int iif, u8 *msg,
+		     unsigned int len, u8 **inner, unsigned int *inner_len)
+{
+	struct message_data *md = (struct message_data *)msg;
+	struct wg_device *wg = netdev_priv(wg_dev);
+	struct wg_peer *peer = NULL, *routed;
+	unsigned int plain, ilen;
+	struct noise_keypair *kp;
+	struct endpoint ep;
+	const void *saddr;
+	unsigned long t;
+	int ret = WG_FP_PASS;
+	u8 *ip, version;
+	u64 nonce;
+
+	/* Data messages with a packet in them only. Handshakes, cookies and
+	 * keepalives take the ordinary path, and so does an outer CE mark,
+	 * which the inner header would have to inherit (INET_ECN_decapsulate()). */
+	if (len < sizeof(*md) + noise_encrypted_len(sizeof(struct iphdr)) ||
+	    md->header.type != cpu_to_le32(MESSAGE_DATA) ||
+	    INET_ECN_is_ce(oip->tos))
+		return WG_FP_PASS;
+	plain = len - sizeof(*md) - noise_encrypted_len(0);
+	nonce = le64_to_cpu(md->counter);
+
+	/* No references, as in wg_fastpath_seal(). */
+	rcu_read_lock_bh();
+	kp = (struct noise_keypair *)wg_index_hashtable_lookup_rcu(wg->index_hashtable,
+			INDEX_HASHTABLE_KEYPAIR, md->key_idx, &peer);
+	if (unlikely(!kp))
+		goto out;
+	/* The current keypair only: the first message on the next one confirms
+	 * a handshake (wg_noise_received_with_keypair()), which the ordinary
+	 * path does. The rest is decrypt_packet()'s validity test. */
+	if (unlikely(READ_ONCE(peer->is_dead) ||
+		     kp != rcu_dereference_bh(peer->keypairs.current_keypair) ||
+		     !READ_ONCE(kp->receiving.is_valid) ||
+		     wg_birthdate_has_expired(kp->receiving.birthdate, REJECT_AFTER_TIME) ||
+		     READ_ONCE(kp->receiving_counter.counter) >= REJECT_AFTER_MESSAGES))
+		goto out;
+
+	/* Authenticated before a byte is written: a forgery leaves the buffer
+	 * as it was, but is not worth the ordinary path's second attempt. */
+	ret = WG_FP_CONSUMED;
+	if (unlikely(!wg_fp_crypt(msg + sizeof(*md), plain, nonce, kp->receiving.key, false)))
+		goto out;
+	if (unlikely(!wg_fastpath_counter_ok(kp, nonce)))
+		goto out;
+
+	/* Roaming, as wg_socket_endpoint_from_skb() and
+	 * wg_socket_set_peer_endpoint() have it; an unlocked compare first, as
+	 * the latter's own does, so a steady peer costs no lock. */
+	if (unlikely(peer->endpoint.addr4.sin_family != AF_INET ||
+		     peer->endpoint.addr4.sin_addr.s_addr != oip->saddr ||
+		     peer->endpoint.addr4.sin_port != oudp->source ||
+		     peer->endpoint.src4.s_addr != oip->daddr)) {
+		memset(&ep, 0, sizeof(ep));
+		ep.addr4.sin_family = AF_INET;
+		ep.addr4.sin_port = oudp->source;
+		ep.addr4.sin_addr.s_addr = oip->saddr;
+		ep.src4.s_addr = oip->daddr;
+		ep.src_if4 = iif;
+		wg_socket_set_peer_endpoint(peer, &ep);
+	}
+
+	/* wg_packet_consume_data_done()'s timers and rekey test, a few times a
+	 * second rather than per packet, as the seal path paces its own; one
+	 * CPU takes each turn, as a peer's packets are opened on several. */
+	t = READ_ONCE(peer->fp_rx_timers);
+	if (time_after(jiffies, t) &&
+	    cmpxchg(&peer->fp_rx_timers, t, jiffies + HZ / 50) == t) {
+		wg_fastpath_keep_key_fresh(peer);
+		wg_timers_any_authenticated_packet_received(peer);
+		wg_timers_any_authenticated_packet_traversal(peer);
+		wg_timers_data_received(peer);
+	}
+
+	ip = msg + sizeof(*md);
+	version = ip[0] >> 4;
+	if (version == 4) {
+		ilen = ntohs(((struct iphdr *)ip)->tot_len);
+		if (unlikely(ilen < sizeof(struct iphdr)))
+			goto bad_size;
+		saddr = &((struct iphdr *)ip)->saddr;
+	} else if (version == 6 && plain >= sizeof(struct ipv6hdr)) {
+		ilen = ntohs(((struct ipv6hdr *)ip)->payload_len) + sizeof(struct ipv6hdr);
+		saddr = &((struct ipv6hdr *)ip)->saddr;
+	} else {
+		DEV_STATS_INC(wg_dev, rx_errors);
+		DEV_STATS_INC(wg_dev, rx_frame_errors);
+		goto out;
+	}
+	if (unlikely(ilen > plain))
+		goto bad_size;
+	routed = wg_allowedips_lookup_src_ip(&wg->peer_allowedips, version, saddr);
+	if (unlikely(routed != peer)) {
+		DEV_STATS_INC(wg_dev, rx_errors);
+		DEV_STATS_INC(wg_dev, rx_frame_errors);
+		goto out;
+	}
+	dev_sw_netstats_rx_add(wg_dev, message_data_len(plain));
+	atomic64_add(message_data_len(plain), &peer->fp_rx_bytes);
+	*inner = ip;
+	*inner_len = ilen;
+	ret = WG_FP_OPENED;
+	goto out;
+
+bad_size:
+	DEV_STATS_INC(wg_dev, rx_errors);
+	DEV_STATS_INC(wg_dev, rx_length_errors);
+out:
+	rcu_read_unlock_bh();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wg_fastpath_open);
