diff --git a/arch/arm64/crypto/chacha-neon-glue.c b/arch/arm64/crypto/chacha-neon-glue.c
index af2bbca38e70..ef8b511cfd44 100644
--- a/arch/arm64/crypto/chacha-neon-glue.c
+++ b/arch/arm64/crypto/chacha-neon-glue.c
@@ -37,6 +37,9 @@ asmlinkage void chacha_4block_xor_neon(u32 *state, u8 *dst, const u8 *src,
 				       int nrounds, int bytes);
 asmlinkage void hchacha_block_neon(const u32 *state, u32 *out, int nrounds);
 
+/* For WireGuard's fast path, which opens one NEON section a packet. */
+EXPORT_SYMBOL_GPL(chacha_4block_xor_neon);
+
 static __ro_after_init DEFINE_STATIC_KEY_FALSE(have_neon);
 
 static void chacha_doneon(u32 *state, u8 *dst, const u8 *src,
diff --git a/arch/arm64/crypto/poly1305-glue.c b/arch/arm64/crypto/poly1305-glue.c
index 18883ea438f3..183e9d52af18 100644
--- a/arch/arm64/crypto/poly1305-glue.c
+++ b/arch/arm64/crypto/poly1305-glue.c
@@ -36,6 +36,20 @@ void poly1305_init_arch(struct poly1305_desc_ctx *dctx, const u8 key[POLY1305_KE
 }
 EXPORT_SYMBOL(poly1305_init_arch);
 
+/* For WireGuard's fast path, which holds one NEON section a packet: @len (a
+ * multiple of 16) bytes into the accumulator, on NEON inside the caller's
+ * kernel_neon_begin() when @neon, else on general registers. A C wrapper,
+ * so a caller in another module lands on a BTI pad. */
+void poly1305_blocks_arm64(struct poly1305_desc_ctx *dctx, const u8 *src,
+			   u32 len, bool neon)
+{
+	if (neon)
+		poly1305_blocks_neon(&dctx->h, src, len, 1);
+	else
+		poly1305_blocks(&dctx->h, src, len, 1);
+}
+EXPORT_SYMBOL_GPL(poly1305_blocks_arm64);
+
 static int neon_poly1305_init(struct shash_desc *desc)
 {
 	struct poly1305_desc_ctx *dctx = shash_desc_ctx(desc);
