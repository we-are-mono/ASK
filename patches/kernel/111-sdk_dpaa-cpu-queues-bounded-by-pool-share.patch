From b775c92816da84e4dc7feb56f408acaffbed8e34 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Fri, 9 Oct 2026 16:39:25 +0200
Subject: [PATCH] sdk_dpaa: bound a port's queues to the CPU by its share of
 the pool

A frame waiting on a port's queues to the CPU holds a buffer of the pool
every DPAA port receives into, and only the CPU taking it puts one back.
The group those queues share counted bytes, up to 256 MB, so a flood the
CPU could not keep up with held the whole pool, and every port missed
whatever it received, forwarding in hardware included.

Count frames instead, at half of what the port seeds the pool with
(fsl_dpa.ingress_quarters, one to four quarters), and drop the per-frame
byte overhead and the Kconfig threshold that only meant bytes. A quarter
refused about one frame in a hundred of the CPU's own forwarding while
16,384 connections were admitted at a measured pace; half refused none,
and a flood the CPU cannot keep up with still held no more than 1,329
buffers. Congestion state changes stay off, now explicitly.

The pool is one (dpa_priv_common_bpid), but each port counted its own
per-CPU fill of it: a frame received on one port and sent out of another
found the sender's count at target and was Tx-confirmed and freed while
the receiver refilled with new buffers -- an allocation and a free per
forwarded frame, 11% of a WireGuard receive CPU on its ACKs alone. The
fill is now one per-CPU count shared by every private port, each adding
its share (CONFIG_FSL_DPAA_ETH_MAX_BUF_COUNT) to what the pool is kept
at, so it holds as many buffers as before.
---
--- a/drivers/net/ethernet/freescale/sdk_dpaa/Kconfig
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/Kconfig
@@ -146,14 +146,6 @@
 	help
 	  The size in bytes of the egress Congestion State notification threshold on 10G ports.
 
-config FSL_DPAA_INGRESS_CS_THRESHOLD
-	hex "Ingress congestion threshold on FMan ports"
-	depends on FSL_SDK_DPAA_ETH
-	default "0x10000000"
-	help
-	  The size in bytes of the ingress tail-drop threshold on FMan ports.
-	  Traffic piling up above this value will be rejected by QMan and discarded by FMan.
-
 config FSL_DPAA_ETH_DEBUGFS
 	bool "DPAA Ethernet debugfs interface"
 	depends on DEBUG_FS && FSL_SDK_DPAA_ETH
--- a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth.c
@@ -100,6 +100,13 @@
 module_param(debug, byte, S_IRUGO);
 MODULE_PARM_DESC(debug, "Module/Driver verbosity level");
 
+/* How many quarters of what a port seeds the pool with its queues to the CPU
+ * may hold (dpaa_eth_priv_ingress_cgr_init()): half by default. */
+static uint ingress_quarters = 2;
+module_param(ingress_quarters, uint, 0444);
+MODULE_PARM_DESC(ingress_quarters,
+		 "Quarters of a port's pool seed its queues to the CPU may hold (1-4)");
+
 /* This has to work in tandem with the DPA_CS_THRESHOLD_xxx values. */
 static uint16_t tx_timeout = 1000;
 module_param(tx_timeout, ushort, S_IRUGO);
@@ -110,6 +117,10 @@
 #define DPAA_ETH_MAX_PAD (L1_CACHE_BYTES * 8)
 
 static uint8_t dpa_priv_common_bpid;
+/* The per-CPU fill of that common pool, counted once for every private port
+ * (dpaa_eth_priv_probe()). Allocated with the first port and kept: private
+ * ports are not removed. */
+static int __percpu *dpa_priv_common_count;
 
 #ifdef CONFIG_FSL_DPAA_DBG_LOOP
 struct net_device *dpa_loop_netdevs[20];
@@ -898,10 +909,23 @@
 	return dpa_bp;
 }
 
-/* Place all ingress FQs (Rx Default, Rx Error, PCD FQs) in a dedicated CGR.
- * We won't be sending congestion notifications to FMan; for now, we just use
- * this CGR to generate enqueue rejections to FMan in order to drop the frames
- * before they reach our ingress queues and eat up memory.
+/* Place all ingress FQs (Rx Default, Rx Error, PCD FQs) in a dedicated CGR,
+ * which refuses FMan's enqueue past its threshold, so FMan drops the frame.
+ *
+ * A frame waiting on these queues for the CPU holds a buffer of the pool
+ * every port receives into, and only the CPU taking it puts one back
+ * (dpaa_eth_refill_bpools()). The group counted bytes, up to 256 MB, so a
+ * flood the CPU could not keep up with -- traffic for the gateway itself, or
+ * for a flow not yet in hardware -- held the whole pool, and every port missed
+ * whatever it received, forwarding in hardware included. So it counts frames,
+ * at half of what this port seeds the pool with (ingress_quarters): a port's
+ * queues to the CPU then never hold more than half its own share, and a flood
+ * of one port leaves the others theirs. A quarter was measured too tight for
+ * the CPU's own forwarding -- some one frame in a hundred refused while 16,384
+ * connections were admitted at a measured pace, where half refused none -- and
+ * a whole share lost no less of a mass re-admission in hardware while leaving
+ * the pool less to receive into. Nothing consumes congestion state changes, so
+ * none are raised.
  */
 static int dpaa_eth_priv_ingress_cgr_init(struct dpa_priv_s *priv)
 {
@@ -915,11 +939,12 @@
 		goto out_error;
 	}
 
-	/* Enable CS TD, but disable Congestion State Change Notifications. */
 	memset(&initcgr, 0, sizeof(initcgr));
-	initcgr.we_mask = QM_CGR_WE_CS_THRES;
-	initcgr.cgr.cscn_en = QM_CGR_EN;
-	cs_th = CONFIG_FSL_DPAA_INGRESS_CS_THRESHOLD;
+	initcgr.we_mask = QM_CGR_WE_MODE | QM_CGR_WE_CS_THRES | QM_CGR_WE_CSCN_EN;
+	initcgr.cgr.mode = QMAN_CGR_MODE_FRAME;
+	initcgr.cgr.cscn_en = 0;
+	cs_th = max_t(u32, priv->dpa_bp->config_count * num_possible_cpus() *
+			   clamp_t(uint, ingress_quarters, 1, 4) / 4, 1);
 	qm_cgr_cs_thres_set64(&initcgr.cgr.cs_thres, cs_th, 1);
 
 	initcgr.we_mask |= QM_CGR_WE_CSTD_EN;
@@ -1180,17 +1205,24 @@
 		memset(percpu_priv, 0, sizeof(*percpu_priv));
 	}
 
-	priv->percpu_count = devm_alloc_percpu(dev, *priv->percpu_count);
-	if (!priv->percpu_count) {
-		dev_err(dev, "devm_alloc_percpu() failed\n");
-		err = -ENOMEM;
-		goto alloc_percpu_failed;
-	}
-
-	for_each_possible_cpu(i) {
-		int *percpu_count = per_cpu_ptr(priv->percpu_count, i);
-		*percpu_count = 0;
+	/* Every private port receives into the one common pool, so its fill is
+	 * counted once. Counted per port, a frame received on one port and
+	 * sent out of another found the sender's count already full and was
+	 * confirmed and freed, while the receiver refilled with new buffers --
+	 * an allocation and a free per forwarded frame. Each port still adds
+	 * its own share to what the pool is kept at, so the pool holds what
+	 * it did. */
+	if (!dpa_priv_common_count) {
+		dpa_priv_common_count = alloc_percpu(int);
+		if (!dpa_priv_common_count) {
+			dev_err(dev, "alloc_percpu() failed\n");
+			err = -ENOMEM;
+			goto alloc_percpu_failed;
+		}
+	} else {
+		dpa_bp->config_count += CONFIG_FSL_DPAA_ETH_MAX_BUF_COUNT;
 	}
+	priv->percpu_count = dpa_priv_common_count;
 
 	/* Initialize NAPI */
 	err = dpa_private_napi_add(net_dev);
--- a/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_common.c
+++ b/drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_common.c
@@ -1317,14 +1317,8 @@
 			initfq.we_mask |= QM_INITFQ_WE_CGID;
 			initfq.fqd.fq_ctrl |= QM_FQCTRL_CGE;
 			initfq.fqd.cgid = (uint8_t)priv->ingress_cgr.cgrid;
-			/* Set a fixed overhead accounting, just like for the
-			 * egress CGR.
-			 */
-			initfq.we_mask |= QM_INITFQ_WE_OAC;
-			initfq.fqd.oac_init.oac = QM_OAC_CG;
-			initfq.fqd.oac_init.oal =
-				(signed char)(min(sizeof(struct sk_buff) +
-				priv->tx_headroom, (size_t)FSL_QMAN_MAX_OAL));
+			/* The group counts frames, so no per-frame byte
+			 * overhead is accounted. */
 		}
 
 		/* Initialization common to all ingress queues */
-- 
2.47.3
