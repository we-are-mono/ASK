+++ b/net/core/gro.c
@@ -671,6 +671,9 @@ static void napi_reuse_skb(struct napi_struct *napi, struct sk_buff *skb)
 	__vlan_hwaccel_clear_tag(skb);
 	skb->dev = napi->dev;
 	skb->skb_iif = 0;
+#ifdef CONFIG_CPE_FAST_PATH
+	skb->iif_index = 0;
+#endif
 
 	/* eth_type_trans() assumes pkt_type is PACKET_HOST */
 	skb->pkt_type = PACKET_HOST;
diff --git a/net/core/rtnetlink.c b/net/core/rtnetlink.c
index 159a6270d5fb8..b4d7ceb0265af 100644
--- a/net/core/rtnetlink.c
+++ b/net/core/rtnetlink.c
@@ -884,9 +884,17 @@ int rtnetlink_put_metrics(struct sk_buff *skb, u32 *metrics)
 	struct nlattr *mx;
 	int i, valid = 0;
 
+#ifndef CONFIG_CPE_FAST_PATH
+	/*By default this metric is zero for all routes unless mtu is 
+		included while adding route.Due to this mtu is coming as zero 
+		when cmm gets the route through netlink messge.So Added condtion 
+		to bypass this code so that cmm gets right mtu value even if route
+		is added without including mtu
+					*/
 	/* nothing is dumped for dst_default_metrics, so just skip the loop */
 	if (metrics == dst_default_metrics.metrics)
 		return 0;
+#endif
 
 	mx = nla_nest_start_noflag(skb, RTA_METRICS);
 	if (mx == NULL)
@@ -916,6 +924,17 @@ int rtnetlink_put_metrics(struct sk_buff *skb, u32 *metrics)
 			}
 			valid++;
 		}
+#ifdef CONFIG_CPE_FAST_PATH
+		else if (i  == RTAX_MTU - 1){
+			struct dst_entry *dst = skb_dst(skb);
+			if(dst)
+			{
+				if (nla_put_u32(skb, i + 1, dst_mtu(dst)))
+					goto nla_put_failure;
+				valid++;
+			}
+		}
+#endif	
 	}
 
 	if (!valid) {
diff --git a/net/core/skbuff.c b/net/core/skbuff.c
index 04862f052adcf..570b5aa1c3f0f 100644
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -1538,12 +1538,18 @@ static void __copy_skb_header(struct sk_buff *new, const struct sk_buff *old)
 	 */
 	new->queue_mapping = old->queue_mapping;
 
+#if defined(CONFIG_INET_IPSEC_OFFLOAD) || defined(CONFIG_INET6_IPSEC_OFFLOAD)
+	new->ipsec_offload       = old->ipsec_offload;
+#endif
 	memcpy(&new->headers, &old->headers, sizeof(new->headers));
 	CHECK_SKB_FIELD(protocol);
 	CHECK_SKB_FIELD(csum);
 	CHECK_SKB_FIELD(hash);
 	CHECK_SKB_FIELD(priority);
 	CHECK_SKB_FIELD(skb_iif);
+#ifdef CONFIG_CPE_FAST_PATH
+	CHECK_SKB_FIELD(iif_index);
+#endif
 	CHECK_SKB_FIELD(vlan_proto);
 	CHECK_SKB_FIELD(vlan_tci);
 	CHECK_SKB_FIELD(transport_header);
@@ -6179,7 +6185,29 @@ void skb_scrub_packet(struct sk_buff *skb, bool xnet)
 	skb->skb_iif = 0;
 	skb->ignore_df = 0;
 	skb_dst_drop(skb);
-	skb_ext_reset(skb);
+#if defined(CONFIG_INET_IPSEC_OFFLOAD) || defined(CONFIG_INET6_IPSEC_OFFLOAD)
+	/*
+	 * ASK IPsec offload: preserve the skb extensions on an offloaded skb
+	 * instead of scrubbing them. xfrm_output_one() sets ->ipsec_offload
+	 * and attaches the secpath (SKB_EXT_SEC_PATH); the DPAA egress driver
+	 * later reads sp->xvec[0] in dpaa_submit_outb_pkt_to_SEC() to find the
+	 * CAAM frame queue for this SA. On a PPPoE/tunnel WAN the packet
+	 * crosses a scrub boundary (e.g. ppp_start_xmit()) between that point
+	 * and the driver read, so a plain skb_ext_reset() here would drop the
+	 * secpath and the offload would silently free the packet.
+	 *
+	 * Skipping the whole reset (rather than surgically preserving just the
+	 * secpath) is safe: in this configuration the only other extension is
+	 * nf_bridge_info, which is read only by br_netfilter hooks that never
+	 * run on the egress-to-CAAM path, pins no counted netdev reference,
+	 * and is freed with the skb. br_netfilter has no IP forward/post-
+	 * routing hook to strip it, so stock already carries it out to any
+	 * non-scrubbing egress device. Every other scrub action below still
+	 * runs for offloaded skbs.
+	 */
+	if (!skb->ipsec_offload)
+#endif
+		skb_ext_reset(skb);
 	nf_reset_ct(skb);
 	nf_reset_trace(skb);
 
