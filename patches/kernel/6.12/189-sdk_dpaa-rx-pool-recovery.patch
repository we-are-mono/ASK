 .../ethernet/freescale/sdk_dpaa/dpaa_eth.c    |  21 +-
 .../ethernet/freescale/sdk_dpaa/dpaa_eth.h    |  10 +
 .../freescale/sdk_dpaa/dpaa_eth_common.c      |   4 +
 .../freescale/sdk_dpaa/dpaa_eth_pool.c        | 337 ++++++++++++++++++
 .../ethernet/freescale/sdk_dpaa/dpaa_eth_sg.c |  38 +-
 .../freescale/sdk_dpaa/dpaa_ethtool.c         |  14 +-
 7 files changed, 422 insertions(+), 6 deletions(-)
 create mode 100644 drivers/net/ethernet/freescale/sdk_dpaa/dpaa_eth_pool.c

