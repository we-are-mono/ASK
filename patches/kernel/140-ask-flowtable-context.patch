From 46164972fc10c50b3512289b148bacbb05a713d1 Mon Sep 17 00:00:00 2001
From: Tomaz Zaman <tomaz@mono.si>
Date: Tue, 22 Sep 2026 02:43:47 +0200
Subject: [PATCH] netfilter: provide flowtable hardware lifecycle and policy
 context

---
 drivers/net/bonding/bond_main.c       |  80 +++++++++++++-------
 include/linux/netdevice.h             |   2 +
 include/net/flow.h                    |   2 +
 include/net/flow_offload.h            |  34 +++++++++
 include/net/netevent.h                |  31 ++++++++
 include/net/netfilter/nf_flow_table.h |  45 ++++++++++++
 include/net/netns/xfrm.h              |   2 +
 include/net/xfrm.h                    |  83 ++++++++++++++++++---
 net/ipv4/fib_trie.c                   |  20 +++++
 net/ipv4/route.c                      |   3 +-
 net/ipv6/ip6_fib.c                    |  23 ++++++
 net/netfilter/nf_flow_table_core.c    |  71 +++++++++++++++++-
 net/netfilter/nf_flow_table_ip.c      |  25 ++++++-
 net/netfilter/nf_flow_table_offload.c |  95 +++++++++++++++++++++++-
 net/netfilter/nft_flow_offload.c      | 102 +++++++++++++++++++++-----
 net/xfrm/xfrm_device.c                |  29 ++++++--
 net/xfrm/xfrm_policy.c                |  77 ++++++++++++++++++-
 net/xfrm/xfrm_state.c                 |  25 +++++--
 net/xfrm/xfrm_user.c                  |   6 ++
 19 files changed, 679 insertions(+), 76 deletions(-)

diff --git a/drivers/net/bonding/bond_main.c b/drivers/net/bonding/bond_main.c
index 2919329..a6780e8 100644
--- a/drivers/net/bonding/bond_main.c
+++ b/drivers/net/bonding/bond_main.c
@@ -425,6 +425,18 @@ static int bond_vlan_rx_kill_vid(struct net_device *bond_dev,
 /*---------------------------------- XFRM -----------------------------------*/
 
 #ifdef CONFIG_XFRM_OFFLOAD
+/* Bonding delegates through a slave without retaining a separate provider
+ * reference. Only providers whose lifetime belongs to that netdevice can be
+ * delegated to; a dynamically registered provider needs its own ownership. */
+static const struct xfrmdev_ops *bond_ipsec_ops(struct net_device *dev)
+{
+	const struct xfrmdev_ops *ops = xfrm_dev_ops_get(dev);
+	bool dynamic = ops && ops->owner;
+
+	xfrm_dev_ops_put(ops);
+	return dynamic ? NULL : ops;
+}
+
 /**
  * bond_ipsec_dev - Get active device for IPsec offload
  * @xs: pointer to transformer state struct
@@ -468,6 +480,7 @@ static struct net_device *bond_ipsec_dev(struct xfrm_state *xs)
 static int bond_ipsec_add_sa(struct xfrm_state *xs,
 			     struct netlink_ext_ack *extack)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *bond_dev = xs->xso.dev;
 	struct net_device *real_dev;
 	netdevice_tracker tracker;
@@ -490,8 +503,9 @@ static int bond_ipsec_add_sa(struct xfrm_state *xs,
 		goto out;
 	}
 
-	if (!real_dev->xfrmdev_ops ||
-	    !real_dev->xfrmdev_ops->xdo_dev_state_add ||
+	ops = bond_ipsec_ops(real_dev);
+	if (!ops ||
+	    !ops->xdo_dev_state_add ||
 	    netif_is_bond_master(real_dev)) {
 		NL_SET_ERR_MSG_MOD(extack, "Slave does not support ipsec offload");
 		err = -EINVAL;
@@ -504,7 +518,7 @@ static int bond_ipsec_add_sa(struct xfrm_state *xs,
 		goto out;
 	}
 
-	err = real_dev->xfrmdev_ops->xdo_dev_state_add(xs, extack);
+	err = ops->xdo_dev_state_add(xs, extack);
 	if (!err) {
 		xs->xso.real_dev = real_dev;
 		ipsec->xs = xs;
@@ -522,6 +536,7 @@ out:
 
 static void bond_ipsec_add_sa_all(struct bonding *bond)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *bond_dev = bond->dev;
 	struct net_device *real_dev;
 	struct bond_ipsec *ipsec;
@@ -533,8 +548,9 @@ static void bond_ipsec_add_sa_all(struct bonding *bond)
 		return;
 
 	mutex_lock(&bond->ipsec_lock);
-	if (!real_dev->xfrmdev_ops ||
-	    !real_dev->xfrmdev_ops->xdo_dev_state_add ||
+	ops = bond_ipsec_ops(real_dev);
+	if (!ops ||
+	    !ops->xdo_dev_state_add ||
 	    netif_is_bond_master(real_dev)) {
 		if (!list_empty(&bond->ipsec_list))
 			slave_warn(bond_dev, real_dev,
@@ -548,7 +564,7 @@ static void bond_ipsec_add_sa_all(struct bonding *bond)
 		if (ipsec->xs->xso.real_dev == real_dev)
 			continue;
 
-		if (real_dev->xfrmdev_ops->xdo_dev_state_add(ipsec->xs, NULL)) {
+		if (ops->xdo_dev_state_add(ipsec->xs, NULL)) {
 			slave_warn(bond_dev, real_dev, "%s: failed to add SA\n", __func__);
 			continue;
 		}
@@ -564,6 +580,7 @@ out:
  **/
 static void bond_ipsec_del_sa(struct xfrm_state *xs)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *bond_dev = xs->xso.dev;
 	struct net_device *real_dev;
 	netdevice_tracker tracker;
@@ -589,14 +606,15 @@ static void bond_ipsec_del_sa(struct xfrm_state *xs)
 
 	WARN_ON(xs->xso.real_dev != real_dev);
 
-	if (!real_dev->xfrmdev_ops ||
-	    !real_dev->xfrmdev_ops->xdo_dev_state_delete ||
+	ops = bond_ipsec_ops(real_dev);
+	if (!ops ||
+	    !ops->xdo_dev_state_delete ||
 	    netif_is_bond_master(real_dev)) {
 		slave_warn(bond_dev, real_dev, "%s: no slave xdo_dev_state_delete\n", __func__);
 		goto out;
 	}
 
-	real_dev->xfrmdev_ops->xdo_dev_state_delete(xs);
+	ops->xdo_dev_state_delete(xs);
 out:
 	netdev_put(real_dev, &tracker);
 	mutex_lock(&bond->ipsec_lock);
@@ -612,6 +630,7 @@ out:
 
 static void bond_ipsec_del_sa_all(struct bonding *bond)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *bond_dev = bond->dev;
 	struct net_device *real_dev;
 	struct bond_ipsec *ipsec;
@@ -627,17 +646,18 @@ static void bond_ipsec_del_sa_all(struct bonding *bond)
 		if (!ipsec->xs->xso.real_dev)
 			continue;
 
-		if (!real_dev->xfrmdev_ops ||
-		    !real_dev->xfrmdev_ops->xdo_dev_state_delete ||
+		ops = bond_ipsec_ops(real_dev);
+		if (!ops ||
+		    !ops->xdo_dev_state_delete ||
 		    netif_is_bond_master(real_dev)) {
 			slave_warn(bond_dev, real_dev,
 				   "%s: no slave xdo_dev_state_delete\n",
 				   __func__);
 		} else {
 			ipsec->xs->xso.real_dev = NULL;
-			real_dev->xfrmdev_ops->xdo_dev_state_delete(ipsec->xs);
-			if (real_dev->xfrmdev_ops->xdo_dev_state_free)
-				real_dev->xfrmdev_ops->xdo_dev_state_free(ipsec->xs);
+			ops->xdo_dev_state_delete(ipsec->xs);
+			if (ops->xdo_dev_state_free)
+				ops->xdo_dev_state_free(ipsec->xs);
 		}
 	}
 	mutex_unlock(&bond->ipsec_lock);
@@ -645,6 +665,7 @@ static void bond_ipsec_del_sa_all(struct bonding *bond)
 
 static void bond_ipsec_free_sa(struct xfrm_state *xs)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *bond_dev = xs->xso.dev;
 	struct net_device *real_dev;
 	netdevice_tracker tracker;
@@ -670,9 +691,10 @@ static void bond_ipsec_free_sa(struct xfrm_state *xs)
 	WARN_ON(xs->xso.real_dev != real_dev);
 
 	xs->xso.real_dev = NULL;
-	if (real_dev && real_dev->xfrmdev_ops &&
-	    real_dev->xfrmdev_ops->xdo_dev_state_free)
-		real_dev->xfrmdev_ops->xdo_dev_state_free(xs);
+	ops = bond_ipsec_ops(real_dev);
+	if (real_dev && ops &&
+	    ops->xdo_dev_state_free)
+		ops->xdo_dev_state_free(xs);
 out:
 	netdev_put(real_dev, &tracker);
 }
@@ -684,6 +706,7 @@ out:
  **/
 static bool bond_ipsec_offload_ok(struct sk_buff *skb, struct xfrm_state *xs)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *real_dev;
 	bool ok = false;
 
@@ -692,12 +715,13 @@ static bool bond_ipsec_offload_ok(struct sk_buff *skb, struct xfrm_state *xs)
 	if (!real_dev)
 		goto out;
 
-	if (!real_dev->xfrmdev_ops ||
-	    !real_dev->xfrmdev_ops->xdo_dev_offload_ok ||
+	ops = bond_ipsec_ops(real_dev);
+	if (!ops ||
+	    !ops->xdo_dev_offload_ok ||
 	    netif_is_bond_master(real_dev))
 		goto out;
 
-	ok = real_dev->xfrmdev_ops->xdo_dev_offload_ok(skb, xs);
+	ok = ops->xdo_dev_offload_ok(skb, xs);
 out:
 	rcu_read_unlock();
 	return ok;
@@ -709,6 +733,7 @@ out:
  **/
 static void bond_advance_esn_state(struct xfrm_state *xs)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *real_dev;
 
 	rcu_read_lock();
@@ -716,13 +741,14 @@ static void bond_advance_esn_state(struct xfrm_state *xs)
 	if (!real_dev)
 		goto out;
 
-	if (!real_dev->xfrmdev_ops ||
-	    !real_dev->xfrmdev_ops->xdo_dev_state_advance_esn) {
+	ops = bond_ipsec_ops(real_dev);
+	if (!ops ||
+	    !ops->xdo_dev_state_advance_esn) {
 		pr_warn_ratelimited("%s: %s doesn't support xdo_dev_state_advance_esn\n", __func__, real_dev->name);
 		goto out;
 	}
 
-	real_dev->xfrmdev_ops->xdo_dev_state_advance_esn(xs);
+	ops->xdo_dev_state_advance_esn(xs);
 out:
 	rcu_read_unlock();
 }
@@ -733,6 +759,7 @@ out:
  **/
 static void bond_xfrm_update_stats(struct xfrm_state *xs)
 {
+	const struct xfrmdev_ops *ops;
 	struct net_device *real_dev;
 
 	rcu_read_lock();
@@ -740,13 +767,14 @@ static void bond_xfrm_update_stats(struct xfrm_state *xs)
 	if (!real_dev)
 		goto out;
 
-	if (!real_dev->xfrmdev_ops ||
-	    !real_dev->xfrmdev_ops->xdo_dev_state_update_stats) {
+	ops = bond_ipsec_ops(real_dev);
+	if (!ops ||
+	    !ops->xdo_dev_state_update_stats) {
 		pr_warn_ratelimited("%s: %s doesn't support xdo_dev_state_update_stats\n", __func__, real_dev->name);
 		goto out;
 	}
 
-	real_dev->xfrmdev_ops->xdo_dev_state_update_stats(xs);
+	ops->xdo_dev_state_update_stats(xs);
 out:
 	rcu_read_unlock();
 }
diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
index c658c03..83cab6e 100644
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -981,6 +981,8 @@ struct netdev_bpf {
 
 #ifdef CONFIG_XFRM_OFFLOAD
 struct xfrmdev_ops {
+	/* Optional provider separate from the netdevice driver. */
+	struct module *owner;
 	int	(*xdo_dev_state_add) (struct xfrm_state *x, struct netlink_ext_ack *extack);
 	void	(*xdo_dev_state_delete) (struct xfrm_state *x);
 	void	(*xdo_dev_state_free) (struct xfrm_state *x);
diff --git a/include/net/flow.h b/include/net/flow.h
index 335bbc5..5e373db 100644
--- a/include/net/flow.h
+++ b/include/net/flow.h
@@ -38,6 +38,8 @@ struct flowi_common {
 	__u8	flowic_flags;
 #define FLOWI_FLAG_ANYSRC		0x01
 #define FLOWI_FLAG_KNOWN_NH		0x02
+/* Require FIB success even with an explicitly selected output interface. */
+#define FLOWI_FLAG_NO_OIF_FALLBACK	0x04
 	__u32	flowic_secid;
 	kuid_t  flowic_uid;
 	__u32		flowic_multipath_hash;
diff --git a/include/net/flow_offload.h b/include/net/flow_offload.h
index 292cd8f..7bfe51f 100644
--- a/include/net/flow_offload.h
+++ b/include/net/flow_offload.h
@@ -688,7 +688,41 @@ struct flow_cls_common_offload {
 	struct netlink_ext_ack *extack;
 };
 
+struct nf_flow_offload_handle;
+struct nf_flow_session;
+
+/* Context is borrowed for the callback and NULL for other producers. Drivers
+ * must not retain nf_ct, either dst or either session. nf_dst is this
+ * direction's selected NEIGH destination; nf_dst_reverse is the other
+ * direction's destination;
+ * other transmit types provide NULL. nf_handle may be retained only through
+ * nf_flow_offload_handle_get/put; it carries no flow/table/conntrack pointer.
+ * nf_xfrm_genid is the policy generation captured before route selection.
+ * Drivers must validate it before admission and after publishing their watch.
+ * Each destination carries the cookie it was selected with: an IPv6 route is
+ * only valid for one FIB generation, so dst_check() needs that value and a
+ * zero cookie rejects every IPv6 destination. IPv4 ignores it.
+ * Version 7 also keeps a bridged path on NEIGH output for such a table, so a
+ * flow whose egress port the bridge FDB resolved arrives with a destination
+ * instead of cached Ethernet addresses.
+ * Version 8 pairs each destination with the PPPoE session its path crosses,
+ * if any: nf_session belongs to nf_dst and nf_session_reverse to
+ * nf_dst_reverse, so a direction's egress and ingress sessions are named the
+ * same way its two destinations are. Both are always non-NULL; a path with no
+ * session reports a zero lower_ifindex. */
+#define FLOW_CLS_HAS_NF_CONTEXT 8
 struct flow_cls_offload {
+	const struct nf_conn *nf_ct;
+	struct dst_entry *nf_dst;
+	struct dst_entry *nf_dst_reverse;
+	const struct nf_flow_session *nf_session;
+	const struct nf_flow_session *nf_session_reverse;
+	struct nf_flow_offload_handle *nf_handle;
+	u64 nf_xfrm_genid;
+	u32 nf_dst_cookie;
+	u32 nf_dst_reverse_cookie;
+	u16 nf_mtu;
+	bool nf_counter;
 	struct flow_cls_common_offload common;
 	enum flow_cls_command command;
 	bool use_act_stats;
diff --git a/include/net/netevent.h b/include/net/netevent.h
index 1be3757..11b7d12 100644
--- a/include/net/netevent.h
+++ b/include/net/netevent.h
@@ -2,6 +2,9 @@
 #ifndef _NET_EVENT_H
 #define _NET_EVENT_H
 
+#include <linux/in6.h>
+#include <linux/types.h>
+
 /*
  *	Generic netevent notifiers
  *
@@ -12,6 +15,7 @@
  * 	Changes:
  */
 
+struct net;
 struct dst_entry;
 struct neighbour;
 struct notifier_block ;
@@ -23,6 +27,29 @@ struct netevent_redirect {
 	const void *daddr;
 };
 
+/* A committed IPv4 FIB alias change, including aliases omitted from the
+ * selected-route FIB notifier. Called under RTNL, with borrowed stack data.
+ * Consumers must not veto the change or retain the event. Match all tables
+ * conservatively unless the complete policy lookup context is available.
+ */
+struct netevent_ipv4_route {
+	struct net *net;
+	__be32 dst;
+	u8 prefixlen;
+};
+
+/* The IPv6 counterpart, with the same borrowed-data and no-veto contract.
+ * Unlike IPv4 this is emitted under the table's tb6_lock and not always under
+ * RTNL: router advertisements install and withdraw routes from softirq. A
+ * consumer must therefore be safe in atomic context, and must not assume RTNL
+ * excludes a change while it validates a route it looked up earlier.
+ */
+struct netevent_ipv6_route {
+	struct net *net;
+	struct in6_addr dst;
+	u8 prefixlen;
+};
+
 enum netevent_notif_type {
 	NETEVENT_NEIGH_UPDATE = 1, /* arg is struct neighbour ptr */
 	NETEVENT_REDIRECT,	   /* arg is struct netevent_redirect ptr */
@@ -30,6 +57,10 @@ enum netevent_notif_type {
 	NETEVENT_IPV4_MPATH_HASH_UPDATE, /* arg is struct net ptr */
 	NETEVENT_IPV6_MPATH_HASH_UPDATE, /* arg is struct net ptr */
 	NETEVENT_IPV4_FWD_UPDATE_PRIORITY_UPDATE, /* arg is struct net ptr */
+	NETEVENT_IPV4_ROUTE_UPDATE, /* arg is struct netevent_ipv4_route ptr */
+	NETEVENT_IPV6_ROUTE_UPDATE, /* arg is struct netevent_ipv6_route ptr */
+	/* Borrowed net pointer; atomic context, notification cannot be vetoed. */
+	NETEVENT_XFRM_POLICY_UPDATE,
 };
 
 int register_netevent_notifier(struct notifier_block *nb);
diff --git a/include/net/netfilter/nf_flow_table.h b/include/net/netfilter/nf_flow_table.h
index 1a6fca0..3794672 100644
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -84,6 +84,12 @@ struct nf_flowtable {
 	struct flow_block		flow_block;
 	struct rw_semaphore		flow_block_lock; /* Guards flow_block */
 	possible_net_t			net;
+	/* A hardware adapter may request neighbour output for routed software
+	 * fallback at bind. Set monotonically; retained until table destruction. */
+	bool				use_neigh;
+	/* Request explicit hardware invalidation handles before first admission.
+	 * Monotonic for this table, including after device unbinding. */
+	bool				use_hw_handles;
 };
 
 static inline bool nf_flowtable_hw_offload(struct nf_flowtable *flowtable)
@@ -107,6 +113,23 @@ enum flow_offload_xmit_type {
 
 #define NF_FLOW_TABLE_ENCAP_MAX		2
 
+/* One PPPoE session on the path a direction transmits over, as
+ * dev_fill_forward_path() resolved it. A hardware adapter cannot re-derive
+ * any of it: a ppp device registers no lower neighbour, so a device walk
+ * cannot descend past one, and the concentrator's address has nowhere else to
+ * live on a neighbour-output flow -- the union member that carries a cached
+ * Ethernet destination is the route itself on that transmit type. The session
+ * id also reaches the rule for an egress path only, as FLOW_ACTION_PPPOE_PUSH;
+ * an ingress one has neither an action nor a dissector key.
+ * lower_ifindex is the device the session runs over and is zero when the path
+ * crosses no session, which is what makes the whole record meaningless.
+ */
+struct nf_flow_session {
+	int				lower_ifindex;
+	u16				id;
+	u8				h_dest[ETH_ALEN];
+};
+
 struct flow_offload_tuple {
 	union {
 		struct in_addr		src_v4;
@@ -138,6 +161,9 @@ struct flow_offload_tuple {
 					encap_num:2,
 					in_vlan_ingress:2;
 	u16				mtu;
+	/* Below __hash, so it never widens a lookup key, and outside the
+	 * union below, which a NEIGH tuple spends on its destination. */
+	struct nf_flow_session		session;
 	union {
 		struct {
 			struct dst_entry *dst_cache;
@@ -180,6 +206,8 @@ enum flow_offload_type {
 struct flow_offload {
 	struct flow_offload_tuple_rhash		tuplehash[FLOW_OFFLOAD_DIR_MAX];
 	struct nf_conn				*ct;
+	struct nf_flow_offload_handle		*hw_handle;
+	u64					xfrm_genid;
 	unsigned long				flags;
 	u16					type;
 	u32					timeout;
@@ -214,6 +242,10 @@ struct nf_flow_route {
 			u8			h_source[ETH_ALEN];
 			u8			h_dest[ETH_ALEN];
 		} out;
+		/* The PPPoE session this direction's egress path crosses, which
+		 * out.h_dest would otherwise be the only record of -- and that
+		 * member is not carried over to a NEIGH tuple. */
+		struct nf_flow_session		session;
 		enum flow_offload_xmit_type	xmit_type;
 	} tuple[FLOW_OFFLOAD_DIR_MAX];
 };
@@ -221,6 +253,19 @@ struct nf_flow_route {
 struct flow_offload *flow_offload_alloc(struct nf_conn *ct);
 void flow_offload_free(struct flow_offload *flow);
 
+/* A callback borrows a handle for one flow generation, shared by both
+ * directions. get/put permit retention without pinning any flow, conntrack,
+ * table, route or namespace. Invalidate is atomic-context safe and monotonic:
+ * lookup immediately declines this cached flow and native GC tears it down.
+ * The driver remains responsible for removing its hardware directions.
+ * Detaching the Linux flow also invalidates the handle; it cannot name a
+ * replacement flow even if its tuple or cookie is reused.
+ */
+void nf_flow_offload_handle_get(struct nf_flow_offload_handle *handle);
+void nf_flow_offload_handle_put(struct nf_flow_offload_handle *handle);
+bool nf_flow_offload_handle_valid(const struct nf_flow_offload_handle *handle);
+bool nf_flow_offload_handle_invalidate(struct nf_flow_offload_handle *handle);
+
 static inline int
 nf_flow_table_offload_add_cb(struct nf_flowtable *flow_table,
 			     flow_setup_cb_t *cb, void *cb_priv)
