@@ -171,6 +171,7 @@ static void nft_dev_path_info(const struct net_device_path_stack *stack,
 	info->hw_outdev = info->indev;
 
 	if (nf_flowtable_hw_offload(flowtable) &&
+	    !READ_ONCE(flowtable->use_neigh) &&
 	    nft_is_valid_ether_device(info->indev))
 		info->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
 }
@@ -246,6 +247,11 @@ static int nft_flow_route(const struct nft_pktinfo *pkt,
 		fl.u.ip4.flowi4_tos = ip_hdr(pkt->skb)->tos & INET_DSCP_MASK;
 		fl.u.ip4.flowi4_mark = pkt->skb->mark;
 		fl.u.ip4.flowi4_flags = FLOWI_FLAG_ANYSRC;
+		/* A forced reverse oif normally permits on-link fallback even
+		 * after a failed FIB lookup. An ASK-owned table must respect
+		 * withdrawal and blackhole/prohibit routes in software too. */
+		if (READ_ONCE(ft->data.use_neigh))
+			fl.u.ip4.flowi4_flags |= FLOWI_FLAG_NO_OIF_FALLBACK;
 		break;
 	case NFPROTO_IPV6:
 		fl.u.ip6.daddr = ct->tuplehash[dir].tuple.src.u3.in6;
