@@ -2,6 +2,9 @@
 #ifndef _NET_EVENT_H
 #define _NET_EVENT_H
 
+#include <linux/in6.h>
+#include <linux/types.h>
+
 /*
  *	Generic netevent notifiers
  *
@@ -12,6 +15,7 @@
  * 	Changes:
  */
 
+struct net;
