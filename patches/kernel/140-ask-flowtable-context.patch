+		.nf_dst = nf_flow_offload_dst(&flow->tuplehash[dir].tuple),
+		.nf_dst_reverse = nf_flow_offload_dst(&flow->tuplehash[!dir].tuple),
+		.nf_handle = flow->hw_handle,
+		.nf_dst_cookie = nf_flow_offload_dst_cookie(&flow->tuplehash[dir].tuple),
+		.nf_dst_reverse_cookie = nf_flow_offload_dst_cookie(&flow->tuplehash[!dir].tuple),
+		.nf_mtu = flow->tuplehash[dir].tuple.mtu,
+		.nf_counter = !!(READ_ONCE(flowtable->flags) & NF_FLOWTABLE_COUNTER),
+	};
