+/* Context is borrowed for the callback and NULL for other producers. Drivers
+ * must not retain nf_ct or either dst. nf_dst is this direction's selected
+ * NEIGH destination; nf_dst_reverse is the other direction's destination;
+ * other transmit types provide NULL. nf_handle may be retained only through
+ * nf_flow_offload_handle_get/put; it carries no flow/table/conntrack pointer.
+ * Each destination carries the cookie it was selected with: an IPv6 route is
+ * only valid for one FIB generation, so dst_check() needs that value and a
+ * zero cookie rejects every IPv6 destination. IPv4 ignores it. */
+#define FLOW_CLS_HAS_NF_CONTEXT 6
