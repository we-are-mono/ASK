diff --git a/include/net/xfrm.h b/include/net/xfrm.h
index ff47f65..714ae9b 100644
--- a/include/net/xfrm.h
+++ b/include/net/xfrm.h
@@ -12,6 +12,7 @@
 #include <linux/ipsec.h>
 #include <linux/in6.h>
 #include <linux/mutex.h>
+#include <linux/module.h>
 #include <linux/audit.h>
 #include <linux/slab.h>
 #include <linux/refcount.h>
@@ -145,6 +146,8 @@ enum {
 };
 
 struct xfrm_dev_offload {
+	/* Pinned callback provider, retained until the object releases offload. */
+	const struct xfrmdev_ops *ops;
 	struct net_device	*dev;
 	netdevice_tracker	dev_tracker;
 	struct net_device	*real_dev;
@@ -152,6 +155,8 @@ struct xfrm_dev_offload {
 	u8			dir : 2;
 	u8			type : 2;
 	u8			flags : 2;
+	/* Flow-selected packet offload still requires native policy checks. */
+	u8			software_policy : 1;
 };
 
 struct xfrm_mode {
@@ -1218,6 +1223,28 @@ static inline struct xfrm_offload *xfrm_offload(struct sk_buff *skb)
 #ifdef CONFIG_XFRM
 int __xfrm_policy_check(struct sock *, int dir, struct sk_buff *skb,
 			unsigned short family);
+bool xfrm_flowtable_policy_check(struct net *net, const struct flowi *fl,
+				u16 family, struct xfrm_state *received);
