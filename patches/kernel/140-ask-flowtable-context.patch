+	const struct nf_conn *nf_ct;
+	struct dst_entry *nf_dst;
+	struct dst_entry *nf_dst_reverse;
+	struct nf_flow_offload_handle *nf_handle;
+	u32 nf_dst_cookie;
+	u32 nf_dst_reverse_cookie;
+	u16 nf_mtu;
+	bool nf_counter;
