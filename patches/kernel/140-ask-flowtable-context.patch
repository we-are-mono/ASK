+	struct netevent_ipv4_route event = {
+		.net = net,
+		.dst = htonl(key),
+		.prefixlen = prefixlen,
+	};
+
+	ASSERT_RTNL();
+	call_netevent_notifiers(NETEVENT_IPV4_ROUTE_UPDATE, &event);
+}
