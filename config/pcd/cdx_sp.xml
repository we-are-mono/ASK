<netpdl name="NetPDL custom protocol" description="NetPDL custom protocol">
<protocol name="pppoeschema" longname="pppoe handler" prevproto="pppoe">
     <execute-code>
      <before>
       <!-- This offset belongs to the shared CC tree, including Wi-Fi's.
            The IPsec offline port (9) has its own tree, where that offset
            names a different table: leave its frames to its distributions. -->
       <if expr="$logicalportid != 9">
        <if-true>
        <if expr="($FW[48:16]) == 0xc021">
          <if-false>
            <!-- PPPoE session packet, police the packet first -->
	    <assign-variable name="$nia" value="0x4C0000"/>
            <!--NOTE: this ccbase +0x30 is corresponding pppoe relay table -->
            <!-- this pppoe relay table is allocated dynamically by FMC while pushing tables from cdx_pcd.xml -->
            <!-- If any new table gets added ccbase value of ppoe relay table should be checked and updated accordingly -->
            <assign-variable name="$ccbase" value="$ccbase + 0x30"/>
            <!--indicate we came into cc from pppoe schema-->
            <assign-variable name="$shimr" value="0x40"/>
            <action type="exit" confirm="yes" nextproto="end_parse"/>
          </if-false>
          <if-true>
            <!-- PPPoE control packet, enqueue directly -->
            <assign-variable name="$hpnia" value="0x500002"/>
            <action type="exit" confirm="yes" nextproto="end_parse"/>
          </if-true>
        </if>
        </if-true>
       </if>
     </before>
     </execute-code>
</protocol>
<protocol name="ethernetschema" longname="offline port Ethernet correction" prevproto="ethernet">
    <execute-code>
      <before>
        <if expr="($logicalportid ge 9) and (ethernet.type == 0x0800 or ethernet.type == 0x86dd)">
	  <if-true>
            <if expr="($FW[112:8] bitwand 0xF0) == 0x40">
              <if-true>
                    <nextproto proto="#ip4"/>
                    <action type="exit" confirm="no" nextproto="ipv4"/>
              </if-true>
            </if> 
            <if expr="($FW[112:8] bitwand 0xF0) == 0x60">
              <if-true>
                    <nextproto proto="#ip6"/>
                    <action type="exit" confirm="no" nextproto="ipv6"/>
              </if-true>
            </if> 
          </if-true>
        </if>
        <action type="exit" nextproto="return"/>
      </before>
   </execute-code>
</protocol>
<protocol name="vlanschema" longname="SEC identity VLAN family correction" prevproto="vlan">
    <execute-code>
      <before>
        <if expr="($logicalportid == 9) and (vlan.type == 0x0800 or vlan.type == 0x86dd)">
	  <if-true>
            <if expr="($FW[32:8] bitwand 0xF0) == 0x40">
              <if-true>
                    <nextproto proto="#ip4"/>
                    <action type="exit" confirm="no" nextproto="ipv4"/>
              </if-true>
            </if>
            <if expr="($FW[32:8] bitwand 0xF0) == 0x60">
              <if-true>
                    <nextproto proto="#ip6"/>
                    <action type="exit" confirm="no" nextproto="ipv6"/>
              </if-true>
            </if>
          </if-true>
        </if>
        <action type="exit" nextproto="return"/>
      </before>
   </execute-code>
</protocol>
<protocol name="ipv4schema" longname="ipv4schema" prevproto="ipv4">
    <execute-code>
      <before>
	<!-- A TTL of 0 or 1 is Linux's to answer. Exiting unconfirmed leaves
	     IPv4 out of the frame's line-up, so the key generator classifies it
	     by its link-layer headers alone: on a receive port the Ethernet or
	     PPPoE lookup, which holds no routed flow. Its miss goes through the
	     punt meter like any other exception; a bridged pair's entry carries
	     it, as the bridge would. Assigning $nia too would enqueue it from
	     here, past every lookup and the meter (A370). On the IPsec offline
	     port (9) ESP is SEC's output for an outbound SA, which its entry
	     sends out with the TTL as it is: in transport mode the packet's own,
	     which may rightly be 1. Decrypted packets there keep the check. -->
        <if expr="(ipv4.ttl == 1 or ipv4.ttl == 0) and ($logicalportid != 9 or ipv4.nextp != 0x32)">
          <if-true>
            <assign-variable name="$hpnia" value="0x500002"/>
            <action type="exit" confirm="no" nextproto="end_parse"/>
          </if-true>
        </if>
	<!-- SEC decrypts an inbound SA's frames against the 20-byte header its
	     PDB states, a UDP header behind it for ESP-in-UDP, and would read
	     IPv4 options as ESP: such a frame goes to the CPU, which tells SEC
	     the header's length per frame. The port's UDP table hands ESP-in-UDP
	     to SEC by ports this cannot see, so all UDP with options goes, as
	     Linux's own flowtable leaves it to the stack too (ip_has_options()).
	     Metered as the TTL check is. On the IPsec offline port ESP is SEC's
	     own output. -->
        <if expr="$logicalportid != 9 and (ipv4.nextp == 0x32 or ipv4.nextp == 0x11) and ipv4.hlen != 5">
          <if-true>
            <assign-variable name="$hpnia" value="0x500002"/>
            <action type="exit" confirm="no" nextproto="end_parse"/>
          </if-true>
        </if>
	<!-- If it is a multicast packet stop parsing -->
        <if expr="$l2r bitwand 0x0060 == 0x0040">
          <if-true>
            <action type="exit" confirm="yes" nextproto="end_parse"/>
          </if-true>
        </if>
	<!-- If next protocol is ipv6 change protocol -->
        <if expr="ipv4.nextp == 0x29">
          <if-true>
            <action type="exit" confirm="no" nextproto="ipv6"/>
          </if-true>
        </if>
      </before>
    </execute-code>
  </protocol> 
 <protocol name="ipv6schema" longname="ipv6schema" prevproto="ipv6">
    <execute-code>
      <before>
	<!-- As for IPv4. ESP behind extension headers is not seen here, so the
	     driver gives SEC no such frame with a hop limit of 1 or 0. -->
	<if expr="(ipv6.hop == 1 or ipv6.hop == 0) and ($logicalportid != 9 or ipv6.nexthdr != 0x32)">
          <if-true>
            <assign-variable name="$hpnia" value="0x500002"/>
            <action type="exit" confirm="no" nextproto="end_parse"/>
          </if-true>
        </if>
        <if expr="$l2r bitwand 0x0060 == 0x0040">
	  <if-true>
            <action type="exit" confirm="yes" nextproto="end_parse"/>
          </if-true>
        </if>
      </before>
    </execute-code>
  </protocol> 
  <protocol name="udpschema" longname="udpschema"  prevproto="udp">
    <execute-code>
      <before>
        <if expr="$ipoffset_1 == $ipoffset_n">
          <if-true>
                <if expr="$l3r bitwand 0x8000 == 0x8000">
                  <if-true>
                    <assign-variable name="$l3r" value="$l3r bitwor 0x800"/>
                  </if-true>
                  <if-false>
                    <assign-variable name="$l3r" value="$l3r bitwor 0x400"/>
                  </if-false>
                </if>
          </if-true>
        </if>
	<if expr="(udp.sport == 0x1194 or udp.dport == 0x1194)">
   	  <if-true>
	    <!-- esp-in-udp packet, if source or dest port is 4500 -->
	    <!-- ESP Marker after UDP header is (spi is 0) 0 for all ISAKMP NATT packet -->	
	    <!-- Send all ISAKMP NATT packets to HOST, through the punt meter
	         as the TTL check does: exiting unconfirmed leaves UDP out of the
	         line-up, so the UDP table, where the port's ESP-in-UDP entries
	         are, is not searched. -->
            <if expr="($FW[64:32] bitwand 0xFFFFFFFF) == 0x00000000">
               <if-true>
            		<assign-variable name="$hpnia" value="0x500002"/>
            		<action type="exit" confirm="no" nextproto="end_parse"/>
               </if-true>
            </if> 
         </if-true>
       </if>
	<if expr="($logicalportid lt 9)">
	  <if-true>
	    <if expr="$l2r bitwand 0x0800 == 0x0800">
              <if-false>
                <!-- not PPPoE session packet, police the packet -->
                <assign-variable name="$nia" value="0x4C0000"/>
                <action type="exit" confirm="yes" nextproto="end_parse"/>
              </if-false>
              <if-true>
              </if-true>
            </if>
          </if-true>
        </if>
       </before>
    </execute-code>
  </protocol>
  <protocol name="tcpschema" longname="tcpschema"  prevproto="tcp">
    <execute-code>
      <before>
	 <if expr="((tcp.flags bitwand 7) != 0)">
          <if-true>
            <assign-variable name="$hpnia" value="0x500002"/>
            <action type="exit" confirm="yes" nextproto="end_parse"/>
          </if-true>
        </if>
        <if expr="$ipoffset_1 == $ipoffset_n">
          <if-true>
                <if expr="$l3r bitwand 0x8000 == 0x8000">
                  <if-true>
                    <assign-variable name="$l3r" value="$l3r bitwor 0x800"/>
                  </if-true>
                  <if-false>
                    <assign-variable name="$l3r" value="$l3r bitwor 0x400"/>
                  </if-false>
                </if>
          </if-true>
        </if>
	<if expr="$logicalportid lt 9">
	  <if-true>
	    <if expr="$l2r bitwand 0x0800 == 0x0800">
              <if-false>
                <!-- not PPPoE session packet, police the packet -->
                <assign-variable name="$nia" value="0x4C0000"/>
                <action type="exit" confirm="yes" nextproto="end_parse"/>
              </if-false>
              <if-true>
              </if-true>
            </if>
	  </if-true>
 	</if>	
      </before>
    </execute-code>
  </protocol>
  <protocol name="espschema" longname="espschema"  prevproto="ipsec_esp">
    <execute-code>
      <before>
	<if expr="$logicalportid lt 9">
	  <if-true>
	    <if expr="$l2r bitwand 0x0800 == 0x0800">
              <if-false>
                <!-- not PPPoE session packet, police the packet -->
                <assign-variable name="$nia" value="0x4C0000"/>
                <action type="exit" confirm="yes" nextproto="end_parse"/>
              </if-false>
              <if-true>
              </if-true>
            </if>
	  </if-true>
 	</if>	
      </before>
    </execute-code>
  </protocol>
</netpdl>
